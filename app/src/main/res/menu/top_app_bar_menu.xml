<?xml version="1.0" encoding="utf-8"?>
<!-- The top app bar's overflow menu: the account actions. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The signed-in account's details. The id matches the profileFragment destination in nav_graph.xml. -->
    <item
        android:id="@+id/profileFragment"
        android:icon="@drawable/ic_profile"
        android:title="@string/menu_profile"
        app:showAsAction="never" />

    <!-- Signing out. Not a navigation destination. -->
    <item
        android:id="@+id/action_sign_out"
        android:icon="@drawable/ic_logout"
        android:title="@string/menu_sign_out"
        app:showAsAction="never" />

</menu>
