<?xml version="1.0" encoding="utf-8"?>
<!-- One saved delegation contact, on the profile screen: a circular initial, their name and what they help. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contactRow"
    style="@style/PetCare.Profile.Row.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- The contact's first initial. A letter in a circle is how a person is drawn everywhere. -->
    <TextView
        android:id="@+id/contactInitial"
        style="@style/PetCare.Profile.Avatar"
        android:importantForAccessibility="no"
        tools:text="S" />

    <!-- The name and the note. layout_weight="1" on a zero width is LinearLayout's "take everything left. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/profile_row_gap"
        android:layout_marginEnd="@dimen/profile_row_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contactName"
            style="@style/PetCare.Profile.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Sysy" />

        <!-- What they help with, in the user's own words, or a prompt saying what tapping does. -->
        <TextView
            android:id="@+id/contactNote"
            style="@style/PetCare.Profile.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Feeds the cats at weekends" />

    </LinearLayout>

    <!-- "HELPER". A label rather than a permission: this app has one account and grants nobody anything. -->
    <TextView
        android:id="@+id/contactRolePill"
        style="@style/PetCare.Profile.StatusPill.Neutral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_contact_role" />

    <!-- Removing this contact. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/contactRemoveButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        app:icon="@drawable/ic_delete"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnSurfaceVariant"
        tools:ignore="ContentDescription" />

</LinearLayout>
