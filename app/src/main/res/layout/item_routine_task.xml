<?xml version="1.0" encoding="utf-8"?>
<!-- One care task inside the routine detail screen's list. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_spacing">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/taskTitleText"
            style="@style/PetCare.ListTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/taskTimeText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Morning meal" />

        <!-- The time sits on the same baseline as the title, at the opposite edge. -->
        <TextView
            android:id="@+id/taskTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_mono"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorAccentText"
            app:layout_constraintBaseline_toBaselineOf="@id/taskTitleText"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="07:30" />

        <!-- The category's icon, tinted to the same muted role as the label it sits beside. -->
        <ImageView
            android:id="@+id/taskCategoryIcon"
            android:layout_width="@dimen/category_icon_size"
            android:layout_height="@dimen/category_icon_size"
            android:layout_marginTop="@dimen/spacing_xs"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/taskTitleText"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:src="@drawable/ic_category_feeding" />

        <TextView
            android:id="@+id/taskCategoryText"
            style="@style/PetCare.ListSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            app:layout_constraintBottom_toBottomOf="@id/taskCategoryIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/taskCategoryIcon"
            app:layout_constraintTop_toTopOf="@id/taskCategoryIcon"
            tools:text="Feeding" />

        <TextView
            android:id="@+id/taskSuppliesText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/taskCategoryIcon"
            tools:text="Needs: dry food, measuring cup"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
