<?xml version="1.0" encoding="utf-8"?>
<!-- One recovery code in the grid on the recovery-codes screen: its number, then the code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingTop="@dimen/recovery_code_row_padding"
    android:paddingBottom="@dimen/recovery_code_row_padding">

    <!-- "1." — quiet, because it is a label on the code rather than part of it. -->
    <TextView
        android:id="@+id/codeIndex"
        style="@style/PetCare.Auth.Helper"
        android:layout_width="@dimen/recovery_code_index_width"
        android:layout_height="wrap_content"
        tools:text="1." />

    <!-- The code itself. -->
    <TextView
        android:id="@+id/codeValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/ibm_plex_mono"
        android:letterSpacing="0.08"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true"
        android:textSize="@dimen/recovery_code_text_size"
        tools:text="482913" />

</LinearLayout>
