<?xml version="1.0" encoding="utf-8"?>
<!-- "SELECTED LOCATION": what the map's centre pin is currently pointing at, in words and figures. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            style="@style/PetCare.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/selected_location_label" />

        <!-- The pin and the three lines beside it. baselineAligned false. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Decorative: everything it stands for is in the text beside. -->
            <ImageView
                android:id="@+id/selectedPinIcon"
                android:layout_width="@dimen/selected_location_pin_size"
                android:layout_height="@dimen/selected_location_pin_size"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map_pin"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- "Pulchowk, Lalitpur" — or, before the lookup answers, what is being waited. -->
                <TextView
                    android:id="@+id/selectedNameText"
                    style="@style/PetCare.SelectedLocation.Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Pulchowk, Lalitpur" />

                <!-- "Lalitpur Metropolitan City, Bagmati, Nepal". Gone rather than blank. -->
                <TextView
                    android:id="@+id/selectedAddressText"
                    style="@style/PetCare.SelectedLocation.Address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    tools:text="Lalitpur Metropolitan City, Bagmati"
                    tools:visibility="visible" />

                <!-- Monospace, so the digits line up under each other as the map moves and the figures change. -->
                <TextView
                    android:id="@+id/selectedCoordinatesText"
                    style="@style/PetCare.SelectedLocation.Coordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    tools:text="27.6771° N, 85.3132° E" />

                <!-- Shown only when the point came from the device and the user granted "Approximate". -->
                <TextView
                    android:id="@+id/selectedNoteText"
                    style="@style/PetCare.SelectedLocation.Address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/place_location_approximate"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
