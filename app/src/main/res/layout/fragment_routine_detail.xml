<?xml version="1.0" encoding="utf-8"?>
<!--
    Routine detail screen: the tasks that make up one routine, in the order they happen.

    The routine's name is set on the app bar by the fragment, so only its schedule appears here.

    Unlike the pet detail screen, the task list is the whole point of the page, so it gets a proper
    scrolling RecyclerView constrained to the remaining height rather than being nested in a scroll
    view. That keeps rows recycling however many tasks a routine grows to.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.routine.RoutineDetailFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/routineScheduleText"
            style="@style/PetCare.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Every day" />

        <!--
            Pause switch. A switch rather than a button because it shows a state as well as
            changing it — the user can see at a glance whether this routine is currently running,
            which a button labelled "Pause" could not convey.

            Switching it off is the reversible alternative to deleting: the routine and its tasks
            stay intact but stop appearing on checklists.
        -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/activeSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="@string/routine_active_label"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/routineScheduleText" />

        <!-- Coloured with the theme's error role, the Material 3 signal for a destructive action,
             so it reads differently from every other control on the screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteRoutineButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/card_spacing"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="@string/routine_delete"
            android:textColor="?attr/colorError"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/activeSwitch"
            app:strokeColor="?attr/colorError" />

        <TextView
            android:id="@+id/tasksHeaderText"
            style="@style/PetCare.SectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="@string/routine_detail_tasks_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/deleteRoutineButton" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tasksRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/card_spacing"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/list_padding_bottom_fab"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tasksHeaderText"
            tools:listitem="@layout/item_routine_task" />

        <!-- Occupies the same region as the list; the fragment shows exactly one of the two. -->
        <LinearLayout
            android:id="@+id/emptyTasksContainer"
            style="@style/PetCare.EmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tasksRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tasksRecyclerView"
            tools:visibility="visible">

            <ImageView
                style="@style/PetCare.EmptyStateIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_empty_tasks" />

            <TextView
                style="@style/PetCare.EmptyStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/routine_detail_no_tasks_title" />

            <TextView
                style="@style/PetCare.EmptyStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/routine_detail_no_tasks_message" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Adds a task to this routine.

         The bottom margin is fab_margin_bottom rather than the screen gutter: the button and the
         floating bottom navigation bar are drawn over the same corner of the screen, and at the
         usual 16dp the bar covered the button entirely. Only the bottom side is raised — the end
         margin stays the standard gutter, so the button still lines up with the content beside
         it. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addTaskFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/fab_margin_bottom"
        android:contentDescription="@string/cd_add_task"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
