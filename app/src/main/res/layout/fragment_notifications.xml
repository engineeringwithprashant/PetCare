<?xml version="1.0" encoding="utf-8"?>
<!-- The notifications screen: everything the app has noticed about the user's pets, newest first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.notifications.NotificationsFragment">

    <!-- The shared header, as a nested binding (`binding.header`). -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- The headline and the "MARK READ" pill. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_sm">

        <!-- "3 new alerts". Worded by the fragment. -->
        <TextView
            android:id="@+id/alertsHeadlineText"
            style="@style/PetCare.Notifications.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            tools:text="3 new alerts" />

        <!-- Marks every alert on screen read. Hidden when nothing is unread. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/markReadButton"
            style="@style/PetCare.Notifications.MarkReadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/cd_mark_all_read"
            android:text="@string/notifications_mark_read" />

    </LinearLayout>

    <!-- The list and the empty state share this slot; the fragment shows exactly one. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- clipToPadding="false" with bottom padding lets the last card scroll clear of the bottom navigation bar. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/alertsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/list_padding_bottom"
            tools:listitem="@layout/item_alert" />

        <!-- Nothing to report: a bell with a tick, a heading and a sentence saying what would appear here. -->
        <LinearLayout
            android:id="@+id/emptyAlertsContainer"
            style="@style/PetCare.EmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                style="@style/PetCare.EmptyStateIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_empty_notifications" />

            <TextView
                style="@style/PetCare.EmptyStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_empty_title" />

            <TextView
                style="@style/PetCare.EmptyStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_empty_message" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
