<?xml version="1.0" encoding="utf-8"?>
<!-- One pet's card on the Pets tab. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pets_card_spacing"
    app:cardCornerRadius="@dimen/pet_card_corner_radius"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============================ The photo ============================ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The photograph. -->
            <ImageView
                android:id="@+id/petPhotoImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_pet_photo_dark"
                android:contentDescription="@string/cd_pet_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pet_placeholder"
                app:layout_constraintDimensionRatio="@string/pet_photo_aspect_ratio"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- The species chip, pinned to the photo's top-left corner. -->
            <TextView
                android:id="@+id/speciesChip"
                style="@style/PetCare.SpeciesChip.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/card_padding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Cat" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========================== The light panel ========================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <!-- The pet's name: the card's heading. Two lines at most, so a long name wraps rather than being cut. -->
            <TextView
                android:id="@+id/petNameText"
                style="@style/PetCare.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                tools:text="Krishala Pant Thapa Baby" />

            <!-- "Cared for by …" — smaller and muted, because it supports the name rather than competing with it. -->
            <TextView
                android:id="@+id/caredForByText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Cared for by Prashant" />

            <!-- The three facts, in an outlined box (bg_pets_stat_row.xml). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:background="@drawable/bg_pets_stat_row"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Age -->
                <LinearLayout
                    style="@style/PetCare.PetStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/ageValueText"
                        style="@style/PetCare.PetStat.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="0 mo" />

                    <TextView
                        style="@style/PetCare.PetStat.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pets_stat_age" />

                </LinearLayout>

                <View style="@style/PetCare.PetStat.Divider" />

                <!-- Weight -->
                <LinearLayout
                    style="@style/PetCare.PetStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/weightValueText"
                        style="@style/PetCare.PetStat.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="25 kg" />

                    <TextView
                        style="@style/PetCare.PetStat.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pets_stat_weight" />

                </LinearLayout>

                <View style="@style/PetCare.PetStat.Divider" />

                <!-- Tasks due today -->
                <LinearLayout
                    style="@style/PetCare.PetStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/dueTodayValueText"
                        style="@style/PetCare.PetStat.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="3" />

                    <TextView
                        style="@style/PetCare.PetStat.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pets_stat_due_today" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
