<?xml version="1.0" encoding="utf-8"?>
<!--
    Password reset, step 3 of 3 (ResetNewPasswordFragment): choose the new password.

    Not in the mockups, so it is assembled from the parts the other screens already use — the shared
    header, the step bar ("STEP 3 OF 3"), the register form's password and confirm fields, the filled
    button and the "BACK TO LOG IN" link — so it reads as the natural last page of the same flow.

    This screen *does* use real text fields, so the system keyboard is expected here (unlike the two
    code screens). The ScrollView plus MainActivity's keyboard padding keeps the fields and the button
    reachable while it is open.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Auth.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.reset.ResetNewPasswordFragment">

    <LinearLayout
        style="@style/PetCare.Auth.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/header"
            layout="@layout/view_auth_header" />

        <include
            android:id="@+id/stepProgress"
            layout="@layout/view_auth_step_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_header_gap" />

        <TextView
            style="@style/PetCare.Auth.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:labelFor="@id/newPasswordInput"
            android:text="@string/reset_password_label" />

        <!-- The "At least 8 characters" placeholder is filled in by the fragment from
             AuthValidation.MIN_PASSWORD_LENGTH, as on the register form. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/newPasswordLayout"
            style="@style/PetCare.Auth.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newPasswordInput"
                style="@style/PetCare.Auth.FieldInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                tools:hint="At least 8 characters" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/PetCare.Auth.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/confirmPasswordInput"
            android:text="@string/reset_password_confirm_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordLayout"
            style="@style/PetCare.Auth.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPasswordInput"
                style="@style/PetCare.Auth.FieldInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/register_confirm_password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/PetCare.Auth.PrimaryButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/reset_password_submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToLoginButton"
            style="@style/PetCare.Auth.BackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/auth_back_to_login" />

    </LinearLayout>
</ScrollView>
