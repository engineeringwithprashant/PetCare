<?xml version="1.0" encoding="utf-8"?>
<!-- The wrong-password warning on the log in screen: an exclamation badge, a bold title. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorAuthAlertWarning"
    app:cardCornerRadius="@dimen/auth_alert_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorAuthAlertWarningEdge"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/auth_alert_padding">

        <!-- The exclamation. Its fill and the mark's own colour are set per card style by the fragment. -->
        <TextView
            android:id="@+id/loginAlertBadge"
            style="@style/PetCare.Auth.AlertBadge"
            android:text="!"
            tools:backgroundTint="@color/auth_alert_warning_badge"
            tools:ignore="HardcodedText"
            tools:textColor="@color/on_auth_alert_warning_badge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- "Wrong password", or "Last try before a 15-minute lock" on the red card. -->
            <TextView
                android:id="@+id/loginAlertTitle"
                style="@style/PetCare.Auth.AlertTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="@string/login_alert_wrong_password" />

            <!-- "4 of 5 attempts left · locks for 15 minutes after the 5th". -->
            <TextView
                android:id="@+id/loginAlertDetail"
                style="@style/PetCare.Auth.AlertDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="4 of 5 attempts left · locks for 15 minutes after the 5th" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
