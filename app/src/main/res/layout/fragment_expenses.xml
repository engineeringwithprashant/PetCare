<?xml version="1.0" encoding="utf-8"?>
<!-- The Money tab: this month's spending, what it went on, and every expense recorded. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.expense.ExpensesFragment">

    <!-- Header, chips, then the list taking the rest of the height (height 0 + weight 1). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The shared header, as a nested binding (`binding.header`). Hidden for a single pet. -->
        <include
            android:id="@+id/header"
            layout="@layout/view_tab_header" />

        <!-- The pet filter: the same horizontally scrolling single-selection chip row as the Tasks tab. -->
        <HorizontalScrollView
            android:id="@+id/petChipScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/petChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <!-- The list and the empty state share this slot; the fragment shows exactly one. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- clipToPadding="false" with bottom padding is the standard pairing for a list under a floating action button. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expensesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/list_padding_bottom_fab"
                tools:listitem="@layout/item_expense" />

            <!-- The existing empty state: receipt icon, title and message — or, for an account with no pets. -->
            <LinearLayout
                android:id="@+id/emptyExpensesContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/emptyExpensesIcon"
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_expenses" />

                <TextView
                    android:id="@+id/emptyExpensesTitle"
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expenses_empty_title" />

                <TextView
                    android:id="@+id/emptyExpensesMessage"
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expenses_empty_message" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Logs a new expense. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addExpenseFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/fab_margin_bottom"
        android:contentDescription="@string/cd_add_expense"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
