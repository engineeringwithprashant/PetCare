<?xml version="1.0" encoding="utf-8"?>
<!-- The header every sign-in screen opens with: the logo, "PetCare", "DAILY PET TRACKING". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:background="?android:attr/colorBackground">

    <!-- The PetCare logo (res/drawable-nodpi/logo_petcare.png). -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/brandMark"
        android:layout_width="@dimen/auth_brand_mark_size"
        android:layout_height="@dimen/auth_brand_mark_size"
        android:contentDescription="@string/auth_brand_mark_description"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_petcare"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.AuthBrandMark" />

    <!-- The wordmark. Hidden from TalkBack because the logo above already announces "PetCare". -->
    <TextView
        android:id="@+id/brandName"
        style="@style/PetCare.Auth.BrandName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:importantForAccessibility="no"
        android:text="@string/auth_brand_name" />

    <TextView
        android:id="@+id/brandTagline"
        style="@style/PetCare.Auth.Tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/auth_brand_tagline" />

    <!-- The screen's heading. Marked as a heading for accessibility (API 28+). -->
    <TextView
        android:id="@+id/title"
        style="@style/PetCare.Auth.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:accessibilityHeading="true"
        tools:targetApi="p"
        tools:text="@string/login_title" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/PetCare.Auth.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        tools:text="@string/login_subtitle" />

</LinearLayout>
