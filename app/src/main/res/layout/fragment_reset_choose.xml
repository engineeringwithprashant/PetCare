<?xml version="1.0" encoding="utf-8"?>
<!--
    Password reset, step 1 of 3 (ResetChooseFragment): choose where the reset code is sent, then type
    the account's email address or phone number. Matches design/auth-reset-email-mockup.png and
    design/auth-reset-sms-mockup.png.

    **The option cards.** Email and SMS behave as a radio group: exactly one is chosen, and the chosen
    one has a pale-yellow fill, a yellow outline, a yellow badge and a filled radio. All of that is
    drawn from each card's single `checked` state (see PetCare.Auth.OptionCard in styles.xml), so the
    fragment only decides *which* card is checked. Each card is a MaterialCardView holding one
    horizontal row: badge, two lines of text taking the remaining width, then the radio.
    **duplicateParentState** on the row, the badge and the radio carries the card's checked state
    down to them; without it the children would never see it.

    **The account field.** Two complete label + field + helper blocks, one for email and one for the
    phone number, of which the fragment shows only the one matching the chosen card. Two fields rather
    than one field that changes its label: each keeps the right keyboard (email vs. dial pad) and
    autofill hint, each keeps its own text when the user switches cards and back, and Android saves
    and restores both across rotation by their ids with no extra code — the same approach as the log
    in / register forms.

    **The button** starts disabled and is enabled by the fragment only while the visible field holds a
    correctly formatted value; its charcoal resting look comes from its colour state list.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Auth.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.reset.ResetChooseFragment">

    <LinearLayout
        style="@style/PetCare.Auth.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/header"
            layout="@layout/view_auth_header" />

        <include
            android:id="@+id/stepProgress"
            layout="@layout/view_auth_step_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_header_gap" />

        <!-- =========================== Email option =========================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emailOption"
            style="@style/PetCare.Auth.OptionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            tools:checked="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/auth_option_card_padding">

                <TextView
                    style="@style/PetCare.Auth.OptionBadge"
                    android:text="@string/reset_option_email_badge" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PetCare.Auth.OptionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_option_email_title" />

                    <TextView
                        style="@style/PetCare.Auth.OptionDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_option_email_description" />
                </LinearLayout>

                <View style="@style/PetCare.Auth.OptionRadio" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================ SMS option ============================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/smsOption"
            style="@style/PetCare.Auth.OptionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/auth_option_card_padding">

                <TextView
                    style="@style/PetCare.Auth.OptionBadge"
                    android:text="@string/reset_option_sms_badge" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PetCare.Auth.OptionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_option_sms_title" />

                    <TextView
                        style="@style/PetCare.Auth.OptionDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_option_sms_description" />
                </LinearLayout>

                <View style="@style/PetCare.Auth.OptionRadio" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ====================== Account email (email chosen) ======================
             A vertical group so the fragment can show or hide label, field and helper together. -->
        <LinearLayout
            android:id="@+id/accountEmailGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical"
            tools:visibility="visible">

            <TextView
                style="@style/PetCare.Auth.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/accountEmailInput"
                android:text="@string/reset_account_email_label" />

            <!-- Starts empty: the user types the address on their account. The format error, when
                 there is one, appears directly under the box, above the helper line. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/accountEmailLayout"
                style="@style/PetCare.Auth.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/accountEmailInput"
                    style="@style/PetCare.Auth.FieldInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="@string/register_email_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/PetCare.Auth.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_label_gap"
                android:text="@string/reset_account_email_helper" />
        </LinearLayout>

        <!-- =================== Account phone number (SMS chosen) ===================
             Starts GONE; the fragment swaps the two groups when the chosen card changes. -->
        <LinearLayout
            android:id="@+id/accountPhoneGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/PetCare.Auth.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/accountPhoneInput"
                android:text="@string/reset_account_phone_label" />

            <!-- inputType="phone" brings up the dial pad, which still offers "+" and spaces. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/accountPhoneLayout"
                style="@style/PetCare.Auth.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/accountPhoneInput"
                    style="@style/PetCare.Auth.FieldInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:hint="@string/register_phone_hint"
                    android:imeOptions="actionDone"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/PetCare.Auth.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_label_gap"
                android:text="@string/reset_account_phone_helper" />
        </LinearLayout>

        <!-- Disabled until the visible field holds a valid value; see ResetChooseViewModel. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendCodeButton"
            style="@style/PetCare.Auth.PrimaryButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:enabled="false"
            android:text="@string/reset_send_code" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToLoginButton"
            style="@style/PetCare.Auth.BackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/auth_back_to_login" />

    </LinearLayout>
</ScrollView>
