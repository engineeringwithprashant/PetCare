<?xml version="1.0" encoding="utf-8"?>
<!-- One task card on the Tasks tab. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/task_card_spacing"
    app:cardElevation="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Large"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <!-- The row whose activated state stands for "done" — see the note above. -->
    <LinearLayout
        android:id="@+id/taskContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_spacing">

        <!-- The time badge: a fixed square so every card's details start at the same x. -->
        <LinearLayout
            android:layout_width="@dimen/task_time_badge_size"
            android:layout_height="@dimen/task_time_badge_size"
            android:background="@drawable/bg_time_badge"
            android:backgroundTint="@color/task_time_badge_background"
            android:gravity="center"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <!-- The time, in IBM Plex Mono: the app's face for times and other read-off figures. -->
            <TextView
                android:id="@+id/taskTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/task_time_badge_text"
                android:textStyle="bold"
                tools:text="8:00" />

            <!-- "AM" / "PM" on its own line. Hidden by the adapter on a 24-hour clock. -->
            <TextView
                android:id="@+id/taskMeridiemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/task_time_badge_text"
                tools:text="AM" />

        </LinearLayout>

        <!-- The details column, taking all the width the badge and button leave. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_spacing"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- The title line: the category's emoji, then the task's name. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Hidden from TalkBack: the subtitle below names the category in words. -->
                <TextView
                    android:id="@+id/taskCategoryEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="@dimen/task_category_emoji_size"
                    tools:text="💊" />

                <TextView
                    android:id="@+id/taskTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/task_title_text"
                    android:textStyle="bold"
                    tools:text="Morning meds" />

            </LinearLayout>

            <TextView
                android:id="@+id/taskSubtitleText"
                style="@style/PetCare.ListSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Ddjw · Medication" />

            <!-- The supplies tag. wrap_content width so it hugs its text like a tag. -->
            <TextView
                android:id="@+id/taskSuppliesText"
                style="@style/PetCare.Pill.Supplies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:text="Flea tablet"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- The quick check-off. A checkable MaterialButton — see PetCare.TaskCheckButton for why. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/taskCheckButton"
            style="@style/PetCare.TaskCheckButton"
            android:layout_width="@dimen/task_check_button_size"
            android:layout_height="@dimen/task_check_button_size"
            android:contentDescription="@string/cd_task_done" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
