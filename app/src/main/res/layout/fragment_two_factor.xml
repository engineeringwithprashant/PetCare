<?xml version="1.0" encoding="utf-8"?>
<!--
    The two-factor check (TwoFactorFragment): the second step of signing in, where the user types the
    six-digit code from Google Authenticator.

    Top to bottom: the shared header, the step bar ("STEP 2 OF 2"), the code boxes with the on-screen
    keypad (CodeKeypadView — a reusable component, kept separate so any later code screen gets
    identical behaviour), a note about the code
    refreshing beside a "LOST ACCESS?" link, the verify button, and a way back.

    There is deliberately no text field anywhere on this screen, so the system keyboard has nothing to
    open for — the keypad is the only input. See view_code_keypad.xml.

    ScrollView so the keypad stays reachable on short screens and in landscape, where the whole column
    is taller than the window.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Auth.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.twofactor.TwoFactorFragment">

    <LinearLayout
        style="@style/PetCare.Auth.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/header"
            layout="@layout/view_auth_header" />

        <include
            android:id="@+id/stepProgress"
            layout="@layout/view_auth_step_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_header_gap" />

        <com.prash.petcare.ui.auth.CodeKeypadView
            android:id="@+id/codeKeypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md" />

        <!-- The note and the link share a row: the note takes the remaining width (weight 1) and wraps
             onto a second line, the link keeps its natural width at the end. center_vertical lines the
             link up with the middle of the two-line note, as in the mockup. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PetCare.Auth.Helper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/two_factor_refresh_note" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lostAccessButton"
                style="@style/PetCare.Auth.TextLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="-8dp"
                android:text="@string/two_factor_lost_access" />
        </LinearLayout>

        <!-- Starts disabled: TwoFactorFragment enables it once all six digits are in. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyButton"
            style="@style/PetCare.Auth.PrimaryButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:enabled="false"
            android:text="@string/two_factor_submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/differentAccountButton"
            style="@style/PetCare.Auth.BackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/two_factor_different_account" />

    </LinearLayout>
</ScrollView>
