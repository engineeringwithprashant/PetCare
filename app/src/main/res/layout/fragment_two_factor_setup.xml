<?xml version="1.0" encoding="utf-8"?>
<!-- Two-factor setup (TwoFactorSetupFragment): scan the QR code into an authenticator app. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/list_padding_bottom"
    tools:context=".ui.auth.twofactor.TwoFactorSetupFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/content_top_padding"
        android:paddingEnd="@dimen/screen_padding">

        <!-- Shown only while the secret is being generated and the account read. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/setupProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp"
            tools:visibility="visible" />

        <!-- The account was deleted while this screen was opening — on another device, and pulled down by a sync. -->
        <TextView
            android:id="@+id/setupFailedText"
            style="@style/PetCare.Auth.ErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/two_factor_setup_unavailable"
            android:visibility="gone"
            tools:visibility="gone" />

        <!-- Everything else. Hidden as a block rather than line by line. -->
        <LinearLayout
            android:id="@+id/setupContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/PetCare.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/two_factor_setup_step_scan" />

            <TextView
                style="@style/PetCare.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/two_factor_setup_scan_body" />

            <!-- The white card. layout_gravity centres it in the column. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@android:color/white"
                app:contentPadding="@dimen/two_factor_qr_padding"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <!-- A fixed square. The fragment reads this view's pixel width and generates the bitmap at exactly that size. -->
                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="@dimen/two_factor_qr_size"
                    android:layout_height="@dimen/two_factor_qr_size"
                    android:contentDescription="@string/cd_two_factor_qr"
                    tools:src="@tools:sample/avatars" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Shown only if the code could not be encoded at all. -->
            <TextView
                android:id="@+id/qrFallbackText"
                style="@style/PetCare.Auth.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_horizontal"
                android:text="@string/two_factor_setup_qr_failed"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- Which account the authenticator entry will be filed under. -->
            <TextView
                android:id="@+id/setupAccountText"
                style="@style/PetCare.Auth.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_horizontal"
                tools:text="For prashant@example.com" />

            <TextView
                style="@style/PetCare.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/two_factor_setup_key_label" />

            <!-- The secret in text, for anyone whose authenticator is on this same phone. -->
            <TextView
                android:id="@+id/secretText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/ibm_plex_mono"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textSize="@dimen/two_factor_secret_text_size"
                tools:text="JBSW Y3DP EHPK 3PXP JBSW Y3DP EHPK 3PXP" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copySecretButton"
                style="@style/PetCare.TaskActionButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/two_factor_setup_copy_key" />

            <View
                style="@style/PetCare.Profile.RowDivider"
                android:layout_marginTop="@dimen/spacing_lg" />

            <TextView
                style="@style/PetCare.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/two_factor_setup_step_confirm" />

            <!-- Says why the second step exists, which is the thing most likely to be misread as busywork. -->
            <TextView
                style="@style/PetCare.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/two_factor_setup_confirm_body" />

            <!-- The same six boxes and keypad the sign-in code screens use. -->
            <com.prash.petcare.ui.auth.CodeKeypadView
                android:id="@+id/codeKeypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <!-- Starts disabled: bindCodeEntry enables it once all six digits are in. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                style="@style/PetCare.TaskActionButton.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:enabled="false"
                android:text="@string/two_factor_setup_confirm" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
