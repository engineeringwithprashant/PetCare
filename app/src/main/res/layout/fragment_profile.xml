<?xml version="1.0" encoding="utf-8"?>
<!-- The profile screen: who is signed in, how the app behaves for them, and the way out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.profile.ProfileFragment">

    <!-- The shared header, as a nested binding (`binding.header`). -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- clipToPadding="false" with bottom padding lets the last row scroll clear of the floating nav bar. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/home_scroll_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/content_top_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- The identity card. -->

            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/profile_card_ground"
                app:cardCornerRadius="@dimen/pet_card_corner_radius">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/profile_card_padding">

                    <!-- The photo well and the "+" on its corner. -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!-- The photo itself. -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profilePhoto"
                            android:layout_width="@dimen/profile_photo_size"
                            android:layout_height="@dimen/profile_photo_size"
                            android:background="@drawable/bg_profile_photo_well"
                            android:contentDescription="@string/cd_profile_photo_empty"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Circle" />

                        <!-- Changes the photo. The one bright mark on the dark card. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePhotoButton"
                            style="@style/PetCare.Profile.AddPhotoButton"
                            android:layout_gravity="bottom|end"
                            android:contentDescription="@string/cd_change_photo"
                            app:icon="@drawable/ic_add" />

                    </FrameLayout>

                    <!-- The name, the two contact lines and the pills. Takes the leftover width. -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/profile_photo_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- accessibilityHeading marks the name as this screen's heading below the header's own title. -->
                        <TextView
                            android:id="@+id/profileNameText"
                            style="@style/PetCare.Profile.Name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            tools:targetApi="p"
                            tools:text="Prashant Pant" />

                        <TextView
                            android:id="@+id/profileEmailText"
                            style="@style/PetCare.Profile.CardMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            tools:text="prashant@petcare.app" />

                        <TextView
                            android:id="@+id/profilePhoneText"
                            style="@style/PetCare.Profile.CardMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="+977 98·· ··12" />

                        <!-- The role and the pet count. A horizontal row rather than two pills in a Flow. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/profileRolePill"
                                style="@style/PetCare.Profile.RolePill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Owner" />

                            <TextView
                                android:id="@+id/profilePetCountPill"
                                style="@style/PetCare.Profile.CountPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/pill_spacing"
                                tools:text="2 pets" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- The stat row. -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/PetCare.Profile.StatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/profile_stat_card_padding">

                        <TextView
                            android:id="@+id/statPetsValue"
                            style="@style/PetCare.Profile.StatValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="2" />

                        <TextView
                            style="@style/PetCare.Profile.StatLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_stat_pets_label" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/PetCare.Profile.StatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/profile_stat_card_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/profile_stat_card_padding">

                        <TextView
                            android:id="@+id/statStreakValue"
                            style="@style/PetCare.Profile.StatValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="5" />

                        <TextView
                            style="@style/PetCare.Profile.StatLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_stat_streak_label" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/PetCare.Profile.StatCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/profile_stat_card_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/profile_stat_card_padding">

                        <TextView
                            android:id="@+id/statTasksValue"
                            style="@style/PetCare.Profile.StatValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="18" />

                        <TextView
                            style="@style/PetCare.Profile.StatLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_stat_tasks_label" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ACCOUNT. -->

            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                app:cardCornerRadius="@dimen/corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <TextView
                        style="@style/PetCare.Profile.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_account" />

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Name & details. The whole row opens the form. -->
                    <LinearLayout
                        android:id="@+id/accountNameRow"
                        style="@style/PetCare.Profile.Row.Clickable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- The row's glyph badge. Decorative: the row already announces its own title. -->
                        <ImageView
                            style="@style/PetCare.Profile.BadgeIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_person" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_row_gap"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_name_title" />

                            <TextView
                                android:id="@+id/accountNameSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Prashant Pant · owner account" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editDetailsButton"
                            style="@style/PetCare.Profile.ActionPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_action_edit" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Email. Not clickable: the address cannot be changed here. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/PetCare.Profile.BadgeIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_mail" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_row_gap"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_email_title" />

                            <TextView
                                android:id="@+id/accountEmailSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="prashant@petcare.app" />

                        </LinearLayout>

                        <TextView
                            style="@style/PetCare.Profile.StatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_status_verified" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Phone. Also not clickable — it is edited on the same form the EDIT pill above opens. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/PetCare.Profile.BadgeIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_phone" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_row_gap"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_phone_title" />

                            <TextView
                                android:id="@+id/accountPhoneSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="+977 98·· ··12 · used for delegation SMS" />

                        </LinearLayout>

                        <!-- Hidden when there is no number to describe as anything. -->
                        <TextView
                            android:id="@+id/phoneVerifiedPill"
                            style="@style/PetCare.Profile.StatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_status_verified" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Change password. The accent pill. -->
                    <LinearLayout
                        android:id="@+id/accountPasswordRow"
                        style="@style/PetCare.Profile.Row.Clickable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/PetCare.Profile.BadgeIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_lock" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_row_gap"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_password_title" />

                            <TextView
                                android:id="@+id/accountPasswordSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Last changed 3 months ago" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePasswordButton"
                            style="@style/PetCare.Profile.ActionPill.Accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_action_update" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECURITY. -->

            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                app:cardCornerRadius="@dimen/corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding">

                    <TextView
                        style="@style/PetCare.Profile.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_security" />

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Two-factor authentication: a six-digit code from an authenticator app. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_two_factor_title" />

                            <TextView
                                android:id="@+id/twoFactorSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="On · authenticator app · 9 recovery codes left" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/twoFactorSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Care reminders. This one does real work. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_reminders_title" />

                            <TextView
                                android:id="@+id/careRemindersSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="On · at each task's time" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/careRemindersSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- The note. Inside the card rather than below it, so it reads as an aside about these rows. -->
                    <TextView
                        style="@style/PetCare.Profile.Note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/profile_security_note" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PREFERENCES. -->

            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                app:cardCornerRadius="@dimen/corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <TextView
                        style="@style/PetCare.Profile.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_preferences" />

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Weight units. Applied on the pet cards and the pet detail screen. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.Profile.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:text="@string/profile_row_weight_title" />

                        <LinearLayout
                            style="@style/PetCare.Profile.SegmentTrack"
                            android:layout_width="wrap_content">

                            <TextView
                                android:id="@+id/weightMetricSegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_weight_metric" />

                            <TextView
                                android:id="@+id/weightImperialSegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_weight_imperial" />

                        </LinearLayout>

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Reminder channel. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_reminder_channel_title" />

                            <TextView
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_reminder_channel_subtitle" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/PetCare.Profile.SegmentTrack"
                            android:layout_width="wrap_content">

                            <TextView
                                android:id="@+id/reminderPushSegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_channel_push" />

                            <TextView
                                android:id="@+id/reminderSmsSegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_channel_sms" />

                        </LinearLayout>

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Week start. Applied on the Tasks tab's week strip and the dashboard's care streak. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.Profile.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:text="@string/profile_row_week_start_title" />

                        <LinearLayout
                            style="@style/PetCare.Profile.SegmentTrack"
                            android:layout_width="wrap_content">

                            <TextView
                                android:id="@+id/weekSundaySegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_week_sunday" />

                            <TextView
                                android:id="@+id/weekMondaySegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_week_monday" />

                        </LinearLayout>

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Currency. The symbol only — see the subtitle, which says so out loud. -->
                    <LinearLayout
                        style="@style/PetCare.Profile.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_currency_title" />

                            <TextView
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_currency_subtitle" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/PetCare.Profile.SegmentTrack"
                            android:layout_width="wrap_content">

                            <TextView
                                android:id="@+id/currencyNprSegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_currency_npr" />

                            <TextView
                                android:id="@+id/currencyUsdSegment"
                                style="@style/PetCare.Profile.Segment"
                                android:layout_width="wrap_content"
                                android:text="@string/profile_currency_usd" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DELEGATION CONTACTS. -->

            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                app:cardCornerRadius="@dimen/corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <!-- The heading and its status pill, on one line. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/profile_row_padding_vertical"
                        android:paddingBottom="@dimen/profile_row_padding_vertical">

                        <TextView
                            style="@style/PetCare.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/profile_section_contacts" />

                        <!-- "2 SAVED", or "NONE YET". A fact about the list rather than an invite state. -->
                        <TextView
                            android:id="@+id/contactsStatusPill"
                            style="@style/PetCare.Profile.StatusPill.Accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2 saved" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Shown instead of the rows when nothing has been saved yet. -->
                    <TextView
                        android:id="@+id/contactsEmptyText"
                        style="@style/PetCare.Profile.RowSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/profile_row_padding_vertical"
                        android:layout_marginBottom="@dimen/profile_row_padding_vertical"
                        android:maxLines="4"
                        android:text="@string/profile_contacts_empty"
                        tools:visibility="gone" />

                    <!-- One inflated row per saved contact. -->
                    <LinearLayout
                        android:id="@+id/contactsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- The outlined "Add a contact" row, the same component the Pets tab ends its list. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addContactButton"
                        style="@style/PetCare.AddRowButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/card_padding"
                        android:text="@string/profile_contacts_add" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DATA & PRIVACY. -->

            <com.google.android.material.card.MaterialCardView
                style="@style/PetCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                app:cardCornerRadius="@dimen/corner_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <TextView
                        style="@style/PetCare.Profile.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_data" />

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Export. -->
                    <LinearLayout
                        android:id="@+id/exportRow"
                        style="@style/PetCare.Profile.Row.Clickable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_export_title" />

                            <TextView
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_export_subtitle" />

                        </LinearLayout>

                        <!-- The chevron is decorative: the row is already announced as a button with its title. -->
                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Backup & sync. Its subtitle is the same sync status the dashboard reports. -->
                    <LinearLayout
                        android:id="@+id/backupRow"
                        style="@style/PetCare.Profile.Row.Clickable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_backup_title" />

                            <TextView
                                android:id="@+id/backupSubtitle"
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Last backup 3 minutes ago" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <View style="@style/PetCare.Profile.RowDivider" />

                    <!-- Delete account. Red, and the only row in the app drawn that way. -->
                    <LinearLayout
                        android:id="@+id/deleteAccountRow"
                        style="@style/PetCare.Profile.Row.Clickable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/profile_row_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Profile.RowTitle.Destructive"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_delete_title" />

                            <TextView
                                style="@style/PetCare.Profile.RowSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_row_delete_subtitle" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorError" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================================== Footer ================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logOutButton"
                style="@style/PetCare.Profile.LogOutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_section_gap"
                android:text="@string/profile_log_out" />

            <!-- "PetCare 1.0 · records stored on this device". The version is read from BuildConfig by the fragment. -->
            <TextView
                android:id="@+id/versionText"
                style="@style/PetCare.Profile.Version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                tools:text="PetCare 1.0 · records stored on this device" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
