<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Money tab's category legend, under the total card: a coloured dot, the category's name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/spacing_xs"
    android:paddingBottom="6dp">

    <!-- The dot, tinted per row with the category's colour. -->
    <View
        android:id="@+id/categoryDot"
        android:layout_width="@dimen/expenses_legend_dot_size"
        android:layout_height="@dimen/expenses_legend_dot_size"
        android:background="@drawable/bg_category_dot"
        android:importantForAccessibility="no"
        tools:backgroundTint="@color/accent_yellow" />

    <TextView
        android:id="@+id/categoryNameText"
        style="@style/PetCare.Expenses.LegendName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        tools:text="Medication" />

    <TextView
        android:id="@+id/categoryShareText"
        style="@style/PetCare.Expenses.LegendShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        tools:text="89%" />

    <TextView
        android:id="@+id/categoryAmountText"
        style="@style/PetCare.Expenses.Amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:textColor="?attr/colorOnBackground"
        tools:text="Rs 4,665" />

</LinearLayout>
