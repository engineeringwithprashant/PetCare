<?xml version="1.0" encoding="utf-8"?>
<!-- One pet in the dashboard's sideways "Your pets" row: a dark portrait card with the pet's photo. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/home_pet_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/home_pet_card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/pet_card_ground"
    app:cardElevation="0dp"
    app:rippleColor="@color/accent_yellow"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.HomePetCard"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- The photograph. Both dimensions are 0dp and the ratio resolves them: the width fills the card. -->
        <ImageView
            android:id="@+id/petPhotoImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_pet_photo_dark"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pet_placeholder"
            app:layout_constraintDimensionRatio="@string/pet_photo_aspect_ratio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The gradient that keeps the name legible over a pale photo. -->
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/home_pet_card_scrim_height"
            android:background="@drawable/bg_pet_card_scrim"
            app:layout_constraintBottom_toBottomOf="@id/petPhotoImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- "CAT", top-left. Upper-cased by its style rather than in the string. -->
        <TextView
            android:id="@+id/speciesChip"
            style="@style/PetCare.SpeciesChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/home_stat_card_padding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Cat" />

        <!-- The pet's name, bottom-left, up to two lines for a long one. -->
        <TextView
            android:id="@+id/petNameText"
            style="@style/PetCare.Home.PetCardName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/home_stat_card_padding"
            app:layout_constraintBottom_toBottomOf="@id/petPhotoImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Krishala" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
