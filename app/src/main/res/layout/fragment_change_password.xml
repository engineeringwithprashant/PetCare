<?xml version="1.0" encoding="utf-8"?>
<!--
    The form behind the profile screen's "UPDATE" pill: confirm the current password, then set a new
    one twice.

    Reached from the profile screen, so it shows the shared app bar with its back arrow rather than
    drawing the tab header — it is a step *into* something, not a step sideways.

    **Why three fields and not two.** The current password is asked for because a phone left unlocked
    on a table is the realistic threat here: without it, anyone who picked the device up could lock the
    owner out of their own account in four taps. The new password is asked for twice because it is
    masked — a typo in a field nobody can read is one the user only discovers at the next sign-in,
    when it is too late to remember what they meant to type.

    **Why an eye icon on all three.** `endIconMode="password_toggle"` puts it inside the right edge of
    each box and swaps it between "eye" and "eye with a stroke through it", so the icon always shows
    the current state; each field owns its own, so revealing one never reveals another. That is not a
    weakening: it is the standard answer to masked-field typos, it is the user's own choice made on
    their own screen, and the alternative — forcing people to type a long password blind — reliably
    produces weaker passwords, because people pick ones that are easy to type.

    (These used to use the older `passwordToggleEnabled` attribute, which Material keeps only for
    compatibility with the Design-library field it replaced. `endIconMode` is the Material 3 spelling
    and the one that accepts a content description, which is what TalkBack reads.)

    A ScrollView for the reason every form in the app is one: at a large font scale and with the
    keyboard up, three fields and a button do not fit, and MainActivity applies the keyboard inset as
    padding on the root so a ScrollView re-measures and scrolls the focused field into view by itself.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/list_padding_bottom"
    tools:context=".ui.profile.ChangePasswordFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/content_top_padding"
        android:paddingEnd="@dimen/screen_padding">

        <!-- The current password. Firebase Authentication checks it (the data layer asks it to
             re-authenticate), never this screen — see UserRepository.changePassword. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/currentPasswordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/change_password_current_label"
            app:endIconContentDescription="@string/cd_toggle_password_visibility"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <!-- inputType="textPassword" is what masks the field and, just as importantly, tells the
                 keyboard not to offer autocorrect or store the value in its learned-words dictionary. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/currentPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- The new password. The rules are shown by the checklist below rather than crammed into a
             helper line, so the helper slot is gone: six rules do not fit on one line, and a line
             saying only "at least 8 characters" beside a checklist naming five more rules would be
             the same policy described twice, differently. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/newPasswordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/change_password_new_label"
            app:endIconContentDescription="@string/cd_toggle_password_visibility"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- The six rules, ticking off live as the password is typed — the same component the
             register form uses, so choosing a password means the same thing on both screens. Under
             the field it describes and above the confirmation, which is where someone inventing a
             password is already looking. -->
        <com.prash.petcare.ui.common.PasswordChecklistView
            android:id="@+id/passwordChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm" />

        <!-- Typed again, because a masked typo is one the user would not discover until the next
             sign-in. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/change_password_confirm_label"
            app:endIconContentDescription="@string/cd_toggle_password_visibility"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- The one action on the screen, so it is the filled accent button. It is disabled while the
             change is in flight: it is a round trip to Firebase Authentication and takes a noticeable
             moment, which without this would be long enough to tap three times. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/PetCare.TaskActionButton.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/change_password_save" />

    </LinearLayout>

</ScrollView>
