<?xml version="1.0" encoding="utf-8"?>
<!--
    The large card the *first* pet on the dashboard gets: their photograph filling the card, a dark
    gradient over the lower portion, and their name and status written across it.

    The follow-on pets use item_pet_row.xml instead — a shorter horizontal card. See
    PetSummaryAdapter for why the list is drawn in two sizes rather than one.

    **How the layers stack.** A ConstraintLayout is used as a stack here rather than for its usual
    job of relating siblings side by side: the photo, the scrim and the text all fill or anchor to
    the same parent, and the order they are *declared* in is the order they are painted. Photo
    first, scrim over it, text on top of that. Declaring the text before the scrim would bury it.

    **Why the card is dark in both themes.** Everything written here sits on a photograph, and a
    photograph does not change with the display mode — so white text over a dark scrim is the only
    pairing that stays legible in both. See the pet-card note in colors.xml.

    The card is deliberately not the app's standard white PetCare.Card: it declares its own
    background and a larger radius, because it is the page's subject rather than one row among
    several.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pet_card_hero_height"
    android:layout_marginBottom="@dimen/card_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/pet_card_ground"
    app:cardCornerRadius="@dimen/pet_card_corner_radius"
    app:cardElevation="0dp"
    app:rippleColor="@color/accent_yellow"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            The photograph, filling the whole card.

            centerCrop rather than fitCenter: the card has a fixed shape and a photo almost never
            shares it, so the picture is scaled to cover and the overflow is trimmed. Fitting it
            instead would letterbox every portrait photo with bands of the card's ground colour.

            The MaterialCardView clips this to the rounded outline, so the image needs no shape of
            its own — which is why a plain ImageView is enough here where the round thumbnails
            elsewhere in the app need a ShapeableImageView.

            The adapter loads the bitmap into this asynchronously; see ui/common/PetPhotoBinder.kt
            for why a recycled card needs more care than a single assignment.
        -->
        <ImageView
            android:id="@+id/petPhotoImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_pet_photo_dark"
            android:contentDescription="@string/cd_pet_photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pet_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The gradient that keeps the writing legible over the picture. Anchored to the bottom
             with a fixed height rather than filling the card, so the top of the photo is left
             untouched — see bg_pet_card_scrim.xml for why it fades rather than steps. -->
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/pet_card_scrim_height"
            android:background="@drawable/bg_pet_card_scrim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- The species, in the opposite corner from the name so the two never collide however long
             the pet's name is. Upper-cased by its style rather than in the string, so the label
             stays correct in a language where blanket capitalisation is wrong. -->
        <TextView
            android:id="@+id/speciesChip"
            style="@style/PetCare.SpeciesChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/card_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Cat" />

        <!--
            The pet's name, across the scrim.

            Constrained to the start and end of the card so it has a real width to wrap within —
            a wrap_content name would run off the edge for a long one. Two lines at most, because a
            third would push the pills below the card's bottom edge.

            Note that it is anchored *upwards* from the pill row rather than the pill row being
            placed under it: the pills sit at a fixed distance from the card's bottom edge, and the
            name grows upwards from there, so a one-line name and a two-line name both leave the
            pills in the same place.
        -->
        <TextView
            android:id="@+id/petNameText"
            style="@style/PetCare.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_padding"
            android:layout_marginEnd="@dimen/card_padding"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/on_pet_card"
            app:layout_constraintBottom_toTopOf="@id/pillRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Bella" />

        <!--
            The two pills: the pet's day, then the facts about them.

            A horizontal LinearLayout rather than two more constrained views, because the second pill
            has to sit directly after the first *whatever width the first turns out to be* — "Nothing
            due today" is far wider than "3 left today". Constraining them individually would mean
            fixing a width or chaining them, and a chain of two is more machinery than a row.

            The facts pill is hidden by the adapter when the pet has neither a date of birth nor a
            recorded weight.
        -->
        <LinearLayout
            android:id="@+id/pillRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_padding"
            android:layout_marginEnd="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_padding"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tasksPill"
                style="@style/PetCare.Pill.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Nothing due today" />

            <TextView
                android:id="@+id/factsPill"
                style="@style/PetCare.Pill.OnPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pill_spacing"
                tools:text="2 yrs · 26 kg" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
