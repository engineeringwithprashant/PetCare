<?xml version="1.0" encoding="utf-8"?>
<!--
    Add / edit place form, opened from "+ Add a place" (or a long press on a saved place) on the
    Places tab.

    One layout serves both modes; the fragment changes the title and shows the delete button when
    editing, as on the other forms.

    Top to bottom: name, category, area, phone; the opening hours as a pair of time fields; notes; then
    the **GPS geotag** card, which is the reason this form exists. There are deliberately no latitude
    or longitude fields — the position is captured from the phone, never typed (see
    AddEditPlaceViewModel) — so the card shows what was captured and the button that captures it.

    The root is a CoordinatorLayout so the Snackbars this form shows ("Could not get a location fix…")
    sit above the bottom navigation bar — see fragment_checklist.xml — with a ScrollView inside it,
    because the form is taller than a small phone once the keyboard is up.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.place.AddEditPlaceFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- The bottom padding is deeper than the other three sides because the floating navigation
             bar is drawn *over* this form — see form_scroll_padding_bottom, which also records what
             went wrong here without it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/form_scroll_padding_bottom">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/place_name_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category: an exposed dropdown with inputType="none", so the value is always one of the
                 four PlaceCategory constants the tab's chips filter on — never free text. -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/place_category_label">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/categoryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/place_area_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/areaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPostalAddress|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
                The place's number: a country selector and the local number beside it.

                Optional — many parks have none — but a number that *is* given is stored in one
                international form and checked against the country chosen. That matters here because
                the saved-place row offers to dial this number: a number kept in whatever shape it was
                typed is a call button that may fail at the moment somebody needs a vet. The behaviour
                behind the pair is ui/common/PhoneNumberInput.kt, shared with the sign-in and profile
                forms, and a number saved before this form had a selector is read back into the two
                boxes on open.

                A horizontal LinearLayout: the selector at a fixed width so the number box always
                starts in the same place whatever the dialling code, and the number taking the rest
                (width 0 + weight 1).
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Not typed into: tapping it opens the country list. PhoneNumberInput makes it
                     unfocusable and gives it a spoken description naming the country in full. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneCountryLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="@dimen/phone_country_field_width"
                    android:layout_height="wrap_content"
                    android:hint="@string/phone_country_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneCountryInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1"
                        tools:text="🇳🇵 +977" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- inputType="phone" brings up the dial pad. How many digits it accepts is capped per
                     country by PhoneNumberInput, so an over-long number cannot be typed at all. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/phone_country_field_gap"
                    android:layout_weight="1"
                    android:hint="@string/place_phone_label"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- ============================ Opening hours ============================ -->
            <TextView
                style="@style/PetCare.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/place_hours_heading" />

            <!-- Opens and Closes side by side, each half the width through layout_weight — they are
                 one fact ("8:00 to 20:00") and read best on one line. Tapping either opens a Material
                 time picker; focusable="true" with the soft keyboard suppressed in code keeps them
                 reachable by keyboard and switch access without popping up a keyboard. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/place_opening_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/openingTimeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="true"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/place_closing_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/closingTimeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="true"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- One error for the pair rather than one per field, because the problem ("only one of
                 the two is set") belongs to neither field alone. -->
            <TextView
                android:id="@+id/hoursErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- For places with no opening hours, such as a public park. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearHoursButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/place_clear_hours"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/place_notes_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/notesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============================== Location ==============================
                 The same map picker the Add a place screen uses — see view_location_picker.xml.

                 **What it replaced.** This card used to be a read-out of stored coordinates with a
                 "Capture current location" button under it, which could do exactly one thing: replace
                 the saved position with wherever the phone happened to be. Correcting a geotag that
                 had landed on the wrong side of the road meant standing on the right side of it. The
                 map opens on the place's own saved coordinates instead, with the pin on the point, so
                 the position can be kept, dragged, or replaced with the current one — the three things
                 a person actually wants to do to a saved location — now four, since the picker also
                 carries a search field: a place whose pin landed in the wrong street can be put right
                 by typing its name.

                 wrap_content, where this used to ask for the map's height: the picker is a column now
                 and holds the map's fixed height internally, for the reason given in
                 fragment_add_place.xml. -->
            <TextView
                style="@style/PetCare.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/place_location_heading" />

            <com.prash.petcare.ui.place.LocationPickerView
                android:id="@+id/locationPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <TextView
                style="@style/PetCare.AddPlace.MapHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/map_picker_hint" />

            <!-- What the pin is pointing at, in words and figures. -->
            <include
                android:id="@+id/selectedLocation"
                layout="@layout/view_selected_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <!-- The validation message when the form is saved with no location at all — only
                 reachable when creating rather than editing, since a saved place always has one. -->
            <TextView
                android:id="@+id/locationErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/savePlaceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/place_save" />

            <!-- Edit mode only. The theme's error colour marks it as destructive — see
                 fragment_add_edit_task.xml. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/deletePlaceButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/place_delete"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                app:strokeColor="?attr/colorError"
                tools:visibility="visible" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_md"
                android:indeterminate="true"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
