<?xml version="1.0" encoding="utf-8"?>
<!--
    A category heading in the checklist ("Feeding", "Walk").

    Just a styled TextView: headings are not interactive, so wrapping this in a card or a layout
    container would add depth to a recycled view for no benefit.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categoryHeaderText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    android:textAppearance="?attr/textAppearanceTitleSmall"
    android:textColor="?attr/colorPrimary"
    tools:text="Feeding" />
