<?xml version="1.0" encoding="utf-8"?>
<!--
    A category heading in the checklist ("Feeding", "Walk"), with the category's icon beside it.

    The icon carries most of the work here: once several categories are on screen, a symbol is read
    far faster than a word when scanning for the next thing to do.

    It is a *compound drawable* on the TextView rather than a separate ImageView in a row. That is
    one view instead of three, which matters in a list that inflates and recycles these constantly,
    and it keeps the icon and its label aligned automatically. The adapter sets which icon by
    calling setCompoundDrawablesRelativeWithIntrinsicBounds.

    app:drawableTint colours the icon to match the label, so the two read as one heading rather than
    as an icon with text after it.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categoryHeaderText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:drawablePadding="@dimen/spacing_sm"
    android:gravity="center_vertical"
    android:textAppearance="?attr/textAppearanceTitleSmall"
    android:textColor="?attr/colorPrimary"
    app:drawableTint="?attr/colorPrimary"
    tools:drawableStart="@drawable/ic_category_feeding"
    tools:text="Feeding" />
