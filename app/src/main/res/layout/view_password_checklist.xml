<?xml version="1.0" encoding="utf-8"?>
<!--
    The contents of PasswordChecklistView (ui/common/PasswordChecklistView.kt): the six rules a new
    password has to satisfy, each ticking itself off as the user types.

    It sits under every field where a password is *chosen* — the register form and the change-password
    form — so that the rules are visible while the password is being invented rather than announced as
    a red error after the user has pressed the button and lost their train of thought.

    **Why <merge>.** PasswordChecklistView *is* a vertical LinearLayout, so inflating an ordinary
    layout into it would nest a second LinearLayout inside the first for nothing; <merge> adds these
    rows straight to the custom view. tools:parentTag only tells the Studio preview what the parent
    will be, since a merge file has no root of its own to draw.

    **Why each rule is one TextView and not an icon plus a label.** A compound drawable
    (drawableStart) puts the tick inside the text view itself, so a rule is a single view with a single
    id, the icon lines up with the first line of text automatically when a long rule wraps, and the
    whole row is one thing for TalkBack to read — where an ImageView beside a TextView would be two
    nodes, the first of them an unlabelled shape.

    The rows are hidden from TalkBack individually and described as a group by the view itself — see
    PasswordChecklistView.show(), which announces "4 of 6 met" rather than making the user swipe
    through six lines after every keystroke.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/ruleLength"
        style="@style/PetCare.PasswordRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:drawableStartCompat="@drawable/ic_rule_unmet"
        tools:text="8–64 characters" />

    <TextView
        android:id="@+id/ruleUppercase"
        style="@style/PetCare.PasswordRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/password_rule_uppercase"
        app:drawableStartCompat="@drawable/ic_rule_unmet" />

    <TextView
        android:id="@+id/ruleLowercase"
        style="@style/PetCare.PasswordRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/password_rule_lowercase"
        app:drawableStartCompat="@drawable/ic_rule_unmet" />

    <TextView
        android:id="@+id/ruleDigit"
        style="@style/PetCare.PasswordRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/password_rule_digit"
        app:drawableStartCompat="@drawable/ic_rule_unmet" />

    <TextView
        android:id="@+id/ruleSpecial"
        style="@style/PetCare.PasswordRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/password_rule_special"
        app:drawableStartCompat="@drawable/ic_rule_unmet" />

    <!-- The one rule phrased as something to avoid rather than something to include. It is listed
         last for that reason: the five above are a recipe to follow, and this is the single thing
         that can still spoil the result. -->
    <TextView
        android:id="@+id/rulePattern"
        style="@style/PetCare.PasswordRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/password_rule_pattern"
        app:drawableStartCompat="@drawable/ic_rule_unmet" />

</merge>
