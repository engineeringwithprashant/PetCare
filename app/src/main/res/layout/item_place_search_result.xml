<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the place-search results list: a pin, the place's name, and where it is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchResultRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/place_search_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/place_search_row_padding_horizontal"
    android:paddingEnd="@dimen/place_search_row_padding_horizontal"
    android:paddingTop="@dimen/place_search_row_padding_vertical"
    android:paddingBottom="@dimen/place_search_row_padding_vertical">

    <!-- Decorative: the row's text says everything the pin stands. -->
    <ImageView
        android:layout_width="@dimen/place_search_row_icon_size"
        android:layout_height="@dimen/place_search_row_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_map_pin"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- "Patan Hospital". One line and ellipsized. -->
        <TextView
            android:id="@+id/resultNameText"
            style="@style/PetCare.PlaceSearch.ResultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Patan Hospital" />

        <!-- "Kumaripati, Lalitpur Metropolitan City". Gone. -->
        <TextView
            android:id="@+id/resultAddressText"
            style="@style/PetCare.PlaceSearch.ResultAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Kumaripati, Lalitpur Metropolitan City" />

    </LinearLayout>

</LinearLayout>
