<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the place-search results list: a pin, the place's name, and where it is.

    **Why two lines rather than one.** A search for "animal hospital" can easily return four places
    with nearly the same name, and the name alone would make them indistinguishable — the user would
    be picking at random between identical rows. The second line is what tells them apart, so it is
    the line that makes the list usable rather than a detail added to it.

    **Why this is not a card.** The rows sit inside one elevated panel (see view_location_picker.xml),
    which is what makes the list read as a dropdown belonging to the field above it. A card per row
    would turn it into a list of separate objects floating over the map.

    A plain LinearLayout with a ripple background and `focusable`, so it behaves as one tappable row
    for touch, for a keyboard and for TalkBack — which reads the two lines as one phrase because the
    adapter sets a contentDescription on this root.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchResultRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/place_search_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/place_search_row_padding_horizontal"
    android:paddingEnd="@dimen/place_search_row_padding_horizontal"
    android:paddingTop="@dimen/place_search_row_padding_vertical"
    android:paddingBottom="@dimen/place_search_row_padding_vertical">

    <!-- Decorative: the row's text says everything the pin stands for, and the adapter gives the
         whole row one spoken description. -->
    <ImageView
        android:layout_width="@dimen/place_search_row_icon_size"
        android:layout_height="@dimen/place_search_row_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_map_pin"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- "Patan Hospital". One line and ellipsized: a long business name must not push the row to
             three lines and change the height of every row around it. -->
        <TextView
            android:id="@+id/resultNameText"
            style="@style/PetCare.PlaceSearch.ResultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Patan Hospital" />

        <!-- "Kumaripati, Lalitpur Metropolitan City". Gone rather than blank for a result MapTiler
             gave no context for, so the row closes up to one line instead of leaving a gap that reads
             as a missing value. -->
        <TextView
            android:id="@+id/resultAddressText"
            style="@style/PetCare.PlaceSearch.ResultAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Kumaripati, Lalitpur Metropolitan City" />

    </LinearLayout>

</LinearLayout>
