<?xml version="1.0" encoding="utf-8"?>
<!--
    One preset chip on the "Record a vaccination" screen — "FVRCP", "Rabies", "DHPP".

    A layout holding a single view, for the reason given in item_category_chip.xml: a Material
    component takes its appearance from the style applied at *inflation*, so a Chip built in code
    would get platform defaults and look nothing like the app. ui/common/FilterChips.kt inflates one
    of these per option and sets its text.

    The whole chosen/unchosen appearance is in PetCare.Record.PresetChip, which is the Tasks tab's
    filter chip at a smaller size — mechanically the same control, in a quieter role.
-->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Record.PresetChip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:text="Rabies" />
