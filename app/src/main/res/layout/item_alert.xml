<?xml version="1.0" encoding="utf-8"?>
<!-- One alert card on the notifications screen: a square type code ("VAX"). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alertCard"
    style="@style/PetCare.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/alert_card_spacing"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge"
    tools:cardBackgroundColor="?attr/colorPrimaryContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/alert_card_padding">

        <!-- "VAX", "MISS", "MILE". Its fill and text colour are set by the adapter: the accent while unread. -->
        <TextView
            android:id="@+id/alertBadgeText"
            style="@style/PetCare.Notifications.Badge"
            tools:backgroundTint="@color/accent_yellow"
            tools:text="VAX" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- The alert itself, wrapping to a second line when it needs one. -->
            <TextView
                android:id="@+id/alertTitleText"
                style="@style/PetCare.Notifications.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Ddjw's rabies booster is due tomorrow" />

            <!-- What kind of alert it is, and how old. -->
            <TextView
                android:id="@+id/alertMetaText"
                style="@style/PetCare.Notifications.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                tools:text="Care reminder · 2h ago" />

        </LinearLayout>

        <!-- Reserves the dot's width at the end of the row so a long unwrapped word can never run underneath it. -->
        <Space
            android:layout_width="@dimen/spacing_sm"
            android:layout_height="1dp" />

    </LinearLayout>

    <!-- The unread mark. Hidden on a read card, and gone rather than invisible so it reserves nothing. -->
    <View
        android:id="@+id/alertUnreadDot"
        android:layout_width="@dimen/alert_dot_size"
        android:layout_height="@dimen/alert_dot_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/alert_card_padding"
        android:layout_marginEnd="@dimen/alert_card_padding"
        android:background="@drawable/bg_alert_dot"
        android:importantForAccessibility="no"
        tools:visibility="visible" />

</com.google.android.material.card.MaterialCardView>
