<?xml version="1.0" encoding="utf-8"?>
<!--
    The body of the second delete-account dialog: a single field the user types DELETE into.

    **Why a second dialog at all.** The first explains what is destroyed and offers a way out, which is
    the normal confirmation. This one exists because the action has no undo whatsoever — every pet,
    routine, task, expense and saved place on the device goes with the account — and a plain
    confirm button is one mis-tap away from all of it. Typing the word cannot be done by accident, and
    the few seconds it takes are a moment in which the user re-reads what they are about to do. It is
    the pattern GitHub, Stripe and every other tool with an irreversible destroy action settles on, for
    exactly this reason.

    The dialog's title, its explanation and its two buttons come from MaterialAlertDialogBuilder, so
    this file is only the field between them.

    `textCapCharacters` puts the keyboard straight into capitals, since the word to type is written in
    capitals — the comparison itself ignores case (see ProfileFragment.askForDeleteWord), so this is a
    convenience rather than a requirement.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_lg">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/profile_delete_confirm_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirmInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
