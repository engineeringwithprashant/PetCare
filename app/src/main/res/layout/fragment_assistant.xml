<?xml version="1.0" encoding="utf-8"?>
<!-- The Assistant screen, opened from the dashboard's "Ask the assistant" button and its AI pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.assistant.AssistantFragment">

    <!-- The monogram, "Assistant", the theme toggle, the AI pill and the pet badge. -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- ========================== What this is ========================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/home_screen_padding"
        android:layout_marginEnd="@dimen/home_screen_padding"
        app:cardBackgroundColor="@color/next_up_card_ground"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.NextUp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/next_up_card_padding">

            <!-- "CARE ASSISTANT" — the same muted uppercase mark the next-up card uses. -->
            <TextView
                style="@style/PetCare.Home.NextUpLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_header_label" />

            <!-- "Ask about Krishala & Ddjw". The names are built from the database by the fragment. -->
            <TextView
                android:id="@+id/assistantTitleText"
                style="@style/PetCare.Home.NextUpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                tools:text="Ask about Krishala &amp; Ddjw" />

            <!-- What it will answer, why its answers fit these animals, and what it is not. -->
            <TextView
                style="@style/PetCare.Home.NextUpMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:maxLines="4"
                android:text="@string/assistant_header_body" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ========================== The conversation ========================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/home_section_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/home_screen_padding"
        android:paddingEnd="@dimen/home_screen_padding"
        android:paddingBottom="@dimen/spacing_sm"
        tools:itemCount="3"
        tools:listitem="@layout/item_assistant_message" />

    <!-- ===================== Suggested questions ===================== -->
    <HorizontalScrollView
        android:id="@+id/suggestionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/home_screen_padding"
        android:paddingEnd="@dimen/home_screen_padding"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/suggestionsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/spacing_sm"
            app:singleLine="true" />

    </HorizontalScrollView>

    <!-- ============================ The input row ============================ -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/home_screen_padding"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/home_screen_padding"
        android:layout_marginBottom="@dimen/spacing_md"
        android:baselineAligned="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The field. 0dp with weight 1 so it takes everything the button leaves, whatever the button's size. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/questionInputLayout"
            style="@style/PetCare.Assistant.InputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/assistant_input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/questionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- The round yellow send button with its upward arrow. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendButton"
            style="@style/PetCare.Assistant.SendButton"
            android:layout_width="@dimen/assistant_send_button_size"
            android:layout_height="@dimen/assistant_send_button_size"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/cd_assistant_send"
            app:icon="@drawable/ic_assistant_send" />

    </LinearLayout>

</LinearLayout>
