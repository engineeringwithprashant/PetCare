<?xml version="1.0" encoding="utf-8"?>
<!--
    Today's care checklist: the care due today, grouped under category headings, each row tickable,
    plus an action to hand the whole list to someone else by text message or email.

    **This layout serves two screens.** Reached from the bottom navigation bar it is the Tasks tab
    and shows the pet picker at the top; reached from a pet's detail page it shows that animal alone
    and the picker is hidden. See the note at the top of nav_graph.xml on why one destination does
    both jobs. Everything below the picker is identical either way, which is the point — delegation,
    swipe-to-complete and shake-to-reset exist in exactly one place.

    The list mixes two row layouts (headings and tasks) in a single RecyclerView rather than using a
    separate list per category, so the whole page scrolls as one.

    The root is a CoordinatorLayout so the extended floating action button and any Snackbar
    cooperate — a Snackbar sliding up lifts the button rather than covering it.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.checklist.ChecklistFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            The pet picker. Included with an id, which is what makes ViewBinding expose it as a
            nested binding — the fragment reaches its chip group as `binding.petPicker.petChipGroup`
            rather than having those ids flattened into this layout's own.

            Hidden entirely when the screen is showing one particular pet. `gone` rather than
            `invisible`, so the progress line below moves up to the top of the screen instead of
            leaving a band of empty space where a picker might have been.
        -->
        <include
            android:id="@+id/petPicker"
            layout="@layout/view_pet_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!--
            The day's progress, in a card of its own.

            A card rather than a bare line of text, because it is the one figure on this screen the
            user came to check — "how much is left?" — and a white surface on the cream page is what
            marks it out from the list of rows beneath it.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/progressCard"
            style="@style/PetCare.Card.Feature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/screen_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/petPicker">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/checklistProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="2 of 5 tasks done" />

                <!-- Explains why the delegate action is unavailable once everything has been ticked
                     off. Hidden the rest of the time, so it takes up no space and does not make the
                     card taller than the one line it usually holds. -->
                <TextView
                    android:id="@+id/allDoneText"
                    style="@style/PetCare.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone"
                    tools:text="@string/checklist_all_done"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- The generous bottom padding, with clipToPadding="false", lets the last row scroll clear
             of the delegate button instead of finishing underneath it. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/checklistRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/list_padding_bottom_fab"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressCard"
            tools:listitem="@layout/item_checklist_task" />

        <!-- Occupies the same region as the list; the fragment shows exactly one of the two. Its
             wording is set in code, because "nothing due today" and "no pets to show" are different
             situations that both leave this screen with nothing to draw. -->
        <LinearLayout
            android:id="@+id/emptyChecklistContainer"
            style="@style/PetCare.EmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/checklistRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/checklistRecyclerView"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/emptyChecklistIcon"
                style="@style/PetCare.EmptyStateIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_empty_tasks" />

            <TextView
                android:id="@+id/emptyChecklistTitle"
                style="@style/PetCare.EmptyStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checklist_empty_title" />

            <TextView
                android:id="@+id/emptyChecklistMessage"
                style="@style/PetCare.EmptyStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checklist_empty_message" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
        Hands this pet's checklist to someone else. Tapping it asks which channel to use — text
        message or email — rather than the screen carrying a button for each: the two are the same
        action sent two ways, and a second floating button would imply two different jobs.

        An extended floating action button rather than a plain one: the action messages a real
        person, and a text costs money to send, so it carries a written label instead of leaving an
        icon to be guessed at.
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/delegateFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/checklist_delegate"
        app:icon="@drawable/ic_send" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
