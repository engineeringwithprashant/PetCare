<?xml version="1.0" encoding="utf-8"?>
<!--
    Today's checklist for one pet: the care due today, grouped under category headings, each row
    tickable, plus an action to text the whole list to someone else.

    The screen's title — "Today for Bella" — is set on the app bar by the fragment, so it is not
    repeated here.

    The list mixes two row layouts (headings and tasks) in a single RecyclerView rather than using a
    separate list per category, so the whole page scrolls as one.

    The root is a CoordinatorLayout so the extended floating action button and any Snackbar
    cooperate — a Snackbar sliding up lifts the button rather than covering it.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.checklist.ChecklistFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Running total of what has been ticked off, so progress is visible without counting. -->
        <TextView
            android:id="@+id/checklistProgressText"
            style="@style/PetCare.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2 of 5 tasks done" />

        <!-- Explains why the delegate action is unavailable once everything has been ticked off.
             Hidden the rest of the time, so it takes up no space and does not push the list down. -->
        <TextView
            android:id="@+id/allDoneText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/checklistProgressText"
            tools:text="@string/checklist_all_done"
            tools:visibility="visible" />

        <!-- The generous bottom padding, with clipToPadding="false", lets the last row scroll clear
             of the delegate button instead of finishing underneath it. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/checklistRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/card_spacing"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/list_padding_bottom_fab"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/allDoneText"
            tools:listitem="@layout/item_checklist_task" />

        <!-- Occupies the same region as the list; the fragment shows exactly one of the two. -->
        <LinearLayout
            android:id="@+id/emptyChecklistContainer"
            style="@style/PetCare.EmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/checklistRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/checklistRecyclerView"
            tools:visibility="visible">

            <ImageView
                style="@style/PetCare.EmptyStateIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_empty_tasks" />

            <TextView
                style="@style/PetCare.EmptyStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checklist_empty_title" />

            <TextView
                style="@style/PetCare.EmptyStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checklist_empty_message" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
        Hands this pet's checklist to someone else by text message.

        An extended floating action button rather than a plain one: sending a text costs money and
        messages a real person, so the action carries a written label instead of leaving an icon to
        be guessed at.
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/delegateFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/checklist_delegate"
        app:icon="@drawable/ic_send" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
