<?xml version="1.0" encoding="utf-8"?>
<!-- The Tasks tab: a week of care, one day at a time. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.checklist.ChecklistFragment">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The shared header, as a nested binding (`binding.header`). Hidden for a single pet. -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/checklistScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================ Week strip ============================ -->
            <LinearLayout
                android:id="@+id/weekStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <include
                    android:id="@+id/day0"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/day1"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_marginStart="@dimen/week_day_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/day2"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_marginStart="@dimen/week_day_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/day3"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_marginStart="@dimen/week_day_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/day4"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_marginStart="@dimen/week_day_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/day5"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_marginStart="@dimen/week_day_gap"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/day6"
                    layout="@layout/item_week_day"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/week_day_height"
                    android:layout_marginStart="@dimen/week_day_gap"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- ============================ Progress card ============================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/progressCard"
                style="@style/PetCare.Card.Feature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/screen_padding"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- The date and the count on the left, "Reset day" on the right. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- "THURSDAY 11 SEPTEMBER" — the section-label treatment. -->
                            <TextView
                                android:id="@+id/progressDateText"
                                style="@style/PetCare.SectionLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Thursday 11 September" />

                            <TextView
                                android:id="@+id/progressCountText"
                                style="@style/PetCare.Headline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="5 of 6 done" />

                        </LinearLayout>

                        <!-- Clears the ticks shown on screen — the same action as shaking the phone. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resetDayButton"
                            style="@style/PetCare.SmallPillButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/tasks_reset_day" />

                    </LinearLayout>

                    <!-- One segment per task; drawn by ui/common/SegmentedProgressView.kt. -->
                    <com.prash.petcare.ui.common.SegmentedProgressView
                        android:id="@+id/progressSegments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/progressHelpText"
                        style="@style/PetCare.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        tools:text="@string/tasks_progress_help" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================ Filter rows ============================ -->
            <HorizontalScrollView
                android:id="@+id/categoryChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/pill_spacing"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />

            </HorizontalScrollView>

            <!-- The pet row. Hidden for a single pet's checklist, where there is nothing to choose. -->
            <HorizontalScrollView
                android:id="@+id/petChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/petChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/pill_spacing"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />

            </HorizontalScrollView>

            <!-- ============================== Task list ============================== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/checklistRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                tools:itemCount="3"
                tools:listitem="@layout/item_checklist_task" />

            <!-- Shown in the list's place when there is nothing to show. -->
            <LinearLayout
                android:id="@+id/emptyChecklistContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:id="@+id/emptyChecklistIcon"
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_tasks" />

                <TextView
                    android:id="@+id/emptyChecklistTitle"
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_empty_title" />

                <TextView
                    android:id="@+id/emptyChecklistMessage"
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_empty_message" />

            </LinearLayout>

            <!-- ============================== Actions ============================== -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addTaskButton"
                    style="@style/PetCare.TaskActionButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tasks_add_task" />

                <!-- Hands the outstanding tasks to someone else by text or email. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delegateButton"
                    style="@style/PetCare.TaskActionButton.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/checklist_delegate" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
