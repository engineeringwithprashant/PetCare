<?xml version="1.0" encoding="utf-8"?>
<!-- Password reset (ResetRequestFragment): type the account's email address and ask for a reset link. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Auth.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.reset.ResetRequestFragment">

    <LinearLayout
        style="@style/PetCare.Auth.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- The logo block and this screen's heading and subtitle. -->
        <include
            android:id="@+id/header"
            layout="@layout/view_auth_header" />

        <!-- "ACCOUNT EMAIL". Upper-cased by the style. labelFor tells TalkBack this text names the field below. -->
        <TextView
            style="@style/PetCare.Auth.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_header_gap"
            android:labelFor="@id/accountEmailInput"
            android:text="@string/reset_account_email_label" />

        <!-- The address field. Starts empty. TextInputLayout draws the format error directly under the box. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/accountEmailLayout"
            style="@style/PetCare.Auth.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/accountEmailInput"
                style="@style/PetCare.Auth.FieldInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/register_email_hint"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- The muted note under the field. It stays visible when an error appears above it. -->
        <TextView
            style="@style/PetCare.Auth.Helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_label_gap"
            android:text="@string/reset_account_email_helper" />

        <!-- Starts disabled. The fragment enables it only. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendLinkButton"
            style="@style/PetCare.Auth.PrimaryButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:enabled="false"
            android:text="@string/reset_send_link" />

        <!-- Shown only while Firebase is handling the request. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sendingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="2dp" />

        <!-- No network, rate limited, or another failure that is not about the address format. -->
        <TextView
            android:id="@+id/failureText"
            style="@style/PetCare.Auth.ErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_horizontal"
            android:visibility="gone"
            tools:text="@string/reset_error_network"
            tools:visibility="visible" />

        <!-- Centred by its style. Returns to the log in screen already on the back stack. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToLoginButton"
            style="@style/PetCare.Auth.BackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/auth_back_to_login" />

    </LinearLayout>
</ScrollView>
