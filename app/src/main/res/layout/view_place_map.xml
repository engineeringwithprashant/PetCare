<?xml version="1.0" encoding="utf-8"?>
<!-- The inside of PlaceMapView: the MapLibre map, and the credit line that has to sit on top of it. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- The map fills the view exactly: both dimensions match_parent, nothing inset. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- "© MapTiler © OpenStreetMap". Small and quiet, but never hidden — see above. -->
    <TextView
        android:id="@+id/attributionText"
        style="@style/PetCare.Map.Attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/map_attribution_margin"
        android:contentDescription="@string/cd_map_attribution"
        android:text="@string/map_attribution" />

</merge>
