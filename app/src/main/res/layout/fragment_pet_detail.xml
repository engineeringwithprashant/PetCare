<?xml version="1.0" encoding="utf-8"?>
<!--
    Pet detail screen: the animal's recorded information, and the care routines set up for it.

    The pet's name is set on the app bar by the fragment, so only the species and breed line appears
    beneath the photo here.

    The whole screen scrolls as one, so the routine list is a RecyclerView with wrap_content height
    and nestedScrollingEnabled="false" inside a NestedScrollView. That hands scrolling to the parent
    and lets the list render in full rather than becoming a small scrolling box inside a scrolling
    page. The trade-off is that every routine row is inflated at once instead of being recycled,
    which is fine for the handful of routines a pet realistically has.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pet.PetDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_padding_bottom_fab">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pet_photo_height"
                app:cardCornerRadius="@dimen/image_card_corner_radius">

                <ImageView
                    android:id="@+id/petPhotoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_pet_photo"
                    android:padding="@dimen/spacing_lg"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pet_placeholder" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/petSubtitleText"
                style="@style/PetCare.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="Dog · Labrador" />

            <!-- Recorded details. Each block is hidden by the fragment when its field is empty, so
                 a pet with only a name does not show a column of blank headings. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailsCard"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:id="@+id/dobBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_dob_label" />

                        <TextView
                            android:id="@+id/dobValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="4 Mar 2021" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/weightBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_weight_label" />

                        <TextView
                            android:id="@+id/weightValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="24.5 kg" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dietaryBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_dietary_label" />

                        <TextView
                            android:id="@+id/dietaryValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Two cups of dry food, morning and evening" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/allergiesBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_allergies_label" />

                        <TextView
                            android:id="@+id/allergiesValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Chicken" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toysBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_toys_label" />

                        <TextView
                            android:id="@+id/toysValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Rope toy, tennis ball" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checklistButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/pet_detail_checklist" />

            <!-- Outlined rather than filled, like the edit button below it: the checklist above is
                 this screen's primary action, and two filled buttons in a row would give the user
                 no steer on which to reach for. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/expensesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/pet_detail_expenses" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editPetButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/pet_detail_edit" />

            <TextView
                style="@style/PetCare.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/pet_detail_routines_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/routinesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_spacing"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_routine" />

            <LinearLayout
                android:id="@+id/emptyRoutinesContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_routines" />

                <TextView
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_detail_no_routines_title" />

                <TextView
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_detail_no_routines_message" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addRoutineFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:contentDescription="@string/cd_add_routine"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
