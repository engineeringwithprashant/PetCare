<?xml version="1.0" encoding="utf-8"?>
<!-- Pet detail: one animal's photo card, what to know about them, and the care routines set up for them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.pet.PetDetailFragment">

    <!-- The shared header. Its android:id makes ViewBinding expose it as the nested binding `binding.header`. -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- clipToPadding="false" lets the last routine card scroll up through the bottom padding. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/screen_padding">

            <!-- ============================ Photo card ============================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pet_card_ground"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge"
                app:strokeWidth="0dp">

                <!-- A ConstraintLayout used as a stack: the photo. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- The photograph, and the view that now decides how tall this card is. -->
                    <ImageView
                        android:id="@+id/petPhotoImage"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_pet_photo_dark"
                        android:contentDescription="@string/cd_pet_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pet_placeholder"
                        app:layout_constraintDimensionRatio="@string/pet_photo_aspect_ratio"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- The dark gradient over the lower half of the photo. -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_pet_card_scrim"
                        app:layout_constraintBottom_toBottomOf="@id/petPhotoImage"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_percent="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/petPhotoImage"
                        app:layout_constraintVertical_bias="1.0" />

                    <!-- The round back button. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backButton"
                        style="@style/PetCare.PetDetail.BackButton"
                        android:layout_width="@dimen/pet_detail_back_button_touch_size"
                        android:layout_height="@dimen/pet_detail_back_button_touch_size"
                        android:layout_margin="@dimen/spacing_sm"
                        android:contentDescription="@string/cd_back"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- The species chip, top-right: small, upper-case, yellow. -->
                    <TextView
                        android:id="@+id/speciesChip"
                        style="@style/PetCare.SpeciesChip.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/card_padding"
                        app:layout_constraintBottom_toBottomOf="@id/backButton"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/backButton"
                        tools:text="Cat" />

                    <!-- The Mars or Venus symbol. -->
                    <ImageView
                        android:id="@+id/genderBadge"
                        style="@style/PetCare.PetDetail.GenderBadge"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/speciesChip"
                        app:layout_constraintEnd_toStartOf="@id/speciesChip"
                        app:layout_constraintTop_toTopOf="@id/speciesChip"
                        tools:src="@drawable/ic_gender_female"
                        tools:tint="@color/gender_female"
                        tools:visibility="visible" />

                    <!-- The pet's full name, large and bold, across the scrim. -->
                    <TextView
                        android:id="@+id/petNameText"
                        style="@style/PetCare.PetDetail.Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:accessibilityHeading="true"
                        app:layout_constraintBottom_toTopOf="@id/pillFlow"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:targetApi="p"
                        tools:text="Krishala Pant Thapa Baby" />

                    <!-- The three pills. They carry no constraints of their own: the Flow below positions them. -->
                    <TextView
                        android:id="@+id/agePill"
                        style="@style/PetCare.Pill.OnPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0 months old" />

                    <TextView
                        android:id="@+id/weightPill"
                        style="@style/PetCare.Pill.OnPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="25.0 kg" />

                    <TextView
                        android:id="@+id/statusPill"
                        style="@style/PetCare.Pill.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Nothing due today" />

                    <!-- Lays out the three pills in a row that wraps. -->
                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/pillFlow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/card_padding"
                        app:constraint_referenced_ids="agePill,weightPill,statusPill"
                        app:flow_horizontalBias="0"
                        app:flow_horizontalGap="@dimen/pill_spacing"
                        app:flow_horizontalStyle="packed"
                        app:flow_verticalGap="@dimen/pill_spacing"
                        app:flow_wrapMode="chain"
                        app:layout_constraintBottom_toBottomOf="@id/petPhotoImage"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================ Action row ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checklistButton"
                    style="@style/PetCare.PetDetail.ActionButton.Filled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pet_detail_checklist" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expensesButton"
                    style="@style/PetCare.PetDetail.ActionButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pet_detail_action_gap"
                    android:layout_weight="1"
                    android:text="@string/pet_detail_expenses" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editPetButton"
                    style="@style/PetCare.PetDetail.ActionButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pet_detail_action_gap"
                    android:layout_weight="1"
                    android:text="@string/pet_detail_edit" />

            </LinearLayout>

            <!-- ============================ About card ============================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aboutCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- The section label. accessibilityHeading so TalkBack can jump to the card. -->
                    <TextView
                        style="@style/PetCare.PetDetail.AboutLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/pet_detail_about_row_padding_vertical"
                        android:text="@string/pet_detail_about_title"
                        tools:targetApi="p" />

                    <View style="@style/PetCare.PetDetail.AboutDivider" />

                    <!-- One row: a horizontal LinearLayout with a fixed-width label and a value taking the rest. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/pet_detail_about_row_padding_vertical"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/pet_detail_about_row_padding_vertical">

                        <TextView
                            style="@style/PetCare.PetDetail.AboutLabel"
                            android:layout_width="@dimen/pet_detail_about_label_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/pet_detail_dob_label" />

                        <TextView
                            android:id="@+id/dobValueText"
                            style="@style/PetCare.PetDetail.AboutValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Sep 12, 2026" />
                    </LinearLayout>

                    <View style="@style/PetCare.PetDetail.AboutDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/pet_detail_about_row_padding_vertical"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/pet_detail_about_row_padding_vertical">

                        <TextView
                            style="@style/PetCare.PetDetail.AboutLabel"
                            android:layout_width="@dimen/pet_detail_about_label_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/pet_detail_dietary_label" />

                        <TextView
                            android:id="@+id/dietaryValueText"
                            style="@style/PetCare.PetDetail.AboutValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Two cups of dry food, morning and evening" />
                    </LinearLayout>

                    <View style="@style/PetCare.PetDetail.AboutDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/pet_detail_about_row_padding_vertical"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/pet_detail_about_row_padding_vertical">

                        <TextView
                            style="@style/PetCare.PetDetail.AboutLabel"
                            android:layout_width="@dimen/pet_detail_about_label_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/pet_detail_allergies_label" />

                        <TextView
                            android:id="@+id/allergiesValueText"
                            style="@style/PetCare.PetDetail.AboutValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="None recorded" />
                    </LinearLayout>

                    <View style="@style/PetCare.PetDetail.AboutDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/pet_detail_about_row_padding_vertical"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/pet_detail_about_row_padding_vertical">

                        <TextView
                            style="@style/PetCare.PetDetail.AboutLabel"
                            android:layout_width="@dimen/pet_detail_about_label_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/pet_detail_toys_label" />

                        <TextView
                            android:id="@+id/toysValueText"
                            style="@style/PetCare.PetDetail.AboutValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Banana leaf" />
                    </LinearLayout>

                    <View style="@style/PetCare.PetDetail.AboutDivider" />

                    <!-- The last row has no divider after it: the card's own bottom edge ends it. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/pet_detail_about_row_padding_vertical"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/card_padding">

                        <TextView
                            style="@style/PetCare.PetDetail.AboutLabel"
                            android:layout_width="@dimen/pet_detail_about_label_width"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/pet_detail_cared_for_by_label" />

                        <TextView
                            android:id="@+id/caredForByValueText"
                            style="@style/PetCare.PetDetail.AboutValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Prashant" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ====================== Vaccination history ====================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.NextUp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- The header row: the label takes all the leftover width (0dp + weight). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/vaccination_card_gutter"
                        android:paddingTop="@dimen/vaccination_header_padding_top"
                        android:paddingEnd="@dimen/vaccination_card_gutter"
                        android:paddingBottom="@dimen/vaccination_header_padding_bottom">

                        <TextView
                            style="@style/PetCare.Vaccination.CardLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/vaccination_card_title"
                            tools:targetApi="p" />

                        <!-- Opens the record screen for this pet. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addVaccinationButton"
                            style="@style/PetCare.Vaccination.AddPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/cd_add_vaccination"
                            android:text="@string/vaccination_add_record" />

                    </LinearLayout>

                    <!-- One row per record (item_vaccination.xml), newest given first. -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/vaccinationsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_vaccination" />

                    <!-- Shown in the list's place when there are no records. -->
                    <LinearLayout
                        android:id="@+id/emptyVaccinationsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View style="@style/PetCare.Vaccination.Divider" />

                        <TextView
                            style="@style/PetCare.Vaccination.Empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/vaccination_card_gutter"
                            android:paddingTop="@dimen/vaccination_empty_padding_vertical"
                            android:paddingEnd="@dimen/vaccination_card_gutter"
                            android:paddingBottom="@dimen/vaccination_empty_padding_vertical"
                            android:text="@string/vaccination_empty" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================== Care routines ========================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/PetCare.PetDetail.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/pet_detail_routines_title"
                    tools:targetApi="p" />

                <!-- Opens the new-routine form for this pet. It replaces the floating action button the screen used to have. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addRoutineButton"
                    style="@style/PetCare.PetDetail.AddRoutineButton"
                    android:layout_width="@dimen/pet_detail_add_routine_touch_size"
                    android:layout_height="@dimen/pet_detail_add_routine_touch_size"
                    android:contentDescription="@string/cd_add_routine" />

            </LinearLayout>

            <!-- One card per routine (item_routine.xml). Hidden by the fragment when there are none. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/routinesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_routine" />

            <!-- Shown in the list's place when the pet has no routines: an icon, a heading. -->
            <LinearLayout
                android:id="@+id/emptyRoutinesContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_routines" />

                <TextView
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_detail_no_routines_title" />

                <TextView
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_detail_no_routines_message" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
