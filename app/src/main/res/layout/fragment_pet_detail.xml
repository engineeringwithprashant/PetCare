<?xml version="1.0" encoding="utf-8"?>
<!--
    Pet detail: one animal's record, and the care routines set up for it.

    The screen reads top to bottom as an introduction to the pet: a large photo, then who it is, then
    three facts at a glance as pastel pills, then the things a sitter or a vet would need to be told.

    **Why the photo is the header rather than a thumbnail.** This is the only screen in the app
    about *one* animal, and the photo is how the user recognises that they are in the right place.
    Everywhere else the photo is a 64dp circle in a list, where its job is to distinguish one row
    from another; here its job is to be the subject.

    **Why the three pills are not just more rows in the card below.** Age, weight and species are
    the facts glanced at rather than read — and glanceable is exactly what a pill is and what a
    label-and-value row is not. The card beneath holds the things that have to be *read*: feeding
    instructions, allergies, what the animal likes to play with.

    The whole screen scrolls as one, so the routine list is a RecyclerView with wrap_content height
    and nestedScrollingEnabled="false" inside a NestedScrollView. That hands scrolling to the parent
    and lets the list render in full rather than becoming a small scrolling box inside a scrolling
    page. The trade-off is that every routine row is inflated at once instead of being recycled,
    which is fine for the handful of routines a pet realistically has.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pet.PetDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_padding_bottom_fab">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/content_top_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- ========================= Photo header =========================
                 A ShapeableImageView rather than an ImageView inside a rounded card: it clips the
                 bitmap itself to the rounded outline, where a card would leave the photo's square
                 corners painted over its own. The largest radius in the app's shape scale, because
                 this is the largest surface in the app. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/petPhotoImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pet_photo_height"
                android:background="@drawable/bg_photo_rounded"
                android:contentDescription="@string/cd_pet_photo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pet_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Large" />

            <!-- ========================= Name and breed =========================
                 The name appears here as well as in the app bar, and deliberately so: the bar's copy
                 is what identifies the screen once the photo has scrolled away, and this one is part
                 of the introduction the photo begins. -->
            <TextView
                android:id="@+id/petNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnBackground"
                tools:text="Bella" />

            <!-- Breed alone, since the species has a pill of its own directly below. Hidden by the
                 fragment when no breed was recorded, rather than leaving an empty line between the
                 name and the pills. -->
            <TextView
                android:id="@+id/petBreedText"
                style="@style/PetCare.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                tools:text="Labrador Retriever" />

            <!-- ========================= The stat pills =========================
                 Age, weight and species, each in its own pastel colour so the three are told apart
                 without reading them. A plain horizontal LinearLayout rather than a ChipGroup: these
                 are read, never tapped, and a chip would bring a touch target and a ripple that
                 invite a press that does nothing.

                 Each pill is hidden individually when its fact was never recorded — a rescue
                 animal's birthday is often genuinely unknown — so the row can end up holding one
                 pill, or three. -->
            <LinearLayout
                android:id="@+id/pillRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/agePill"
                    style="@style/PetCare.Pill.Mint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3 years old" />

                <TextView
                    android:id="@+id/weightPill"
                    style="@style/PetCare.Pill.Sky"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pill_spacing"
                    tools:text="24.5 kg" />

                <TextView
                    android:id="@+id/speciesPill"
                    style="@style/PetCare.Pill.Lilac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pill_spacing"
                    tools:text="Dog" />

            </LinearLayout>

            <!-- ======================= What to tell a sitter =======================
                 The recorded details, in one card. Each block is hidden by the fragment when its
                 field is empty, so a pet with only a name does not show a column of blank headings —
                 and the whole card goes when every block is empty, rather than rendering as an
                 empty white rectangle. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailsCard"
                style="@style/PetCare.Card.Feature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/PetCare.CardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_detail_about_title" />

                    <!-- Date of birth is kept here as well as being summarised by the age pill
                         above. The pill answers "how old is this animal?" at a glance; the exact
                         date is what a vet form asks for, and deriving it back from "3 years old"
                         is not possible. -->
                    <LinearLayout
                        android:id="@+id/dobBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_dob_label" />

                        <TextView
                            android:id="@+id/dobValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="4 Mar 2021" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dietaryBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_dietary_label" />

                        <TextView
                            android:id="@+id/dietaryValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Two cups of dry food, morning and evening" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/allergiesBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_allergies_label" />

                        <TextView
                            android:id="@+id/allergiesValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Chicken" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toysBlock"
                        style="@style/PetCare.DetailBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/PetCare.DetailLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pet_detail_toys_label" />

                        <TextView
                            android:id="@+id/toysValueText"
                            style="@style/PetCare.DetailValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Rope toy, tennis ball" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================ Actions ============================
                 One filled button and two outlined ones. The checklist is what a user opens this
                 screen for day to day, so it carries the yellow accent; three filled buttons in a
                 row would give no steer at all on which to reach for. -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checklistButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/pet_detail_checklist" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/expensesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/pet_detail_expenses" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editPetButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/pet_detail_edit" />

            <!-- ========================= Care routines ========================= -->

            <TextView
                style="@style/PetCare.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/pet_detail_routines_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/routinesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_routine" />

            <LinearLayout
                android:id="@+id/emptyRoutinesContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_routines" />

                <TextView
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_detail_no_routines_title" />

                <TextView
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pet_detail_no_routines_message" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addRoutineFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:contentDescription="@string/cd_add_routine"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
