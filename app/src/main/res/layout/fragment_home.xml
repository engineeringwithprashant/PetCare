<?xml version="1.0" encoding="utf-8"?>
<!--
    The dashboard — the screen the app opens on once signed in.

    It answers four questions in the order they are asked: *whose app is this and what mode am I in*
    (the header), *how is today going* (the care card), *who are my animals* (a card each), and
    *what might I want to do now* (the three quick actions).

    **Why this screen carries its own header.** Every other screen in the app takes its title from
    the MaterialToolbar in activity_main.xml. This one does not, and MainActivity hides that toolbar
    when the dashboard is shown. The reason is that three of the four things in this header depend on
    state a shared toolbar cannot reach: the theme toggle reflects the current display mode, the
    badge counts the user's pets, and both have to update as those change. The trade is that the
    account actions in the toolbar's overflow menu are not on screen here — so the badge doubles as
    the way into the profile screen, which carries its own sign-out button.

    **Why the header is outside the scrolling area.** It is the app's identity and its two controls,
    not content: scrolling them away would mean the theme toggle is only available at the top of the
    page. The greeting below it *is* content and scrolls with everything else.

    **Why a NestedScrollView with a list inside it.** The dashboard is a fixed set of short sections,
    not an unbounded feed: a greeting, one card, a handful of pets and three buttons. The pet list is
    given wrap_content height and nestedScrollingEnabled="false", which hands scrolling to the parent
    so the whole page moves as one rather than becoming a small scrolling box inside a scrolling
    page. The trade-off is that every pet card is inflated at once instead of being recycled — the
    right trade at these sizes, and the wrong one on the Expenses screen, where a spending history
    only ever grows. That screen is built the other way round for exactly that reason.

    All spacing comes from the shared scale in dimens.xml and all text from the roles in styles.xml,
    so this screen keeps step with every other one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <!-- ============================== Header ==============================
         Fixed above the scrolling page: the app mark and the screen's name on the left, the two
         controls on the right.

         Pulled in from view_tab_header.xml rather than declared here, because the Pets tab draws
         exactly the same row and the two must never drift apart — see the note in that file. The
         android:id is what makes ViewBinding expose it as a nested binding, `binding.header`. -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- ============================== The page ==============================
         Everything below the header scrolls as one. layout_height="0dp" with layout_weight="1"
         gives it all the room the header does not take.

         clipToPadding="false" lets content scroll *through* the bottom padding rather than being cut
         off at it, which is what makes the last card clear the navigation bar instead of finishing
         underneath it. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- ============================ Greeting ============================ -->

            <TextView
                android:id="@+id/welcomeText"
                style="@style/PetCare.Greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="Good evening,\nPrashant" />

            <!--
                How the Firestore backup is getting on.

                Sits directly under the greeting, in the app's secondary text colour and much
                smaller, because it is status rather than content: it should be findable when the
                user wonders about it and easy to ignore the rest of the time.

                Hidden entirely when there is nothing to report — visibility="gone" rather than
                "invisible", so the cards below move up to meet the greeting instead of leaving a gap
                where a message might have been.
            -->
            <TextView
                android:id="@+id/syncStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="@string/sync_status_syncing"
                tools:visibility="visible" />

            <!-- ================= Everything, when there are pets =================
                 This whole block is hidden as one when the user has no pets, and the empty state
                 below takes its place. Grouping it in a container means the fragment toggles one
                 visibility rather than five, and cannot leave a stray heading behind. -->
            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ========================= Today's care =========================
                     The day at a glance: a ring showing how much is done, and a sentence naming
                     what is next.

                     It replaced the checklist that used to sit here. A dashboard is read in a
                     glance on the way out of the door, and the question at that moment is "is there
                     anything left?", not "show me all of it" — the Tasks tab exists for the second
                     question and is where care is actually ticked off. -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/todayCard"
                    style="@style/PetCare.Card.Feature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:cardCornerRadius="@dimen/pet_card_corner_radius"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

                    <!-- The ring on the left, the words on the right. `gravity="center_vertical"`
                         keeps the two columns centred against each other whichever is taller — the
                         ring is a fixed size but the sentence beside it wraps to two lines for a
                         long task name.

                         baselineAligned="false" because the two children are blocks rather than
                         lines of text: aligning a progress ring's baseline to a heading's is
                         meaningless, and leaving it on costs an extra measure pass to work out a
                         baseline that is then ignored. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <!--
                            The progress ring, with the completed count inside it.

                            A FrameLayout because the two children are genuinely *stacked* — the
                            text sits on top of the middle of the ring — which is the one
                            arrangement a FrameLayout expresses better than anything else.

                            The ring is drawn by Material's determinate progress indicator rather
                            than by a custom View; see PetCare.CareRing in styles.xml.
                        -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/todayProgressRing"
                                style="@style/PetCare.CareRing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                tools:progress="20" />

                            <!-- The count and its "of 6". A column centred in the ring's hole.
                                 Marked as one accessibility unit by the fragment, which sets a
                                 description on this container so TalkBack reads "1 of 6 tasks done
                                 today" rather than the two numbers as unrelated fragments. -->
                            <LinearLayout
                                android:id="@+id/todayProgressLabels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/todayDoneCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textStyle="bold"
                                    tools:text="1" />

                                <TextView
                                    android:id="@+id/todayTotalCount"
                                    style="@style/PetCare.SectionLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="of 6" />

                            </LinearLayout>

                        </FrameLayout>

                        <!-- The words. Weighted so they take the rest of the row, which is what
                             lets a long task title wrap instead of pushing the ring off screen. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.SectionLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_today_title" />

                            <TextView
                                android:id="@+id/todayHeadlineText"
                                style="@style/PetCare.Headline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="5 things left for today" />

                            <TextView
                                android:id="@+id/todayNextUpText"
                                style="@style/PetCare.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:maxLines="2"
                                android:ellipsize="end"
                                tools:text="Next up: Morning meds for Bella" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ========================== Your pets ==========================
                     A quiet label with the count on the far right of the same line. Small and
                     letter-spaced rather than a full heading, because the cards below it are the
                     subject and a heavy heading would compete with them — see PetCare.SectionLabel.

                     baselineAligned keeps the label and the count sitting on the same line despite
                     being separate views. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PetCare.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_pets_title" />

                    <TextView
                        android:id="@+id/petsInCareText"
                        style="@style/PetCare.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        tools:text="2 in care" />

                </LinearLayout>

                <!-- The pet cards. The first pet is drawn large and the rest as shorter rows — two
                     layouts from one adapter, see PetSummaryAdapter for why the first is singled
                     out. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/petsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_pet_hero" />

                <!-- ======================== Quick actions ========================
                     The three things a user most often opens the app to do.

                     Equal widths through layout_weight="1" on zero-width children, which divides
                     the row into three regardless of how long each label is — the alternative,
                     wrap_content, would make "Log expense" a wider button than "Add pet" and leave
                     the row looking accidental.

                     Each tile's look comes from PetCare.QuickAction; the fragment attaches what
                     they do.

                     baselineAligned="false" for the same reason as the care card's row above: the
                     three children are tiles, not lines of text, so there is no baseline worth
                     aligning and measuring one is wasted work.

                     Each tile suppresses lint's UseCompoundDrawables suggestion. That advice —
                     collapse an ImageView and a TextView into one TextView with a drawableTop — is
                     usually right, but not here: the "+" has its own circular background, and a
                     compound drawable is painted as a bare glyph with no background of its own. The
                     two views are genuinely needed. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/actionAddTask"
                        style="@style/PetCare.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            style="@style/PetCare.QuickAction.Icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add" />

                        <TextView
                            style="@style/PetCare.QuickAction.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_add_task" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionLogExpense"
                        style="@style/PetCare.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            style="@style/PetCare.QuickAction.Icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add" />

                        <TextView
                            style="@style/PetCare.QuickAction.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_log_expense" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionAddPet"
                        style="@style/PetCare.QuickAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            style="@style/PetCare.QuickAction.Icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add" />

                        <TextView
                            style="@style/PetCare.QuickAction.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_add_pet" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!--
                Shown instead of the whole dashboard when the user has no pets.

                An icon, a sentence saying what to do next, and a button that does it — rather than a
                bare line of grey text. An empty screen with one short message leaves the user unsure
                whether there is nothing here or it simply has not loaded, and on the very first
                launch this is the only thing on the screen, so it has to carry the first action too.
            -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_placeholder" />

                <TextView
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_empty_title" />

                <TextView
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_empty_message" />

                <!-- The app's only filled button outside a form, and it is filled because on a
                     screen with nothing else on it there is no ambiguity to resolve — this is the
                     one thing to do, so it wears the yellow accent that means exactly that. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addFirstPetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/home_empty_action"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
