<?xml version="1.0" encoding="utf-8"?>
<!-- The Home tab — the dashboard the app opens on once signed in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <!-- ============================== Header ============================== -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <!-- ============================== The page ============================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/home_scroll_padding_top"
        android:paddingBottom="@dimen/home_scroll_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/home_screen_padding"
            android:paddingEnd="@dimen/home_screen_padding">

            <!-- ============================ Greeting ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- "Good evening, / Prashant" — two lines, built by the fragment. -->
                <TextView
                    android:id="@+id/greetingText"
                    style="@style/PetCare.Home.Greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    tools:targetApi="p"
                    tools:text="Good evening,\nPrashant" />

                <!-- The clock and date, right-aligned in their own column. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clockText"
                        style="@style/PetCare.Home.Clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="5:38 PM" />

                    <TextView
                        android:id="@+id/dateText"
                        style="@style/PetCare.Home.DateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        tools:text="Thu 11 Sep" />

                </LinearLayout>

            </LinearLayout>

            <!-- How the Firestore backup is getting on: a small coloured dot and a muted line. -->
            <LinearLayout
                android:id="@+id/syncRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- The dot: bg_dot is a white circle, tinted green / yellow / grey by the fragment. -->
                <View
                    android:id="@+id/syncDot"
                    android:layout_width="@dimen/sync_dot_size"
                    android:layout_height="@dimen/sync_dot_size"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/sync_dot_synced"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/syncStatusText"
                    style="@style/PetCare.Home.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    tools:text="All synced · 3 min ago" />

            </LinearLayout>

            <!-- ================= Everything, when there are pets ================= -->
            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/home_screen_padding_negative"
                android:layout_marginEnd="@dimen/home_screen_padding_negative"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/home_screen_padding"
                android:paddingEnd="@dimen/home_screen_padding">

                <!-- ========================== Stat cards ========================== -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_screen_padding_negative"
                    android:layout_marginTop="@dimen/home_section_gap"
                    android:layout_marginEnd="@dimen/home_screen_padding_negative"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/home_screen_padding"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/home_screen_padding"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:scrollbars="none">

                    <!-- Each <include> sets its own size and margin. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/statWalk"
                            layout="@layout/item_home_stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/statSpent"
                            layout="@layout/item_home_stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/home_stat_card_gap" />

                        <include
                            android:id="@+id/statVet"
                            layout="@layout/item_home_stat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/home_stat_card_gap" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- ========================== Next up ========================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nextUpCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_gap"
                    app:cardBackgroundColor="@color/next_up_card_ground"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.NextUp"
                    app:strokeWidth="0dp">

                    <!-- Ring on the left, words and button on the right. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/next_up_card_min_height"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/next_up_card_padding">

                        <!-- The countdown ring with its number stacked in the middle — a FrameLayout. -->
                        <FrameLayout
                            android:id="@+id/nextUpRingContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/nextUpRing"
                                style="@style/PetCare.Home.NextUpRing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                tools:max="120"
                                tools:progress="98" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:importantForAccessibility="noHideDescendants"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/nextUpMinutesText"
                                    style="@style/PetCare.Home.NextUpMinutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="22" />

                                <TextView
                                    android:id="@+id/nextUpRingCaption"
                                    style="@style/PetCare.Home.NextUpRingCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    tools:text="min away" />

                            </LinearLayout>

                        </FrameLayout>

                        <!-- The words. 0dp width with weight 1 is the LinearLayout spelling of "flex: 1, min-width: 0". -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/next_up_content_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Home.NextUpLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_next_up_label" />

                            <TextView
                                android:id="@+id/nextUpTitleText"
                                style="@style/PetCare.Home.NextUpTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                tools:text="Brush coat" />

                            <TextView
                                android:id="@+id/nextUpMetaText"
                                style="@style/PetCare.Home.NextUpMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                tools:text="Krishala · 6:00 PM · Slicker brush" />

                            <!-- Completes the task. Hidden by the fragment. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/markDoneButton"
                                style="@style/PetCare.Home.MarkDoneButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/home_mark_done" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ========================= Today's care ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/todayCard"
                    style="@style/PetCare.Card.Feature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_gap"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.NextUp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/home_today_card_padding">

                        <!-- The ring and the words beside it, centred against each other. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- The ring with "1 / OF 6" stacked in its middle. -->
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/todayProgressRing"
                                    style="@style/PetCare.CareRing"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    tools:progress="20" />

                                <!-- Announced as one sentence. -->
                                <LinearLayout
                                    android:id="@+id/todayProgressLabels"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/todayDoneCount"
                                        style="@style/PetCare.Home.RingCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:importantForAccessibility="no"
                                        tools:text="1" />

                                    <TextView
                                        android:id="@+id/todayTotalCount"
                                        style="@style/PetCare.Home.RingTotal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:importantForAccessibility="no"
                                        tools:text="of 6" />

                                </LinearLayout>

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/home_today_ring_spacing"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/PetCare.Home.SectionLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_today_title" />

                                <TextView
                                    android:id="@+id/todayHeadlineText"
                                    style="@style/PetCare.Home.TodayHeadline"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    tools:text="5 things left for today" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- The hairline between the day and the week. -->
                        <View
                            style="@style/PetCare.PetDetail.AboutDivider"
                            android:layout_marginTop="@dimen/home_today_block_gap" />

                        <!-- "CARE STREAK" on the left, "5 full days" pushed to the right by the label's weight. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/home_today_block_gap"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/PetCare.Home.SectionLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_streak_label" />

                            <TextView
                                android:id="@+id/streakCountText"
                                style="@style/PetCare.Home.StreakCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="5 full days" />

                        </LinearLayout>

                        <!-- The seven day boxes, oldest on the left and today on the right. -->
                        <LinearLayout
                            android:id="@+id/streakRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:layout_marginTop="11dp"
                            android:focusable="true"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/streakDay0"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/streakDay1"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/streak_day_gap"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/streakDay2"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/streak_day_gap"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/streakDay3"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/streak_day_gap"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/streakDay4"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/streak_day_gap"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/streakDay5"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/streak_day_gap"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/streakDay6"
                                layout="@layout/item_streak_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/streak_day_gap"
                                android:layout_weight="1" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ========================== Your pets ========================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_gap"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PetCare.Home.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_pets_title" />

                    <TextView
                        style="@style/PetCare.Home.SectionHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_pets_hint" />

                </LinearLayout>

                <!-- The pet cards, scrolling sideways, bled to the screen edges. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/petsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_screen_padding_negative"
                    android:layout_marginTop="11dp"
                    android:layout_marginEnd="@dimen/home_screen_padding_negative"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/home_screen_padding"
                    android:paddingEnd="@dimen/home_screen_padding"
                    tools:itemCount="3"
                    tools:layoutManager="LinearLayoutManager"
                    tools:listitem="@layout/item_home_pet"
                    tools:orientation="horizontal" />

                <!-- ========================== Insight ========================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/insightCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_gap"
                    app:cardBackgroundColor="@color/insight_card_ground"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <!-- The "AI" badge and "TODAY'S INSIGHT", centred on one line. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/PetCare.Home.InsightBadge"
                                android:text="@string/home_ai_pill" />

                            <TextView
                                style="@style/PetCare.Home.InsightLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_weight="1"
                                android:text="@string/home_insight_label" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/insightText"
                            style="@style/PetCare.Home.InsightText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_spacing"
                            tools:text="Ddjw has 3 of today's 5 open tasks — front-load his walk before the 6 PM brush so the evening is clear." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/askAssistantButton"
                            style="@style/PetCare.Home.InsightButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="@string/home_ask_assistant" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ===================== Coming up this week ===================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/comingUpCard"
                    style="@style/PetCare.Card.Feature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_spacing"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/spacing_xs">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal"
                            android:padding="@dimen/card_padding">

                            <TextView
                                style="@style/PetCare.SectionLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_coming_up_title" />

                            <TextView
                                android:id="@+id/comingUpCountText"
                                style="@style/PetCare.Home.SectionHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                tools:text="3 items" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/comingUpRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_coming_up" />

                        <!-- Shown instead of the rows when the week ahead is empty, so the card says. -->
                        <TextView
                            android:id="@+id/comingUpEmptyText"
                            style="@style/PetCare.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/card_padding"
                            android:paddingEnd="@dimen/card_padding"
                            android:paddingBottom="@dimen/spacing_md"
                            android:text="@string/home_coming_up_empty"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================== Quick actions ======================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_spacing"
                    android:baselineAligned="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/actionAddTask"
                        style="@style/PetCare.Home.QuickActionCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/home_stat_card_padding"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                style="@style/PetCare.QuickAction.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_add" />

                            <TextView
                                style="@style/PetCare.QuickAction.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/home_section_gap"
                                android:text="@string/home_action_add_task"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/actionLogExpense"
                        style="@style/PetCare.Home.QuickActionCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/home_stat_card_padding"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                style="@style/PetCare.QuickAction.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_add" />

                            <TextView
                                style="@style/PetCare.QuickAction.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/home_section_gap"
                                android:text="@string/home_action_log_expense"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/actionAddPet"
                        style="@style/PetCare.Home.QuickActionCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/home_stat_card_padding"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                style="@style/PetCare.QuickAction.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_add" />

                            <TextView
                                style="@style/PetCare.QuickAction.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/home_section_gap"
                                android:text="@string/home_action_add_pet"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Shown instead of the whole dashboard when the user has no pets: an icon. -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                style="@style/PetCare.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    style="@style/PetCare.EmptyStateIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pet_placeholder" />

                <TextView
                    style="@style/PetCare.EmptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_empty_title" />

                <TextView
                    style="@style/PetCare.EmptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_empty_message" />

                <!-- Filled, in the accent: on a screen with nothing else on it, this is the one thing to do. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addFirstPetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/home_section_gap"
                    android:text="@string/home_empty_action"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
