<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen: a greeting, a summary of today's care tasks, and the user's pets.

    The screen's title lives in the app bar, so the heading here is a greeting rather than a repeat
    of it.

    The root is a CoordinatorLayout because it is what lets the floating action button and any
    Snackbar cooperate — a Snackbar sliding up from the bottom lifts the button rather than covering
    it. Inside, one flat ConstraintLayout positions everything, which keeps measuring cheap.

    All spacing comes from the shared scale in dimens.xml and all text from the roles in styles.xml,
    so this screen keeps step with every other one.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Welcome, Alex" />

        <!--
            How the Firestore backup is getting on.

            Sits directly under the greeting, in the app's secondary text colour and one step down
            in size, because it is status rather than content: it should be findable when the user
            wonders about it and easy to ignore the rest of the time. Putting it above the care
            summary rather than beside the pet list keeps it out of the way of anything scrollable.

            Hidden entirely when there is nothing to report — visibility="gone" rather than
            "invisible", so the summary card below moves up to meet the greeting instead of leaving
            a gap where a message might have been.
        -->
        <TextView
            android:id="@+id/syncStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcomeText"
            tools:text="@string/sync_status_syncing"
            tools:visibility="visible" />

        <!-- Today's care summary. The Material 3 "filled" card reads as a distinct tinted surface,
             separating it from the plain background behind the list. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/todaySummaryCard"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/screen_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/syncStatusText">

            <TextView
                android:id="@+id/todaySummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/card_padding"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="2 of 5 tasks done today" />

        </com.google.android.material.card.MaterialCardView>

        <!--
            The pet list fills whatever height is left: layout_height="0dp" with the top pinned
            under the summary card and the bottom to the parent is how ConstraintLayout expresses
            "stretch to fit the remaining space".

            clipToPadding="false" with a large bottom padding lets the final card scroll clear of
            the floating action button instead of finishing underneath it, while still allowing
            items to be drawn through that padding as they scroll.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/petsRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/list_padding_bottom_fab"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/todaySummaryCard"
            tools:listitem="@layout/item_pet" />

        <!--
            Shown instead of the list when the user has no pets. It occupies the same region as the
            RecyclerView, and the fragment toggles which of the two is visible.

            An icon and a sentence saying what to do next, rather than a bare line of grey text —
            an empty screen with one short message leaves the user unsure whether there is nothing
            here or it simply has not loaded.
        -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            style="@style/PetCare.EmptyState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/petsRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/petsRecyclerView"
            tools:visibility="visible">

            <ImageView
                style="@style/PetCare.EmptyStateIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_pet_placeholder" />

            <TextView
                style="@style/PetCare.EmptyStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_title" />

            <TextView
                style="@style/PetCare.EmptyStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_message" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- The add-pet button. contentDescription is required on an icon-only control: without it
         TalkBack would announce nothing useful to a user who cannot see the plus symbol. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addPetFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:contentDescription="@string/cd_add_pet"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
