<?xml version="1.0" encoding="utf-8"?>
<!-- The header shared by the tabs and the pet detail screen: the app's monogram and the screen's name on the left. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/spacing_sm">

    <!-- The app's monogram: a "p" on a rounded yellow square, and the way in to the profile screen. -->
    <!-- Two layers, letter behind photo. The mark is the yellow "p" until the user sets a profile photo. -->
    <FrameLayout
        android:id="@+id/monogram"
        android:layout_width="@dimen/monogram_size"
        android:layout_height="@dimen/monogram_size"
        android:clickable="true"
        android:contentDescription="@string/cd_open_profile"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <!-- The fallback: a "p" on the rounded yellow square, from bg_monogram.xml. -->
        <TextView
            android:id="@+id/monogramLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_monogram"
            android:fontFamily="@font/bricolage_grotesque"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/home_monogram"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/on_accent_yellow"
            android:textStyle="bold" />

        <!-- The user's photo, drawn over the letter when there is one. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/monogramPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Monogram"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- The screen's name, set by the fragment ("Home", "Pets"). -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnBackground"
        android:textStyle="bold"
        tools:targetApi="p"
        tools:text="Pets" />

    <!-- The light/dark toggle. -->
    <LinearLayout
        android:id="@+id/themeToggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/header_control_height"
        android:background="@drawable/bg_header_control"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
            android:id="@+id/themeToggleIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_theme_light"
            app:tint="@color/accent_yellow" />

        <!-- "LIGHT" / "DARK": an upper-case micro-label, so IBM Plex Mono. -->
        <TextView
            android:id="@+id/themeToggleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_mono"
            android:layout_marginStart="@dimen/spacing_xs"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Light" />

    </LinearLayout>

    <!-- The "AI" pill. Hidden by default and shown by TabHeader.showAssistantPill(), which only Home. -->
    <TextView
        android:id="@+id/aiPill"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/header_control_height"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="@drawable/bg_header_control"
        android:clickable="true"
        android:contentDescription="@string/cd_open_assistant"
        android:focusable="true"
        android:fontFamily="@font/ibm_plex_mono"
        android:gravity="center"
        android:paddingStart="@dimen/header_ai_pill_padding_horizontal"
        android:paddingEnd="@dimen/header_ai_pill_padding_horizontal"
        android:text="@string/home_ai_pill"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- The notifications bell, with the number of unread alerts on its corner. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm">

        <!-- The bell itself, in the same rounded well and at the same height as the theme toggle and the AI pill. -->
        <ImageView
            android:id="@+id/notificationsBell"
            android:layout_width="@dimen/header_badge_size"
            android:layout_height="@dimen/header_badge_size"
            android:background="@drawable/bg_header_control"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/header_bell_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bell"
            app:tint="?attr/colorOnSurface" />

        <!-- How many alerts are unread: "3", or "9+" past that. -->
        <TextView
            android:id="@+id/alertCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/header_alert_count_size"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_alert_count"
            android:fontFamily="@font/ibm_plex_mono"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minWidth="@dimen/header_alert_count_size"
            android:paddingStart="@dimen/header_alert_count_padding_horizontal"
            android:paddingEnd="@dimen/header_alert_count_padding_horizontal"
            android:textColor="@color/on_nav_badge"
            android:textSize="@dimen/header_alert_count_text_size"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>
