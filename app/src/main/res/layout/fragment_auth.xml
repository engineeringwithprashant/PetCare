<?xml version="1.0" encoding="utf-8"?>
<!-- The log in / register screen (AuthFragment). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Auth.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.AuthFragment">

    <LinearLayout
        style="@style/PetCare.Auth.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Logo, name, tagline, and this mode's heading and subtitle. -->
        <include
            android:id="@+id/header"
            layout="@layout/view_auth_header" />

        <!-- Everything below the header, hidden as one block while sign-in is locked. -->
        <LinearLayout
            android:id="@+id/authContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_header_gap"
            android:orientation="vertical">

            <!-- ============================ Log in fields ============================ -->

            <LinearLayout
                android:id="@+id/loginForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- labelFor ties the label to its field, so TalkBack reads "Email or phone". -->
                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/identifierInput"
                    android:text="@string/login_identifier_label" />

                <!-- Accepts either an email or a phone number. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/identifierLayout"
                    style="@style/PetCare.Auth.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/identifierInput"
                        style="@style/PetCare.Auth.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress,phone"
                        android:hint="@string/login_identifier_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/loginPasswordInput"
                    android:text="@string/login_password_label" />

                <!-- endIconMode="password_toggle" puts the eye icon inside the right edge of the box. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/loginPasswordLayout"
                    style="@style/PetCare.Auth.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconContentDescription="@string/cd_toggle_password_visibility"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/loginPasswordInput"
                        style="@style/PetCare.Auth.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/PetCare.Auth.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:text="@string/login_password_helper" />

                <!-- The wrong-password warning. -->
                <include
                    android:id="@+id/loginAlert"
                    layout="@layout/view_auth_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:visibility="gone" />

                <!-- layout_gravity="end" right-aligns the link within the column. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgotPasswordButton"
                    style="@style/PetCare.Auth.TextLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginEnd="-8dp"
                    android:text="@string/login_forgot_password" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/PetCare.Auth.PrimaryButton"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/login_submit" />
            </LinearLayout>

            <!-- ============================ Register fields ============================ -->

            <LinearLayout
                android:id="@+id/registerForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/fullNameInput"
                    android:text="@string/register_full_name_label" />

                <!-- textPersonName|textCapWords capitalises each word as the name is typed. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fullNameLayout"
                    style="@style/PetCare.Auth.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullNameInput"
                        style="@style/PetCare.Auth.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:hint="@string/register_full_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/emailInput"
                    android:text="@string/register_email_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/PetCare.Auth.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        style="@style/PetCare.Auth.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:hint="@string/register_email_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/phoneInput"
                    android:text="@string/register_phone_label" />

                <!-- The phone number: a country selector and the local number beside it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Not typed into: tapping it opens the country list. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneCountryLayout"
                        style="@style/PetCare.Auth.Field"
                        android:layout_width="@dimen/phone_country_field_width"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneCountryInput"
                            style="@style/PetCare.Auth.FieldInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:text="🇳🇵 +977" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- inputType="phone" brings up the dial-pad keyboard. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneLayout"
                        style="@style/PetCare.Auth.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/phone_country_field_gap"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneInput"
                            style="@style/PetCare.Auth.FieldInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="phone"
                            android:hint="@string/register_phone_hint"
                            android:imeOptions="actionNext"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- A standalone helper line rather than TextInputLayout's helperText. -->
                <TextView
                    style="@style/PetCare.Auth.Helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_label_gap"
                    android:text="@string/register_phone_helper" />

                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/registerPasswordInput"
                    android:text="@string/register_password_label" />

                <!-- The "At least 8 characters" placeholder is set by AuthFragment from the same constant. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/registerPasswordLayout"
                    style="@style/PetCare.Auth.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconContentDescription="@string/cd_toggle_password_visibility"
                    app:endIconMode="password_toggle">

                    <!-- textPassword rather than textNewPassword. -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registerPasswordInput"
                        style="@style/PetCare.Auth.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        tools:hint="At least 8 characters" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- The six rules, ticking off live as the password is typed. -->
                <com.prash.petcare.ui.common.PasswordChecklistView
                    android:id="@+id/registerPasswordChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_label_gap" />

                <TextView
                    style="@style/PetCare.Auth.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/confirmPasswordInput"
                    android:text="@string/register_confirm_password_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordLayout"
                    style="@style/PetCare.Auth.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconContentDescription="@string/cd_toggle_password_visibility"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordInput"
                        style="@style/PetCare.Auth.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:hint="@string/register_confirm_password_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- The consent row: a checkbox and the sentence beside it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/consentCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:contentDescription="@string/register_consent"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <TextView
                        android:id="@+id/consentText"
                        style="@style/PetCare.Auth.Consent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        tools:text="@string/register_consent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/consentError"
                    style="@style/PetCare.Auth.ErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone"
                    tools:text="@string/error_consent_required"
                    tools:visibility="visible" />

                <!-- A clear gap above the button. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    style="@style/PetCare.Auth.PrimaryButton"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/register_submit" />
            </LinearLayout>

            <!-- Shown only while a sign-in or sign-up is being checked. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="2dp" />

            <!-- ============================ Shared footer ============================ -->

            <!-- "—— OR ——": two weighted hairlines with the label between them. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View style="@style/PetCare.Auth.DividerLine" />

                <TextView
                    style="@style/PetCare.Auth.DividerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_or" />

                <View style="@style/PetCare.Auth.DividerLine" />
            </LinearLayout>

            <!-- "Continue with Google". -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleButton"
                style="@style/PetCare.Auth.GoogleButton"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/auth_continue_with_google" />

            <!-- The way to the other form, at the very foot of the page: "New to PetCare? -->
            <TextView
                android:id="@+id/switchFormText"
                style="@style/PetCare.Auth.SwitchFormText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                tools:text="@string/login_register_prompt" />

        </LinearLayout>

        <!-- The locked screen, in place of everything above. Starts GONE and takes no space. -->
        <include
            android:id="@+id/lockedPanel"
            layout="@layout/view_auth_locked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
