<?xml version="1.0" encoding="utf-8"?>
<!-- The dark total card at the top of the Money tab: "TOTAL SPENT · SEPTEMBER". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/total_card_ground"
    app:cardElevation="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/totalLabelText"
            style="@style/PetCare.Expenses.TotalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Total spent · September" />

        <!-- The total. Its paise are shrunk with a span in ExpenseAdapter. -->
        <TextView
            android:id="@+id/totalAmountText"
            style="@style/PetCare.Expenses.TotalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            tools:text="Rs 5,240.00" />

        <!-- The stacked bar: a custom drawing, one coloured segment per category. -->
        <com.prash.petcare.ui.expense.CategoryBarView
            android:id="@+id/categoryBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/expenses_category_bar_height"
            android:layout_marginTop="@dimen/spacing_lg" />

        <TextView
            android:id="@+id/totalCaptionText"
            style="@style/PetCare.Expenses.TotalCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:maxLines="2"
            tools:text="3 expenses · 2 pets · +12% vs August" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
