<?xml version="1.0" encoding="utf-8"?>
<!-- The single Activity layout for the whole app: a top app bar, the window every screen is swapped. -->
<!-- The outermost frame exists for one thing: the opening video has to be able to cover everything. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<LinearLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- AppBarLayout provides the elevation and surface treatment Material 3 expects behind a top app bar. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- No app:menu here, deliberately. MainActivity makes this toolbar the Activity's action bar. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- The screen area, and the navigation bar floating over the bottom of it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The NavHostFragment: the window the Navigation Component swaps screens into. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

        <!-- The bottom navigation bar: the app's five top-level destinations. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNav"
            style="@style/PetCare.NavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/nav_bar_margin_horizontal"
            android:layout_marginEnd="@dimen/nav_bar_margin_horizontal"
            android:layout_marginBottom="@dimen/nav_bar_margin_bottom">

            <com.prash.petcare.ui.common.FloatingNavBar
                android:id="@+id/navTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>

    <!-- The opening animation: res/raw/splash_animation.mp4, played once over the app while it starts. -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_ground"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="no">

        <TextureView
            android:id="@+id/splashVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</FrameLayout>
