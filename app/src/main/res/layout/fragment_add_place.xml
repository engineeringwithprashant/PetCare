<?xml version="1.0" encoding="utf-8"?>
<!-- "Add a place": the sub-screen reached from "+ ADD PLACE" in the Places tab's saved-places heading. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.place.AddPlaceFragment">

    <!-- The header takes the height it needs; the page takes the rest through height 0 + weight 1. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The shared header, as a nested binding (`binding.header`). -->
        <include
            android:id="@+id/header"
            layout="@layout/view_tab_header" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/addPlaceScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/add_place_scroll_padding_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <!-- ============================== Heading ============================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backButton"
                        style="@style/PetCare.AddPlace.BackButton"
                        android:contentDescription="@string/cd_add_place_back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- accessibilityHeading marks this as the page's heading. -->
                        <TextView
                            style="@style/PetCare.AddPlace.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/add_place_heading"
                            tools:targetApi="p" />

                        <!-- The moment the screen is for, in one line. -->
                        <TextView
                            style="@style/PetCare.AddPlace.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/add_place_subtitle_gap"
                            android:text="@string/add_place_subheading" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ========================== The location picker ========================== -->
                <com.prash.petcare.ui.place.LocationPickerView
                    android:id="@+id/locationPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md" />

                <!-- The one line that says the map is a control rather than a picture. -->
                <TextView
                    android:id="@+id/mapHintText"
                    style="@style/PetCare.AddPlace.MapHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/map_picker_hint" />

                <!-- What the pin is pointing at, in words and figures. -->
                <include
                    android:id="@+id/selectedLocation"
                    layout="@layout/view_selected_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md" />

                <!-- ============================ The save fields ============================ -->

                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_place_name_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PetCare.AddPlace.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- capWords because a place name is a proper noun. -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        style="@style/PetCare.AddPlace.NameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/add_place_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_place_category_label" />

                <!-- Vet · Grooming · Park · Store. The Tasks tab's filter chips, built in code from PlaceCategory. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/spacing_sm"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <!-- The address. Filled in from the map's own lookup and editable afterwards. -->
                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/place_area_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PetCare.AddPlace.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/areaInput"
                        style="@style/PetCare.AddPlace.NoteInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/add_place_area_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPostalAddress|textCapWords"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- The place's number: a country selector and the local number beside. -->
                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/place_phone_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Not typed into: tapping it opens the country list. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneCountryLayout"
                        style="@style/PetCare.AddPlace.Field"
                        android:layout_width="@dimen/phone_country_field_width"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneCountryInput"
                            style="@style/PetCare.AddPlace.NoteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="1"
                            tools:text="🇳🇵 +977" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- inputType="phone" brings up the dial pad; PhoneNumberInput caps the digits per country. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneInputLayout"
                        style="@style/PetCare.AddPlace.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/phone_country_field_gap"
                        android:layout_weight="1"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneInput"
                            style="@style/PetCare.AddPlace.NoteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/add_place_phone_hint"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- ============================ Opening hours ============================ -->
                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/place_hours_heading" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/PetCare.AddPlace.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/openingTimeInput"
                            style="@style/PetCare.AddPlace.NoteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="true"
                            android:hint="@string/place_opening_label"
                            android:inputType="none"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/PetCare.AddPlace.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/closingTimeInput"
                            style="@style/PetCare.AddPlace.NoteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="true"
                            android:hint="@string/place_closing_label"
                            android:inputType="none"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- One error for the pair rather than one per field, because the problem. -->
                <TextView
                    android:id="@+id/hoursErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- For places with no opening hours, such as a public park. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearHoursButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/place_clear_hours"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_place_note_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PetCare.AddPlace.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- imeOptions actionDone, since this is the last field on the form. -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteInput"
                        style="@style/PetCare.AddPlace.NoteInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/add_place_note_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ============================ Summary and save ============================ -->
                <TextView
                    android:id="@+id/summaryText"
                    style="@style/PetCare.AddPlace.Summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:accessibilityLiveRegion="polite"
                    tools:text="Untitled place · Vet\nNo location chosen yet" />

                <!-- Disabled until the place has both a name and a location. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/savePlaceButton"
                    style="@style/PetCare.AddPlace.SaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    tools:text="@string/add_place_save" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
