<?xml version="1.0" encoding="utf-8"?>
<!--
    "Add a place": the sub-screen reached from "+ ADD PLACE" in the Places tab's saved-places heading.

    **What the screen is for.** Saving a vet, groomer, park or shop *from anywhere*. Standing at the
    place is one of three equally good ways to fix its position, never a requirement — see the note on
    the method picker below.

    Top to bottom:
      - **The shared header** (monogram, "Add place", theme toggle, pet count), fixed above the page as
        on the tabs. It is what keeps this screen recognisably part of the Places tab while the bottom
        bar keeps that tab lit.
      - Everything else scrolls as one page:
          · the **heading block** — a round back button beside "Add a place" and the sentence that
            states the rule the screen is built on;
          · the **method picker** — Search · Drop pin · I'm here, three peers in one groove;
          · **one of three method panels**, only ever one of them visible;
          · the **save fields** — name, category, note — which are identical whichever method was used;
          · the **summary** of what will be saved and where its position came from, then "SAVE PLACE".

    **Why the three panels are all declared here and hidden, rather than being three fragments or a
    ViewPager.** They share every field below them and the same ViewModel, and switching between them
    must lose nothing — a query typed, a pin dragged and a fix taken all have to survive being looked
    away from. Three sibling views whose visibility is toggled is the arrangement that gives that for
    free; anything that recreated a panel would have to save and restore its state to stand still.

    **Why one NestedScrollView with the results list inside it**, rather than a RecyclerView for the
    whole page: the same reasoning as fragment_places.xml. The panels and fields are a handful of
    stateful views rather than rows, and the result list is short and bounded, so it is wrap_content
    with nested scrolling off and the page does all the scrolling.

    **Why a CoordinatorLayout at the root:** so Snackbars attach here and appear above the floating
    bottom navigation bar rather than underneath it — see fragment_places.xml.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.place.AddPlaceFragment">

    <!-- The header takes the height it needs; the page takes the rest through height 0 + weight 1. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The shared header, as a nested binding (`binding.header`). -->
        <include
            android:id="@+id/header"
            layout="@layout/view_tab_header" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/addPlaceScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/add_place_scroll_padding_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <!-- ============================== Heading ==============================
                     The round back button and the text block beside it. gravity top rather than
                     centre, so the button lines up with the *first* line of a heading that wraps
                     rather than drifting down beside a two-line block. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backButton"
                        style="@style/PetCare.AddPlace.BackButton"
                        android:contentDescription="@string/cd_add_place_back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- accessibilityHeading marks this as the page's heading, so TalkBack users
                             can jump straight to it with heading navigation. -->
                        <TextView
                            style="@style/PetCare.AddPlace.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/add_place_heading"
                            tools:targetApi="p" />

                        <!-- The rule the whole screen exists to keep. -->
                        <TextView
                            style="@style/PetCare.AddPlace.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/add_place_subtitle_gap"
                            android:text="@string/add_place_subheading" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ============================ Method picker ============================
                     Three ways to fix a place's position, and they are **peers**: Search and Drop pin
                     need no permission at all, and "I'm here" is a convenience rather than the proper
                     way. None of the three is ever disabled, so refusing location access narrows
                     nothing — which is the whole point of the feature.

                     The profile screen's preference toggle with a third segment: a groove with a
                     strong-filled pill in the chosen one, driven entirely by `state_selected` through
                     bg_profile_segment.xml. Each segment takes a third of the width through
                     weight 1 on a zero width, which is this layout's equivalent of the design's
                     `flex: 1`. -->
                <LinearLayout
                    android:id="@+id/methodTrack"
                    style="@style/PetCare.AddPlace.MethodTrack"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/methodSearch"
                        style="@style/PetCare.AddPlace.Method"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/add_place_method_search" />

                    <TextView
                        android:id="@+id/methodPin"
                        style="@style/PetCare.AddPlace.Method"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/add_place_method_pin" />

                    <TextView
                        android:id="@+id/methodHere"
                        style="@style/PetCare.AddPlace.Method"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/add_place_method_here" />

                </LinearLayout>

                <!-- ======================= Method 1 — search by name or address =======================
                     The position saved with a chosen result is the one that came back *with* the
                     result, from the places lookup — see PlaceSearchRepository. Nothing here reads the
                     device, which is what lets a user in another country save a clinic in Lalitpur. -->
                <LinearLayout
                    android:id="@+id/searchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PetCare.AddPlace.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_place_search_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/PetCare.AddPlace.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- imeOptions actionSearch so the keyboard's action key says "Search"; the
                             results are filtered live on every keystroke, so pressing it only closes
                             the keyboard. inputType text with no flags: a place name is not a
                             sentence, so neither auto-capitalisation nor autocorrect helps. -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/searchInput"
                            style="@style/PetCare.AddPlace.NoteInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/add_place_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- The matches. wrap_content with nested scrolling off, so the page scrolls
                         rather than the list — see the note at the top of this file. -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/suggestionsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_place_suggestion" />

                    <!-- Shown in the list's place when a query matches nothing. It names the way out —
                         switch to Drop pin — rather than only reporting the failure, because the place
                         the user is looking for may simply not be in any directory. -->
                    <TextView
                        android:id="@+id/noResultsText"
                        style="@style/PetCare.AddPlace.NoResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/add_place_no_results"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- ========================= Method 2 — drop or drag a pin =========================
                     The marker's position on the map is projected onto the visible bounding box to
                     give a latitude and longitude — see util/PinMapProjection.kt. Again nothing reads
                     the device: the blue dot is where the map is *centred*, not where the phone is. -->
                <LinearLayout
                    android:id="@+id/pinPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <!-- The map. Its ground, grid and blue dot are painted by the view itself; the two
                         children below are laid over them. See PinMapView. -->
                    <com.prash.petcare.ui.place.PinMapView
                        android:id="@+id/pinMap"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pin_map_height"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:contentDescription="@string/cd_add_place_map"
                        android:elevation="@dimen/card_elevation">

                        <!--
                            The draggable marker: a name label, a stem, and the dot that marks the
                            point. A vertical column whose *bottom centre* is placed on the coordinate
                            — PinMapView does that offset, see positionMarker().

                            layout_gravity top|start puts it at the view's origin before that offset is
                            applied; without it a FrameLayout would centre the child and the
                            translation would start from the wrong place.

                            Not clickable: the whole map takes the touch, because the marker is a few
                            millimetres wide and the thing being aimed at is the ground under it.
                            Hidden from TalkBack, since the map itself carries the description.
                        -->
                        <LinearLayout
                            android:id="@+id/pinMarker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:gravity="center_horizontal"
                            android:importantForAccessibility="no"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/pinLabel"
                                style="@style/PetCare.AddPlace.PinLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="New place" />

                            <View
                                android:layout_width="@dimen/pin_marker_stem_width"
                                android:layout_height="@dimen/pin_marker_stem_height"
                                android:background="@color/accent_yellow" />

                            <View
                                android:layout_width="@dimen/pin_marker_dot_size"
                                android:layout_height="@dimen/pin_marker_dot_size"
                                android:background="@drawable/bg_pin_marker_dot" />

                        </LinearLayout>

                        <!-- "TAP OR DRAG TO MOVE", over the map's bottom-left corner. Hidden from
                             TalkBack because the map's own description already says it — a screen
                             reader would otherwise hear the instruction twice. -->
                        <TextView
                            style="@style/PetCare.AddPlace.PinHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="@dimen/pin_map_hint_inset"
                            android:importantForAccessibility="no"
                            android:text="@string/add_place_pin_hint" />

                    </com.prash.petcare.ui.place.PinMapView>

                    <!-- The live readout: the coordinates in a pale capsule, and the distance from the
                         map's home dot beside it. Both update on every frame of a drag, which is how
                         the user aims. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pinCoordinatesText"
                            style="@style/PetCare.AddPlace.Coordinates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="27.6714° N, 85.3181° E" />

                        <TextView
                            android:id="@+id/pinDistanceText"
                            style="@style/PetCare.AddPlace.PinDistance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            tools:text="1.1 km from home" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ====================== Method 3 — the device's current location ======================
                     The **only** method that reads the GPS, and the only one that can come up empty.
                     When it does — permission refused, or no fix — the card says so and the other two
                     methods are untouched. Nothing on this screen is disabled by that.

                     A dark card in both themes, like the Places tab's distance strip: it is one strong
                     statement rather than a field, and a white card would make it look like one. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/herePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/gps_card_ground"
                    app:cardCornerRadius="@dimen/gps_card_corner_radius"
                    app:cardElevation="0dp"
                    tools:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/gps_card_padding">

                        <!-- The blue dot in its tinted well — the "you are here" mark, drawn the same
                             way here as on the map. A FrameLayout because the dot is genuinely
                             *centred on* the well rather than beside it. -->
                        <FrameLayout
                            android:layout_width="@dimen/gps_card_dot_well_size"
                            android:layout_height="@dimen/gps_card_dot_well_size"
                            android:background="@drawable/bg_gps_dot_well">

                            <View
                                android:layout_width="@dimen/gps_card_dot_size"
                                android:layout_height="@dimen/gps_card_dot_size"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_gps_dot" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.AddPlace.HereLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/add_place_here_label" />

                            <!-- The area the fix falls in, in words — "Jhamsikhel, Lalitpur". Resolved
                                 by reverse geocoding, because a pair of coordinates is not something a
                                 person can check before saving. -->
                            <TextView
                                android:id="@+id/hereAreaText"
                                style="@style/PetCare.AddPlace.HereArea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Jhamsikhel, Lalitpur" />

                            <!-- The coordinates and how accurate the device claims to be. The accuracy
                                 is shown rather than hidden: it is what lets somebody decide whether
                                 to save this fix or step outside first. -->
                            <TextView
                                android:id="@+id/hereCoordinatesText"
                                style="@style/PetCare.AddPlace.HereCoordinates"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                tools:text="27.6743° N, 85.3094° E · ±8 m accuracy" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ========================= The shared save fields =========================
                     Identical whichever method fixed the position, which is what makes the three
                     genuinely interchangeable: the user learns one form and chooses how to point at
                     the place, rather than learning three flows. -->

                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_place_name_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PetCare.AddPlace.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Filled by tapping a search result, and editable afterwards — the result is a
                         starting point, not a lock. capWords because a place name is a proper noun. -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        style="@style/PetCare.AddPlace.NameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/add_place_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_place_category_label" />

                <!-- Vet · Grooming · Park · Store. The Tasks tab's filter chips, built in code from
                     PlaceCategory — see ui/common/FilterChips.kt — so the chosen pill gets exactly the
                     treatment the method picker's chosen segment does. A wrapping ChipGroup rather
                     than a scrolling row: four short pills fit two-and-two on the narrowest phone, and
                     a category hidden off the edge of a scroller is one that never gets chosen. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/spacing_sm"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    style="@style/PetCare.AddPlace.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_place_note_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PetCare.AddPlace.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- imeOptions actionDone, since this is the last field on the form. -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteInput"
                        style="@style/PetCare.AddPlace.NoteInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/add_place_note_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ============================ Summary and save ============================
                     Two lines: what is about to be saved, and where its position came from. The second
                     line is the screen's honesty about itself — "Found by search", "Pinned at …",
                     "Current location · …" — so the user knows which of the three answers is being
                     stored before they commit to it.

                     accessibilityLiveRegion polite: it changes as the form is filled in, and a screen
                     reader should mention the change without interrupting what is being typed. -->
                <TextView
                    android:id="@+id/summaryText"
                    style="@style/PetCare.AddPlace.Summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:accessibilityLiveRegion="polite"
                    tools:text="Untitled place — Vet\nPick a search result or type a name" />

                <!-- Disabled until the place has a name. Disabled here means a solid resting slab with
                     pale ink, not a faded button — see attrs.xml, colorDisabledContainer. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/savePlaceButton"
                    style="@style/PetCare.AddPlace.SaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/add_place_save" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
