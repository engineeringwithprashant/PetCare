<?xml version="1.0" encoding="utf-8"?>
<!--
    Add / edit pet form.

    One layout serves both modes. The fragment changes the title and shows or hides the delete
    button; every field is otherwise identical, so a second near-duplicate layout would only be
    another file to keep in step.

    The form is long, so the whole thing sits in a ScrollView — without it the lower fields would
    be unreachable once the keyboard appears.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.pet.AddEditPetFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!--
            Photo preview.

            A ShapeableImageView rather than an ImageView inside a rounded card: it clips the bitmap
            itself to the rounded outline, where a card would leave the photo's square corners
            painted over its own. The same treatment the pet detail screen's header gets, one step
            shorter, because here the photo is an input rather than the subject of the screen.
        -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/petPhotoImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pet_photo_form_height"
            android:background="@drawable/bg_photo_rounded"
            android:contentDescription="@string/cd_pet_photo"
            android:padding="@dimen/spacing_lg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pet_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/choosePhotoButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/pet_photo_choose" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_name_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Species picker. The ExposedDropdownMenu style turns a text field into a Material 3
            dropdown, and MaterialAutoCompleteTextView supplies the popup list.

            inputType="none" makes the field un-typeable, so the only way to change it is by
            choosing one of the fixed options — the value has to map back to a PetSpecies enum
            constant, which free text could not guarantee.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/speciesInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_species_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/speciesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Gender picker: Male, Female or Unknown.

            A MaterialButtonToggleGroup rather than a third dropdown like species. There are only
            three choices, and all of them fit on one line, so showing them side by side lets the
            user see and change the answer with a single tap instead of opening a menu to find out
            what the options are.

            singleSelection="true" makes the group behave like radio buttons — choosing one clears
            the others — and selectionRequired="true" stops the user tapping the highlighted option
            off and leaving nothing chosen. Together they guarantee the value always maps to exactly
            one PetGender constant. "Unknown" is a real option rather than "nothing selected" for
            the same reason: see PetGender.UNKNOWN.

            The small heading above it takes the place of the floating hint the text fields have,
            which a button group has no slot for.
        -->
        <TextView
            style="@style/PetCare.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/pet_gender_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/genderToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <!-- Equal thirds via layout_weight, so the three options are the same size whatever
                 the length of each word in a given language. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/genderMaleButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gender_male" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/genderFemaleButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gender_female" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/genderUnknownButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gender_unknown" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/breedInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_breed_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breedInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Date of birth. focusable="false" stops the keyboard appearing and stops the user typing
            a date the app would then have to parse; the field is a button in disguise, and tapping
            it opens the Material date picker.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dateOfBirthInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_dob_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dateOfBirthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:inputType="none"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- numberDecimal gives a numeric keypad with a decimal point and blocks letters, so the
             value the ViewModel parses is far less likely to be malformed. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/weightInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_weight_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/weightInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- The three free-text care fields. inputType="textMultiLine" with minLines gives room
             for more than one line, since these are notes rather than short values. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dietaryNotesInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_dietary_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dietaryNotesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/allergiesInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_allergies_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/allergiesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/favouriteToysInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/pet_toys_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/favouriteToysInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/pet_save" />

        <!-- Only shown in edit mode. Coloured with the theme's error role, the Material 3 signal
             for a destructive action, so it reads differently from the save button above. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/pet_delete"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:strokeColor="?attr/colorError"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
