<?xml version="1.0" encoding="utf-8"?>
<!-- "Record a vaccination": the sub-screen reached from "+ RECORD" on a pet's vaccination card. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pet.AddVaccinationFragment">

    <!-- The header takes the height it needs; the page takes the rest through height 0 + weight 1. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The shared header, as a nested binding (`binding.header`). -->
        <include
            android:id="@+id/header"
            layout="@layout/view_tab_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/record_scroll_padding_bottom">

            <!-- One column, every block the same distance from the last, so the form reads as an even stack. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ============================== Heading ============================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingEnd="@dimen/screen_padding">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backButton"
                        style="@style/PetCare.Record.BackButton"
                        android:contentDescription="@string/cd_record_vaccination_back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- accessibilityHeading marks this as the page's heading. -->
                        <TextView
                            style="@style/PetCare.Record.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/record_vaccination_heading"
                            tools:targetApi="p" />

                        <!-- "for Krishala Pant Thapa Baby" — filled in by the fragment once the pet loads. -->
                        <TextView
                            android:id="@+id/petNameText"
                            style="@style/PetCare.Record.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            tools:text="for Krishala Pant Thapa Baby" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ============================ Preset chips ============================ -->
                <HorizontalScrollView
                    android:id="@+id/presetChipScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/record_block_gap"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingEnd="@dimen/screen_padding"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/presetChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/record_chip_gap"
                        app:singleLine="true"
                        app:singleSelection="true" />

                </HorizontalScrollView>

                <!-- ========================== The rest of the form ========================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingEnd="@dimen/screen_padding">

                    <!-- ~~~~~~~~~~ Vaccine ~~~~~~~~~~ -->
                    <TextView
                        style="@style/PetCare.Record.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        android:text="@string/record_vaccine_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/vaccineInputLayout"
                        style="@style/PetCare.Record.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/vaccineInput"
                            style="@style/PetCare.Record.VaccineInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/record_vaccine_hint"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ~~~~~~~~~~ The two dates ~~~~~~~~~~ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Record.FieldLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/record_date_given_label" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/PetCare.Record.DateField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <!-- focusable and clickable but not editable: it can be reached by keyboard. -->
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/dateGivenInput"
                                    style="@style/PetCare.Record.DateInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="true"
                                    android:inputType="none"
                                    tools:text="23 Sep 2026" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/record_date_column_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Record.FieldLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/record_next_due_label" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/PetCare.Record.DateField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/dateDueInput"
                                    style="@style/PetCare.Record.DateInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="true"
                                    android:inputType="none"
                                    tools:text="23 Sep 2027" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ~~~~~~~~~~ Repeats every ~~~~~~~~~~ -->
                    <TextView
                        style="@style/PetCare.Record.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        android:text="@string/record_repeat_label" />

                    <LinearLayout
                        android:id="@+id/repeatTrack"
                        style="@style/PetCare.Record.RepeatTrack"
                        android:layout_width="match_parent">

                        <TextView
                            android:id="@+id/repeatSixMonths"
                            style="@style/PetCare.Record.RepeatSegment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/record_repeat_6_months" />

                        <TextView
                            android:id="@+id/repeatOneYear"
                            style="@style/PetCare.Record.RepeatSegment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/record_repeat_1_year" />

                        <TextView
                            android:id="@+id/repeatThreeYears"
                            style="@style/PetCare.Record.RepeatSegment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/record_repeat_3_years" />

                        <TextView
                            android:id="@+id/repeatOnce"
                            style="@style/PetCare.Record.RepeatSegment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/record_repeat_once" />

                    </LinearLayout>

                    <!-- ~~~~~~~~~~ Clinic ~~~~~~~~~~ -->
                    <TextView
                        style="@style/PetCare.Record.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        android:text="@string/record_clinic_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/PetCare.Record.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clinicInput"
                            style="@style/PetCare.Record.ClinicInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/record_clinic_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ~~~~~~~~~~ The checklist toggle ~~~~~~~~~~ -->
                    <LinearLayout
                        android:id="@+id/checklistToggleRow"
                        style="@style/PetCare.Record.ToggleRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        android:baselineAligned="false"
                        android:contentDescription="@string/cd_record_checklist_toggle">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/record_toggle_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="vertical">

                            <TextView
                                style="@style/PetCare.Record.ToggleTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/record_checklist_title" />

                            <TextView
                                style="@style/PetCare.Record.ToggleMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/record_checklist_meta" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/checklistSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no"
                            app:thumbTint="@color/record_switch_thumb"
                            app:trackTint="@color/record_switch_track" />

                    </LinearLayout>

                    <!-- ~~~~~~~~~~ Summary ~~~~~~~~~~ -->
                    <TextView
                        android:id="@+id/summaryText"
                        style="@style/PetCare.Record.Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        tools:text="Rabies — Krishala\nGiven 23 Sep 2026 · next due 23 Sep 2027" />

                    <!-- ~~~~~~~~~~ Save ~~~~~~~~~~ -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveRecordButton"
                        style="@style/PetCare.Record.SaveButton"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/record_block_gap"
                        android:text="@string/record_save" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
