<?xml version="1.0" encoding="utf-8"?>
<!-- The contents of CodeKeypadView (ui/auth/CodeKeypadView.kt): six code boxes, an error line. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <!-- The six boxes, as one horizontal ConstraintLayout chain. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/codeBoxes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:importantForAccessibility="yes">

        <TextView
            android:id="@+id/box1"
            style="@style/PetCare.Auth.CodeBox"
            app:layout_constraintDimensionRatio="H,11:12"
            app:layout_constraintEnd_toStartOf="@id/box2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="4" />

        <TextView
            android:id="@+id/box2"
            style="@style/PetCare.Auth.CodeBox"
            android:layout_marginStart="@dimen/auth_code_box_gap"
            app:layout_constraintDimensionRatio="H,11:12"
            app:layout_constraintEnd_toStartOf="@id/box3"
            app:layout_constraintStart_toEndOf="@id/box1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/box3"
            style="@style/PetCare.Auth.CodeBox"
            android:layout_marginStart="@dimen/auth_code_box_gap"
            app:layout_constraintDimensionRatio="H,11:12"
            app:layout_constraintEnd_toStartOf="@id/box4"
            app:layout_constraintStart_toEndOf="@id/box2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/box4"
            style="@style/PetCare.Auth.CodeBox"
            android:layout_marginStart="@dimen/auth_code_box_gap"
            app:layout_constraintDimensionRatio="H,11:12"
            app:layout_constraintEnd_toStartOf="@id/box5"
            app:layout_constraintStart_toEndOf="@id/box3"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/box5"
            style="@style/PetCare.Auth.CodeBox"
            android:layout_marginStart="@dimen/auth_code_box_gap"
            app:layout_constraintDimensionRatio="H,11:12"
            app:layout_constraintEnd_toStartOf="@id/box6"
            app:layout_constraintStart_toEndOf="@id/box4"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/box6"
            style="@style/PetCare.Auth.CodeBox"
            android:layout_marginStart="@dimen/auth_code_box_gap"
            app:layout_constraintDimensionRatio="H,11:12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/box5"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- The rejected-code message. Gone until there is one, so it takes no space; a live region (from the style). -->
    <TextView
        android:id="@+id/codeError"
        style="@style/PetCare.Auth.ErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:visibility="gone"
        tools:text="@string/error_code_incorrect"
        tools:visibility="visible" />

    <!-- The keypad: four rows of three, laid out as the phone dial pad (1-2-3 on top, 0 centred at the bottom). -->
    <LinearLayout
        style="@style/PetCare.Auth.KeyRow"
        android:layout_marginTop="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key1"
            style="@style/PetCare.Auth.Key"
            android:text="1"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key2"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="2"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key3"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="3"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout style="@style/PetCare.Auth.KeyRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key4"
            style="@style/PetCare.Auth.Key"
            android:text="4"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key5"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="5"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key6"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="6"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout style="@style/PetCare.Auth.KeyRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key7"
            style="@style/PetCare.Auth.Key"
            android:text="7"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key8"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="8"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key9"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="9"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Bottom row: CLEAR, 0, and backspace. -->
    <LinearLayout style="@style/PetCare.Auth.KeyRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyClear"
            style="@style/PetCare.Auth.Key.Clear"
            android:contentDescription="@string/auth_key_clear_description"
            android:text="@string/auth_key_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key0"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:text="0"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyBackspace"
            style="@style/PetCare.Auth.Key"
            android:layout_marginStart="@dimen/auth_key_gap"
            android:contentDescription="@string/auth_key_backspace_description"
            android:text="@string/auth_key_backspace" />
    </LinearLayout>

</merge>
