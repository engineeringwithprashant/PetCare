<?xml version="1.0" encoding="utf-8"?>
<!-- The framing step shown after a photo is chosen for a pet, as the body of a Material dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/card_padding"
    android:paddingBottom="@dimen/spacing_xs">

    <!-- Says what to do: a photograph that responds to dragging is not self-evidently draggable. -->
    <TextView
        android:id="@+id/cropHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/pet_photo_crop_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- The framing window itself. -->
    <com.prash.petcare.ui.common.PhotoCropView
        android:id="@+id/photoCropView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pet_photo_dark"
        android:contentDescription="@string/cd_pet_photo_crop" />

</LinearLayout>
