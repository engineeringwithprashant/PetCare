<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a pet's vaccination history card: the date it was given in a narrow column, a coloured bar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vaccination_card_gutter"
    android:paddingEnd="@dimen/vaccination_card_gutter">

    <!-- The hairline above the row, spanning the card inside its gutter. -->
    <View
        android:id="@+id/divider"
        style="@style/PetCare.Vaccination.Divider"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The date column: "22" over "SEP 25". -->
    <LinearLayout
        android:id="@+id/dateColumn"
        android:layout_width="@dimen/vaccination_date_width"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/textBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textBlock">

        <TextView
            android:id="@+id/dayText"
            style="@style/PetCare.Vaccination.Day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="22" />

        <TextView
            android:id="@+id/monthText"
            style="@style/PetCare.Vaccination.Month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:text="Sep 25" />

    </LinearLayout>

    <!-- The status bar. bg_pill turns a 3dp-wide rectangle into a capsule. -->
    <View
        android:id="@+id/statusBar"
        android:layout_width="@dimen/vaccination_bar_width"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="@drawable/bg_pill"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/textBlock"
        app:layout_constraintStart_toEndOf="@id/dateColumn"
        app:layout_constraintTop_toTopOf="@id/textBlock" />

    <!-- The vaccine's name over its meta line. Width 0dp between the bar and the pill means "fill what is left". -->
    <LinearLayout
        android:id="@+id/textBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vaccination_row_gap"
        android:layout_marginEnd="@dimen/vaccination_row_gap"
        android:importantForAccessibility="noHideDescendants"
        android:minWidth="0dp"
        android:orientation="vertical"
        android:paddingTop="@dimen/vaccination_row_padding_vertical"
        android:paddingBottom="@dimen/vaccination_row_padding_vertical"
        app:layout_constraintEnd_toStartOf="@id/statusPill"
        app:layout_constraintStart_toEndOf="@id/statusBar"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:id="@+id/vaccineNameText"
            style="@style/PetCare.Vaccination.Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="FVRCP (core)" />

        <TextView
            android:id="@+id/metaText"
            style="@style/PetCare.Vaccination.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vaccination_meta_gap"
            tools:text="Next due 22 Sep 2026 · Patan Animal Hospital" />

    </LinearLayout>

    <!-- The status pill, centred on the text block. Its own width, so the text block above yields. -->
    <TextView
        android:id="@+id/statusPill"
        style="@style/PetCare.Vaccination.StatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/textBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textBlock"
        tools:background="@drawable/bg_pill"
        tools:text="Overdue" />

</androidx.constraintlayout.widget.ConstraintLayout>
