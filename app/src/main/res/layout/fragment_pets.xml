<?xml version="1.0" encoding="utf-8"?>
<!--
    The Pets tab: every animal the user has, one large card each, and the way in to adding another.

    From top to bottom:
      - **The header** — monogram, "Pets", theme toggle and pet count — shared with the Home tab
        through <include>. It stays fixed while the page scrolls under it: it is the app's identity
        and two controls, not content, and scrolling it away would put the theme toggle out of reach.
      - **The list**, which scrolls: the headline ("Two pets, one household"), a card per pet, and
        the "+ Add a pet" row. All three live inside one RecyclerView — see PetsFragment for how a
        ConcatAdapter joins them.
      - **The empty state**, shown in the list's place when there are no pets.

    **Why a single RecyclerView rather than a scroll view.** This list has no fixed upper size:
    somebody fostering has a dozen animals, and every card carries a photo to decode. A RecyclerView
    recycles cards as they scroll off, so only the visible ones are ever inflated. The dashboard is
    built the other way round because its sections are short and known — see fragment_home.xml.

    **Why a vertical LinearLayout at the root.** The header takes the height it needs and the region
    below takes the rest (0dp height with layout_weight="1"). The list and the empty state share that
    region, so it is a FrameLayout holding both, and the fragment shows exactly one of them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.pet.PetsFragment">

    <!-- The shared header. The android:id is what makes ViewBinding expose it as a nested binding,
         `binding.header`. See view_tab_header.xml. -->
    <include
        android:id="@+id/header"
        layout="@layout/view_tab_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
            The headline, the cards and the add row.

            clipToPadding="false" lets content scroll *through* the bottom padding rather than being
            cut off at its edge, which is what lets the add row clear the bottom navigation bar
            instead of finishing underneath it. The padding no longer has to clear a floating action
            button, so it is the smaller list_padding_bottom.

            The top padding is small because the headline should sit directly under the header, as
            it does on the dashboard.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/petsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/list_padding_bottom"
            android:visibility="gone"
            tools:listitem="@layout/item_pet"
            tools:visibility="visible" />

        <!--
            Shown instead of the list when the user has no pets.

            An icon, a sentence saying what to do next, and the same outlined "Add a pet" row that
            ends the list when there are pets — rather than a bare line of grey text. An empty screen
            with one short message leaves the user unsure whether there is nothing here or it simply
            has not loaded, and with the floating button gone this is the only way to add a first pet
            from this tab, so the action has to be here.
        -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            style="@style/PetCare.EmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                style="@style/PetCare.EmptyStateIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_pet_placeholder" />

            <TextView
                style="@style/PetCare.EmptyStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pets_empty_title" />

            <TextView
                style="@style/PetCare.EmptyStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pets_empty_message" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyAddPetButton"
                style="@style/PetCare.AddRowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/pets_add_pet_row" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
