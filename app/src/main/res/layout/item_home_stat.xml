<?xml version="1.0" encoding="utf-8"?>
<!--
    One of the three small summary cards under the dashboard's greeting: "WALK WINDOW / 22°C / GOOD
    NOW", "SPENT · SEP / Rs 4,665 / NONE IN AUG", "NEXT VET / — / NONE BOOKED".

    **One layout pulled in three times** with <include> from fragment_home.xml, rather than three
    copies of the same card. The three must stay identical in shape — a row of cards with slightly
    different paddings reads as a mistake — and one file is what makes that a fact. Each <include> is
    given its own android:id, which ViewBinding turns into a nested binding (binding.statWalk.statValue),
    so the fragment reaches every view type-safely without findViewById.

    **These are summaries, not headlines.** The card is exactly three lines evenly spaced inside a
    tight padding, and it is meant to land near 100dp tall so that the dark next-up card below stays
    the dominant object on the screen. Anything added here — a fourth line, a taller figure, a
    roomier padding — takes that dominance away, which is why the card carries no decoration of its
    own beyond its border.

    **The card's look is PetCare.Card.Outlined**, the app's small flat outlined card, rather than
    attributes set here. The dashboard's quick actions and the profile screen's stat row are the same
    object in other places, and naming one style is what keeps the three rows identical — see that
    style for why these particular cards draw a border instead of relying on a shadow.

    The fragment fills all three texts and swaps the pill's colours; nothing here is specific to any
    one card.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Card.Outlined"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/home_stat_card_min_width">

    <!--
        Label, figure and pill stacked top to bottom with one even gap between them. A vertical
        LinearLayout is exactly that arrangement; nothing is positioned relative to anything but the
        view above it.

        The gap is applied as a top margin on the two lower children rather than as spacing on the
        parent, because LinearLayout has no gap property below API 33 and the app supports API 24.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/home_stat_card_padding">

        <!-- "WALK WINDOW": the card's uppercase micro-label, in the mono face. maxLines with no
             ellipsize keeps it on one line — the card widens to fit rather than the text being cut,
             so there is nothing to ellipsise. -->
        <TextView
            android:id="@+id/statLabel"
            style="@style/PetCare.Home.StatLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Walk window" />

        <!--
            The figure — the card's subject.

            **wrap_content, with no auto-sizing.** Every earlier version pinned this view's height and
            let the text shrink to fit the card, which meant the one thing the card exists to show was
            the first thing sacrificed: "Rs 4,665" quietly rendered smaller than the card next to it.
            Now the card is wrap_content over a minimum width, so a long amount widens its own card
            and the figure is always drawn at its stated size. The row already scrolls sideways, so a
            card that is a few dp wider costs nothing.

            lineHeight equals the text size (line-height: 1), which trims the leading a figure on its
            own line does not need and is part of what keeps the card short.
        -->
        <TextView
            android:id="@+id/statValue"
            style="@style/PetCare.Home.StatValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_stat_line_spacing"
            tools:text="22°C" />

        <!-- The status pill. wrap_content so it hugs its words like a tag rather than stretching into
             a bar across the card. Its colours are one of the three tones the fragment applies. -->
        <TextView
            android:id="@+id/statPill"
            style="@style/PetCare.Home.StatPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_stat_line_spacing"
            tools:text="Good now" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
