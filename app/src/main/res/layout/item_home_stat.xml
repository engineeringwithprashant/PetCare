<?xml version="1.0" encoding="utf-8"?>
<!-- One of the three small summary cards under the dashboard's greeting: "WALK WINDOW / 22°C / GOOD NOW". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Card.Outlined"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/home_stat_card_min_width">

    <!-- Label, figure and pill stacked top to bottom with one even gap between them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/home_stat_card_padding">

        <!-- "WALK WINDOW": the card's uppercase micro-label, in the mono face. -->
        <TextView
            android:id="@+id/statLabel"
            style="@style/PetCare.Home.StatLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Walk window" />

        <!-- The figure — the card's subject. -->
        <TextView
            android:id="@+id/statValue"
            style="@style/PetCare.Home.StatValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_stat_line_spacing"
            tools:text="22°C" />

        <!-- The status pill. wrap_content so it hugs its words like a tag. -->
        <TextView
            android:id="@+id/statPill"
            style="@style/PetCare.Home.StatPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_stat_line_spacing"
            tools:text="Good now" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
