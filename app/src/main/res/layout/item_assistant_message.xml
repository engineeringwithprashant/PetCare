<?xml version="1.0" encoding="utf-8"?>
<!-- One message from the assistant: a light card against the cream page, aligned left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxWidth="@dimen/assistant_bubble_max_width"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.AssistantBubble"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/messageText"
            style="@style/PetCare.Assistant.MessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/assistant_bubble_padding"
            tools:text="Hi Prashant. I can see your pet profiles, today's checklist and this month's spend. What do you want to check?" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
