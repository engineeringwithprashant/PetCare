<?xml version="1.0" encoding="utf-8"?>
<!--
    Stands in for the assistant's message while its reply is being produced.

    **Why it is a message rather than a spinner over the screen.** The answer will appear exactly
    here, so the wait is shown exactly here: the placeholder occupies the space the reply will take
    and is replaced by it in place, which is why the list does not jump when the answer lands. An
    overlay would also block the conversation the user is waiting to read.

    Deliberately the same card, side and shape as item_assistant_message.xml — only the contents
    differ — so the swap reads as one thing filling in rather than two different things.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.AssistantBubble"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <!-- An indeterminate bar rather than a spinner: it sits on one line inside a bubble the
             width of a short sentence, which a circular indicator would not. The content
             description is what a screen reader announces, since the bar itself says nothing. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/thinkingIndicator"
            android:layout_width="@dimen/assistant_thinking_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/cd_assistant_thinking"
            android:indeterminate="true"
            android:layout_margin="@dimen/assistant_bubble_padding"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSurfaceVariant"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
