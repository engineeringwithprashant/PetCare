<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the Tasks tab's week strip: the two-letter weekday above the date, and a dot beneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.WeekDay"
    android:layout_width="0dp"
    android:layout_weight="1">

    <!-- "MO", "TU"… Upper-cased by textAllCaps so the locale's own short weekday names can be used. -->
    <TextView
        android:id="@+id/weekdayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_mono"
        android:importantForAccessibility="no"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/week_day_label_text"
        tools:text="Th" />

    <!-- The date number. Bricolage Grotesque, the app's face for numbers, at the Title size. -->
    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bricolage_grotesque"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/week_day_date_text"
        android:textStyle="bold"
        tools:text="11" />

    <!-- The "care scheduled" dot. INVISIBLE rather than GONE when there is none. -->
    <View
        android:id="@+id/dotView"
        android:layout_width="@dimen/week_day_dot_size"
        android:layout_height="@dimen/week_day_dot_size"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="@color/week_day_label_text" />

</LinearLayout>
