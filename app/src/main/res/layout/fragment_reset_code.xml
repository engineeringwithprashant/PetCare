<?xml version="1.0" encoding="utf-8"?>
<!--
    Password reset, step 2 of 3 (ResetCodeFragment): type the six-digit code that was sent.

    Built from the same pieces as the two-factor screen — the header, the step bar and CodeKeypadView —
    so the two code screens behave identically: digits fill left to right, backspace clears the last,
    and "VERIFY CODE" stays disabled until all six are in. Only the text around them differs.

    No text field anywhere, so the system keyboard never opens here. See view_code_keypad.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Auth.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.reset.ResetCodeFragment">

    <LinearLayout
        style="@style/PetCare.Auth.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/header"
            layout="@layout/view_auth_header" />

        <include
            android:id="@+id/stepProgress"
            layout="@layout/view_auth_step_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_header_gap" />

        <com.prash.petcare.ui.auth.CodeKeypadView
            android:id="@+id/codeKeypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md" />

        <!-- "Sent to … · expires in 10 min" with "RESEND" at the end: the note takes the free width,
             the link keeps its own. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sentNote"
                style="@style/PetCare.Auth.Helper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Sent to +977 98•• ••12 · expires in 10 min" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resendButton"
                style="@style/PetCare.Auth.TextLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="-8dp"
                android:text="@string/reset_code_resend" />
        </LinearLayout>

        <!-- Disabled until the code is complete; ResetCodeFragment enables it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyButton"
            style="@style/PetCare.Auth.PrimaryButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:enabled="false"
            android:text="@string/reset_code_submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToLoginButton"
            style="@style/PetCare.Auth.BackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/auth_back_to_login" />

    </LinearLayout>
</ScrollView>
