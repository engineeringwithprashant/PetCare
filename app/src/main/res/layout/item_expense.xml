<?xml version="1.0" encoding="utf-8"?>
<!--
    One expense card on the Money tab: a grey category badge ("MED"), the title in bold over
    "Medication · Sep 12, 2026", and the amount right-aligned.

    A clickable MaterialCardView, so the whole card is one touch target with a ripple following its
    rounded corners; tapping opens the expense's edit screen, and swiping it left deletes it with an
    undo (ExpensesFragment). The pet cards' softer corner, as in the design.

    Kept shallow — a card, one row, one column — because this layout is inflated per visible row and
    rebound constantly as the list scrolls. Inside, a horizontal LinearLayout with the text column
    taking the leftover width (weight 1), so a long title ellipsises instead of pushing the amount off
    the card and every amount lines up in a column down the list.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PetCare.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/expenses_card_spacing"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.XLarge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/expenseBadgeText"
            style="@style/PetCare.Expenses.Badge"
            tools:text="MED" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/expenseTitleText"
                style="@style/PetCare.ListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="Grooming" />

            <TextView
                android:id="@+id/expenseSubtitleText"
                style="@style/PetCare.Expenses.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Medication · Sep 12, 2026" />

        </LinearLayout>

        <TextView
            android:id="@+id/expenseAmountText"
            style="@style/PetCare.Expenses.Amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textColor="?attr/colorOnSurface"
            tools:text="Rs 4,665" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
