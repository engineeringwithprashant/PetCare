<?xml version="1.0" encoding="utf-8"?>
<!--
    The locked screen, shown in place of the whole log in form after five wrong passwords.

    Pulled into fragment_auth.xml with <include android:id="@+id/lockedPanel">, under the shared
    header, and made visible only while AuthViewModel reports a lock. It replaces the form rather than
    covering it: there is nothing useful the user can do with a password field they are not allowed to
    submit, and leaving it on screen invites them to keep trying.

    **The shape of the screen**, top to bottom, following design/auth-locked-mockup.png:
      1. a dark panel carrying the countdown ring, the state, a heading and the explanation;
      2. two pale rows — what happened, and the reassurance that nothing was reached;
      3. the two ways out: reset the password now, or wait.

    The dark panel is a MaterialCardView with fixed colours rather than theme roles, because it is
    dark in *both* themes by design — the same treatment as the dashboard's next-up card and the
    profile header. See the log in section of colors.xml for why.

    A vertical LinearLayout throughout: this is a single column where each block sits below the last,
    which is exactly what LinearLayout is for and cheaper to measure than a ConstraintLayout. The one
    place something is stacked *over* something else is the countdown ring, where the FrameLayout is
    doing the one thing it expresses in a single attribute.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:background="?android:attr/colorBackground">

    <!-- ============================ The dark panel ============================ -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_header_gap"
        app:cardBackgroundColor="@color/auth_lock_card_ground"
        app:cardCornerRadius="@dimen/auth_lock_card_corner_radius"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/auth_lock_card_padding">

            <!--
                The countdown ring: the minutes left drawn inside a circular track.

                A FrameLayout so the figure sits *on* the ring rather than beside it — the two are one
                object, and any other container would need the text positioned by hand. The
                indicator's size is fixed here and the text centred over it, so the two stay concentric
                whatever the user's font scale.

                A determinate CircularProgressIndicator rather than a custom View: Material already
                draws exactly this, and the fragment only has to set a percentage on it each second.
            -->
            <!--
                **Both this frame and the indicator are wrap_content, deliberately.** Sizing either
                of them to auth_lock_ring_size exactly clips the ring: a CircularProgressIndicator
                needs indicatorSize *plus* its indicatorInset on each edge, so a box of exactly
                indicatorSize trims the stroke on whichever side the arc starts. Letting the widget
                measure itself is what reserves that margin, and it stays correct if the thickness or
                the inset is ever changed.
            -->
            <FrameLayout
                android:id="@+id/lockRing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- indeterminate=false because this ring reports a real, known quantity: how much
                     of the fifteen minutes is left. trackCornerRadius rounds the ends of the arc, as
                     the mockup draws them. Hidden from TalkBack: the ring is a picture of the number
                     in front of it, and the frame above carries the spoken version. -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/lockRingProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:indeterminate="false"
                    app:indicatorColor="@color/auth_lock_red"
                    app:indicatorSize="@dimen/auth_lock_ring_size"
                    app:trackColor="@color/auth_lock_ring_track"
                    app:trackCornerRadius="@dimen/auth_lock_ring_thickness"
                    app:trackThickness="@dimen/auth_lock_ring_thickness"
                    tools:progress="100" />

                <!--
                    The figure and its unit, centred as a pair inside the ring.

                    **Fixed to the ring's inscribed square, in both directions.** A square drawn
                    inside a circle of inner diameter d has sides of about 0.7d, and that square is
                    the only area where two stacked lines are guaranteed to clear the stroke at every
                    height. Capping the width alone was not enough: sp sizes grow with the system font
                    scale, so at 1.5x the pair stayed narrow but grew *taller* than the circle and
                    "MIN LEFT" crossed the arc at the bottom.

                    Both children are therefore bounded in height as well, which is what lets the
                    autosizing below shrink them to fit rather than overflow. The caption keeps its
                    natural height and the figure takes whatever is left (height 0dp + weight 1).
                -->
                <LinearLayout
                    android:layout_width="@dimen/auth_lock_ring_inner_size"
                    android:layout_height="@dimen/auth_lock_ring_inner_size"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <!-- autoSizeTextType shrinks the number between the two bounds until it fits the
                         box the parent gives it. It needs bounded dimensions, which is exactly what
                         the fixed square above supplies, and works back to API 14 through the
                         AppCompat attribute. -->
                    <TextView
                        android:id="@+id/lockMinutesText"
                        style="@style/PetCare.Auth.LockMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        app:autoSizeMaxTextSize="@dimen/auth_lock_ring_minutes_text_size"
                        app:autoSizeMinTextSize="@dimen/auth_lock_ring_minutes_min_text_size"
                        app:autoSizeTextType="uniform"
                        tools:text="15" />

                    <!-- Autosized for the same reason as the figure above, and it matters more here:
                         this label is a fixed two words, so without shrinking it is simply cut short
                         ("MIN LEFT" became "MIN" at a 1.5x font scale). -->
                    <TextView
                        style="@style/PetCare.Auth.LockRingCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/login_locked_min_left"
                        app:autoSizeMaxTextSize="@dimen/auth_lock_ring_caption_text_size"
                        app:autoSizeMinTextSize="@dimen/auth_lock_ring_caption_min_text_size"
                        app:autoSizeTextType="uniform" />

                </LinearLayout>

            </FrameLayout>

            <!-- "ACCOUNT LOCKED". -->
            <TextView
                style="@style/PetCare.Auth.LockLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/login_locked_label" />

            <!-- The heading. Marked as a heading for accessibility (API 28+) like every other screen
                 title in the app, so TalkBack users can jump to it; older versions ignore it. -->
            <TextView
                style="@style/PetCare.Auth.LockTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:accessibilityHeading="true"
                android:text="@string/login_locked_title"
                tools:targetApi="p" />

            <!-- How many attempts failed, when sign-in reopens, and the way round the wait. Filled in
                 by the fragment, which is what turns the unlock time into a clock reading. -->
            <TextView
                android:id="@+id/lockBodyText"
                style="@style/PetCare.Auth.LockBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                tools:text="5 failed attempts on this device. Sign-in reopens at 5:53 PM — or reset your password to get straight back in." />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============================ The two info rows ============================
         A square code badge, a bold title and a muted line — the same row grammar as an alert card on
         the notifications screen and an expense on the Money tab, so a badge-title-detail row means
         the same kind of thing throughout the app.

         These are ordinary surface cards, not dark ones: they are supporting facts read after the
         panel above, and a second dark block would compete with it. -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:cardCornerRadius="@dimen/auth_alert_corner_radius"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/auth_lock_info_row_padding">

            <TextView
                style="@style/PetCare.Auth.LockInfoBadge"
                android:text="@string/login_locked_attempts_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- "5 failed attempts" — the count, filled in by the fragment. -->
                <TextView
                    android:id="@+id/lockAttemptsTitle"
                    style="@style/PetCare.Auth.LockInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="5 failed attempts" />

                <!-- "Last try 5:38 PM · this device, Pixel 7" — when and where, so the account's
                     owner can tell their own forgotten password from someone else's guessing. -->
                <TextView
                    android:id="@+id/lockAttemptsDetail"
                    style="@style/PetCare.Auth.LockInfoDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Last try 5:38 PM · this device, Pixel 7" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- The reassurance. Entirely static text — nothing here depends on the account — so it carries
         no ids and the fragment never touches it. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:cardCornerRadius="@dimen/auth_alert_corner_radius"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/auth_lock_info_row_padding">

            <TextView
                style="@style/PetCare.Auth.LockInfoBadge"
                android:text="@string/login_locked_safe_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/PetCare.Auth.LockInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_locked_safe_title" />

                <TextView
                    style="@style/PetCare.Auth.LockInfoDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_locked_safe_detail" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============================ The two ways out ============================ -->

    <!-- The one action that actually ends the wait, so it takes the filled accent button: someone who
         can reset the password is back in immediately, and the reset also clears this lock (see
         ResetRequestViewModel). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lockResetButton"
        style="@style/PetCare.Auth.PrimaryButton"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/login_locked_reset" />

    <!-- Waiting it out. Disabled for the whole lock, with the remaining minutes as its label, so the
         countdown is readable without interpreting the ring. The fragment enables it the moment the
         lock expires — at which point the form returns anyway, making this a fallback rather than the
         main route back. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lockRetryButton"
        style="@style/PetCare.Auth.SecondaryButton"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:enabled="false"
        tools:text="Try again in 15 min" />

</LinearLayout>
