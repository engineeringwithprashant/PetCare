<?xml version="1.0" encoding="utf-8"?>
<!-- The step bar on the two-factor screen: three short segments, the completed ones in yellow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Hidden from TalkBack: the label beside it already says which step this is, in words. -->
    <com.prash.petcare.ui.common.SegmentedProgressView
        android:id="@+id/stepBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_step_bar_height"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/stepLabel"
        style="@style/PetCare.Auth.StepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Step 2 of 2" />

</LinearLayout>
