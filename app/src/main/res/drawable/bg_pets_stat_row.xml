<?xml version="1.0" encoding="utf-8"?>
<!--
    The outlined box around the age / weight / due-today row on a Pets-tab card.

    **Outlined rather than filled.** The row sits on the card's light surface, directly under the
    pet's name. A filled panel would give three small numbers as much weight as the name above them;
    a hairline outline groups them as one unit of "facts about this animal" without competing.

    The thin vertical dividers between the three blocks are separate Views in item_pet.xml, not part
    of this drawable — a background cannot know where its children's edges fall.

    Transparent fill and a theme-role stroke, so the one file works in light and dark mode: the card's
    own surface colour shows through, and colorOutlineVariant is a faint line on either.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <stroke
        android:width="@dimen/pets_stat_divider_width"
        android:color="?attr/colorOutlineVariant" />

    <corners android:radius="@dimen/corner_radius_sm" />

</shape>
