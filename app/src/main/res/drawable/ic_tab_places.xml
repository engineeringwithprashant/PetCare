<?xml version="1.0" encoding="utf-8"?>
<!--
    The Places tab's icon: a map pin.

    Stroked, untinted and drawn on the same 24dp grid as the rest of the set — see ic_tab_home.xml.

    Kept separate from ic_nav_places.xml, the filled pin the Places screen uses for its empty state:
    that one belongs to the screen and is unaffected by anything in the bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Two subpaths: the teardrop, and the hole in its head.

        The teardrop starts at the point (12,21) and rises on a curve to the right shoulder, sweeps
        over the top as a 6.4-radius arc, then falls back to the point on a mirrored curve — so the
        two flanks are symmetrical and the tip stays sharp, which a plain circle-on-a-triangle does
        not manage at this size.
    -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M12,21 S18.4,15.4 18.4,10.8 A6.4,6.4 0 0 0 5.6,10.8 C5.6,15.4 12,21 12,21 Z M9.7,10.6 A2.3,2.3 0 1 1 14.3,10.6 A2.3,2.3 0 1 1 9.7,10.6 Z"
        android:strokeColor="@android:color/white"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />

</vector>
