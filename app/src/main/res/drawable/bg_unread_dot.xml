<?xml version="1.0" encoding="utf-8"?>
<!--
    The small red dot on the top corner of the header's pet-count badge, shown when some of today's
    care is past its time and not yet done.

    The ring around it is the page colour (?attr/colorBackground). Without it the red would touch the
    badge's own outline and the two edges would blur into a smudge at this size; the ring cuts a clean
    gap between them in either theme, which is how notification dots are conventionally drawn.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <solid android:color="@color/header_unread_dot" />

    <stroke
        android:width="1.5dp"
        android:color="?android:attr/colorBackground" />

</shape>
