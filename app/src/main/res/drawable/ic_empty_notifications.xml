<!--
    Bell with a tick, shown in the notifications screen's empty state.

    A separate drawable from ic_notification.xml, which looks similar but cannot be reused here: that
    one is a notification's *small icon*, drawn by the system status bar as a stencil where only the
    alpha channel survives, so it is a solid opaque silhouette with no tint. This one is drawn by the
    app on its own page, so it is tinted to the muted role like the other empty-state illustrations
    (see ic_empty_tasks.xml) and can afford the tick that says "nothing is waiting" rather than simply
    "notifications".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurfaceVariant">
    <!-- The bell: body, clapper and the rule it hangs above. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11,21c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.9,2 2,2zM17,15v-4.5c0,-2.84 -1.52,-5.21 -4.17,-5.84L12.5,3.5c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v1.16C6.85,5.29 5,7.66 5,10.5L5,15l-2,2v1h16v-1l-2,-2z" />
    <!-- The tick, set clear of the bell's shoulder so the two shapes stay legible at 72dp. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M17.6,8.9l-2.6,-2.6l1.1,-1.1l1.5,1.5l3.3,-3.3l1.1,1.1z" />
</vector>
