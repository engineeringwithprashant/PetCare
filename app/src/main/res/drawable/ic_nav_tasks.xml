<?xml version="1.0" encoding="utf-8"?>
<!--
    The Tasks tab in the bottom navigation bar: a tick inside a circle.

    A tick rather than a list, because what this tab is *for* is ticking care off — and a list glyph
    would be hard to tell from the Expenses tab beside it at 24dp.

    Deliberately untinted; see the note in ic_nav_home.xml for why.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The tick, drawn overshooting the circle at its top-right so the two read as one mark rather
         than as a tick that happens to be inside a ring. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M22,5.18L10.59,16.6l-4.24,-4.24l1.41,-1.41l2.83,2.83l10,-10L22,5.18z" />

    <!-- The circle, broken where the tick leaves it. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.79,10.22C19.92,10.79 20,11.39 20,12c0,4.42 -3.58,8 -8,8s-8,-3.58 -8,-8c0,-4.42 3.58,-8 8,-8c1.58,0 3.04,0.46 4.28,1.25l1.44,-1.44C16.1,2.67 14.13,2 12,2C6.48,2 2,6.48 2,12s4.48,10 10,10s10,-4.48 10,-10c0,-1.19 -0.22,-2.33 -0.6,-3.39L19.79,10.22z" />

</vector>
