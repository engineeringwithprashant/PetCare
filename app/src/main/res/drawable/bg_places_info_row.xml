<?xml version="1.0" encoding="utf-8"?>
<!--
    The outline around the featured place's two info blocks — opening hours and phone.

    One outline around the pair, with a hairline divider between them in the layout, rather than a
    separate box per block: the two facts are read together ("when can I go, how do I call"), and one
    shape with a split says that, where two boxes side by side would read as two unrelated cards. The
    same construction as the stat row on the Pets tab (bg_pets_stat_row.xml).

    No fill, so the card's own surface shows through in either theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />

    <corners android:radius="@dimen/places_info_corner_radius" />

</shape>
