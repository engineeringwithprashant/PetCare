<?xml version="1.0" encoding="utf-8"?>
<!--
    The rounded square behind a saved place's category badge ("Vet", "Grm") on the Places tab.

    White with no colour of its own, so the backgroundTint SavedPlaceAdapter applies — the accent for
    the featured place, a muted surface for the rest — comes through unchanged; see bg_pill.xml for why
    a tinted drawable must start from white.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/white" />

    <corners android:radius="@dimen/places_badge_corner_radius" />

</shape>
