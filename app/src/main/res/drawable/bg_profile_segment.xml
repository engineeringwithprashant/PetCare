<?xml version="1.0" encoding="utf-8"?>
<!-- One half of a two-option preference toggle: filled when it is the chosen option, invisible when it is not. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSelectedContainer" />
            <corners android:radius="@dimen/pill_corner_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/pill_corner_radius" />
        </shape>
    </item>

</selector>
