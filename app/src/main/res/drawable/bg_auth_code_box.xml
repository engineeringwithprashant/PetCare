<?xml version="1.0" encoding="utf-8"?>
<!-- One of the six digit boxes on the two-factor screen (drawn by the reusable CodeKeypadView). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <stroke
                android:width="@dimen/auth_code_box_stroke_active"
                android:color="?attr/colorError" />
            <corners android:radius="@dimen/auth_code_box_corner_radius" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <stroke
                android:width="@dimen/auth_code_box_stroke_active"
                android:color="@color/accent_yellow" />
            <corners android:radius="@dimen/auth_code_box_corner_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutlineVariant" />
            <corners android:radius="@dimen/auth_code_box_corner_radius" />
        </shape>
    </item>

</selector>
