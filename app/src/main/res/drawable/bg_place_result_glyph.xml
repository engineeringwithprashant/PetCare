<?xml version="1.0" encoding="utf-8"?>
<!--
    The rounded square holding a search result's category short code — "Vet", "Grm", "Park", "Shop".

    The saved-place badge (bg_place_badge.xml) at a slightly larger radius, and white for the same
    reason: PlaceSuggestionAdapter tints it — the accent for the chosen result, the quiet surface for
    the rest — and a tint multiplies against what is already there, so any coloured fill here would
    darken every glyph that used it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/white" />

    <corners android:radius="@dimen/add_place_result_glyph_corner_radius" />

</shape>
