<?xml version="1.0" encoding="utf-8"?>
<!-- The sun shown in the dashboard's theme toggle while the app is in light mode. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The disc. Written as a move-to plus two half arcs, which is how a circle is expressed in path data. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,12m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />

    <!-- The eight rays, as one path. Four on the axes and four on the diagonals. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11,1h2v3.5h-2zM11,19.5h2V23h-2zM1,11h3.5v2H1zM19.5,11H23v2h-3.5zM3.9,5.3l1.4,-1.4l2.5,2.5l-1.4,1.4zM16.2,17.6l1.4,-1.4l2.5,2.5l-1.4,1.4zM18.7,3.9l1.4,1.4l-2.5,2.5l-1.4,-1.4zM6.4,16.2l1.4,1.4l-2.5,2.5l-1.4,-1.4z" />

</vector>
