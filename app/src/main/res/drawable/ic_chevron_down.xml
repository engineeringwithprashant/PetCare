<?xml version="1.0" encoding="utf-8"?>
<!--
    The small downward chevron after "MAP TYPE" on the map's corner control.

    It is the one mark that tells the user the pill *opens* something rather than doing something: a
    label on its own reads as a status ("the map type is…"), and the screen already has pills that are
    statuses. Drawn as a chevron rather than a filled triangle to match the rest of the app's icon set,
    which is all stroked shapes.

    Drawn white and recoloured by the button's iconTint, like every other icon here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.41,8.59 L12,13.17l4.59,-4.58L18,10l-6,6 -6,-6 1.41,-1.41z" />

</vector>
