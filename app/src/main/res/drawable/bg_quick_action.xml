<?xml version="1.0" encoding="utf-8"?>
<!--
    The outlined tile behind one of the dashboard's three quick actions.

    **Outlined rather than filled.** The three tiles sit directly below the pet cards, which are
    large, dark and photographic. Filling these as well would give the bottom of the screen the same
    visual weight as its subject; an outline states that they are available without asking to be
    looked at first.

    A `ripple` wrapping the shape rather than the bare shape, so a press is acknowledged. The ripple
    is clipped to the rounded outline because the shape is the ripple's content — set as a plain
    background colour it would paint square at the corners.

    Both colours are theme roles, so the tiles follow light and dark mode from this one file.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorPrimary">

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@android:color/transparent" />

            <stroke
                android:width="@dimen/quick_action_stroke_width"
                android:color="?attr/colorOutlineVariant" />

            <corners android:radius="@dimen/corner_radius_md" />

        </shape>
    </item>

</ripple>
