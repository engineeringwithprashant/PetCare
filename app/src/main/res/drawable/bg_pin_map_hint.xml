<?xml version="1.0" encoding="utf-8"?>
<!--
    "TAP OR DRAG TO MOVE": the instruction pill in the map's bottom-left corner.

    A translucent near-black capsule, fixed in both themes. It is laid over the map rather than over
    the page, and the map's light and dark grounds are far apart — a pill that followed the theme
    would be pale-on-pale in one of them. Translucent so the grid still shows faintly through it,
    which is what marks it as an overlay on the map rather than a control beside it.

    The radius is far larger than the pill can be tall, which is how a rounded rectangle becomes a
    capsule — see bg_pill.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/pin_map_hint_ground" />

    <corners android:radius="@dimen/pill_corner_radius" />

</shape>
