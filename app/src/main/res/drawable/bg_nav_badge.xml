<?xml version="1.0" encoding="utf-8"?>
<!-- The pill behind the Tasks tab's open-task count. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- On the active pill. Ordered first: Android takes the first item whose states all match. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorNavBadgeActive" />
            <corners android:radius="@dimen/nav_badge_corner_radius" />
        </shape>
    </item>

    <!-- On an inactive tab: the alert red, the same in either theme. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_badge_ground" />
            <corners android:radius="@dimen/nav_badge_corner_radius" />
        </shape>
    </item>

</selector>
