<?xml version="1.0" encoding="utf-8"?>
<!--
    The Pets tab in the bottom navigation bar: a paw print.

    The same four-toes-and-a-pad construction as ic_pet_placeholder, redrawn at icon scale so the
    toes stay separable at 24dp — the placeholder's proportions are tuned for 96dp and the gaps
    close up when shrunk this far.

    Deliberately untinted; see the note in ic_nav_home.xml for why.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The four toes. Each is an oval written as a move-to plus two arcs, which is how a circle is
         expressed in path data — there is no "ellipse" command. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.5,11.5m-2,0a2,2.4 0,1 1,4 0a2,2.4 0,1 1,-4 0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9.2,7.2m-2.1,0a2.1,2.5 0,1 1,4.2 0a2.1,2.5 0,1 1,-4.2 0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M14.8,7.2m-2.1,0a2.1,2.5 0,1 1,4.2 0a2.1,2.5 0,1 1,-4.2 0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.5,11.5m-2,0a2,2.4 0,1 1,4 0a2,2.4 0,1 1,-4 0" />

    <!-- The main pad, a rounded shape wider than it is tall. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,12.5c-2.7,0 -5.2,2.1 -5.2,4.7 0,2.1 1.6,3.6 3.7,3.6h3c2.1,0 3.7,-1.5 3.7,-3.6 0,-2.6 -2.5,-4.7 -5.2,-4.7z" />

</vector>
