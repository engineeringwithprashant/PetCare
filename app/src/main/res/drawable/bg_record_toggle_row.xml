<?xml version="1.0" encoding="utf-8"?>
<!--
    The panel behind the "Add next dose to the checklist" row on the record screen.

    An **outlined** surface rather than the sunk fill the summary card below it uses
    (bg_add_place_summary.xml), and the difference is the point: the summary is a readback that should
    recede, while this row is a control the user can press. A card-coloured fill with a hairline edge
    is how the app draws a quiet pressable panel everywhere else — see PetCare.Card.Outlined and the
    note there on why small surfaces are separated by a drawn border rather than by a shadow.

    Both colours are theme roles, so one file serves light and dark mode: the fill follows the card
    colour and the edge follows the page's hairline colour, exactly as they do on every other outlined
    surface in the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurface" />

    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />

    <corners android:radius="@dimen/record_toggle_corner_radius" />

</shape>
