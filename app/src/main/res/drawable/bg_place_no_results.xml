<?xml version="1.0" encoding="utf-8"?>
<!--
    The "nothing matched" card under the search box.

    A **dashed** outline with no fill, which is the conventional way to draw a container that has no
    contents: the broken edge says "this is where results would be" rather than presenting an empty
    panel as a result in itself. It also tells the two states apart at a glance — real results are
    solid-edged cards, this one is not.

    dashWidth and dashGap are equal so the edge reads as evenly broken rather than as a dotted line.
    A stroke needs a `solid` sibling to be measured against on some versions, so the fill is declared
    explicitly transparent rather than left out.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/transparent" />

    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant"
        android:dashGap="@dimen/add_place_empty_dash_length"
        android:dashWidth="@dimen/add_place_empty_dash_length" />

    <corners android:radius="@dimen/add_place_result_corner_radius" />

</shape>
