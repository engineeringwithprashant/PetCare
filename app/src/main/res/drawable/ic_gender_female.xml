<!--
    The Venus symbol (♀): a ring with a cross beneath it. Shown beside the species chip on the pet
    detail screen for a female pet.

    A vector path rather than the Unicode character "♀", for the reason given in
    ic_gender_male.xml: the character's appearance depends on the device's fonts, a path does not.

    White fill, tinted pink (@color/gender_female) by the ImageView that shows it. fillType="evenOdd"
    leaves the centre of the ring empty — see ic_gender_male.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- First sub-path: the ring's outer edge (radius 5.5, centred at (12, 9.5)) continuing down
         into the stem and the cross bar below it. Second: the ring's inner edge (radius 3.5). The
         standard Material "female" glyph. -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M17.5,9.5C17.5,6.46 15.04,4 12,4S6.5,6.46 6.5,9.5c0,2.7 1.94,4.93 4.5,5.4V17H9v2h2v2h2v-2h2v-2h-2v-2.1C15.56,14.43 17.5,12.2 17.5,9.5zM8.5,9.5C8.5,7.57 10.07,6 12,6s3.5,1.57 3.5,3.5S13.93,13 12,13S8.5,11.43 8.5,9.5z" />

</vector>
