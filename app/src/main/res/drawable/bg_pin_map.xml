<?xml version="1.0" encoding="utf-8"?>
<!--
    The ground of the "Drop pin" map on the Add a place screen.

    Only the fill and the rounded corners live here. The grid ruled over it and the "you are here"
    dot are painted by PinMapView, because a grid has to be drawn to whatever size the map ends up
    and a shape drawable cannot repeat itself.

    The fill is a theme role (see attrs.xml), so one file serves the pale sage of light mode and the
    deep slate of dark. The view sets `clipToOutline`, which is what makes this radius crop the grid
    and the marker as well as the fill — the design's `overflow: hidden`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorPinMapGround" />

    <corners android:radius="@dimen/pin_map_corner_radius" />

</shape>
