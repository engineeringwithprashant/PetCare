<?xml version="1.0" encoding="utf-8"?>
<!--
    The rounded square behind a reset option card's "MAIL" / "SMS" badge.

    White here on purpose: the badge's colour comes entirely from android:backgroundTint
    (res/color/auth_option_badge_background.xml), which changes with the card's checked state. Keeping
    the shape and the colour in separate files means the shape is described once.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/white" />

    <corners android:radius="@dimen/auth_option_badge_corner_radius" />

</shape>
