<?xml version="1.0" encoding="utf-8"?>
<!-- The small rounded square behind a mark on the sign-in screens: the exclamation on the wrong-password warning. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White rather than transparent: a tint multiplies against the fill. -->
    <solid android:color="@android:color/white" />

    <corners android:radius="@dimen/auth_alert_badge_corner_radius" />

</shape>
