<?xml version="1.0" encoding="utf-8"?>
<!-- The rounded square holding an alert's type code ("VAX", "MISS", "TIP") on the notifications screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White rather than transparent: a tint multiplies against the fill. -->
    <solid android:color="@android:color/white" />

    <corners android:radius="@dimen/alert_badge_corner_radius" />

</shape>
