<?xml version="1.0" encoding="utf-8"?>
<!--
    The tick beside a satisfied password rule.

    A filled circle with the tick knocked out of it rather than a bare tick, so a met rule reads as a
    solid mark against the open ring of an unmet one (ic_rule_unmet.xml) — the two are told apart by
    their *shape* as well as by their colour, which is what keeps the checklist readable for a
    red/green colour-blind reader.

    No colour is set here: PasswordChecklistView tints it, because "met" and "not met" are states the
    drawable cannot know. android:fillType="evenOdd" is what makes the tick a hole in the disc instead
    of a shape drawn on top of it, so the tint shows the page through the tick.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurfaceVariant">

    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM10.6,16.6L6.4,12.4l1.4,-1.4 2.8,2.8 5.6,-5.6 1.4,1.4 -7,7z" />

</vector>
