<?xml version="1.0" encoding="utf-8"?>
<!--
    The muted panel behind a large pet photo — the detail screen's header and the add/edit form's
    preview — seen when the pet has no photo and the paw-print placeholder is showing.

    The rounded-rectangle counterpart of bg_photo_circle.xml; see that file for why the background
    is given a shape of its own rather than being a flat colour.

    The radius is the app's large step, matching the shapeAppearanceOverlay applied to the image
    itself. The two have to agree: this drawable and that overlay are describing the same outline
    from opposite sides, and a mismatch would show as a sliver of grey outside the photo's corner.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceVariant" />

    <corners android:radius="@dimen/corner_radius_lg" />

</shape>
