<?xml version="1.0" encoding="utf-8"?>
<!--
    The Places screen's empty-state mark: a filled map pin.

    A pin rather than a map because the tab is a list of *specific places*, not a map view — and a pin
    is the mark every maps app uses for "a saved location", which is exactly what each entry is. The
    hole in the head keeps it legible as a pin at 24dp rather than as a teardrop.

    Filled, and not the pin the Places *tab* draws in the bottom bar — that one is an outline at two
    stroke weights, see ic_tab_places.xml. The two are deliberately separate files: this one is a
    large mark in the middle of an empty screen, where an outline reads as faint, and the bar's is a
    small glyph in a row of five, where a solid shape reads as a blob.

    No tint here; fragment_places.xml applies one, so the same drawing could be used at another
    weight of grey elsewhere without a second copy.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The pin: a circle drawn down to a point, with a round hole through its head. The second
         sub-path is the hole; the even-odd fill type is what leaves it unpainted. -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13C19,5.13 15.87,2 12,2zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5 2.5,1.12 2.5,2.5 -1.12,2.5 -2.5,2.5z" />

</vector>
