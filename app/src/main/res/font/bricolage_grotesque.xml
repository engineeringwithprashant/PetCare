<?xml version="1.0" encoding="utf-8"?>
<!-- Bricolage Grotesque — the app's character face, used only for big headlines, names and numbers. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/bricolage_grotesque_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/bricolage_grotesque_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />

</font-family>
