<?xml version="1.0" encoding="utf-8"?>
<!-- Schibsted Grotesk at its interface weights — the family for titles, buttons and chips. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/schibsted_grotesk_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/schibsted_grotesk_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/schibsted_grotesk_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/schibsted_grotesk_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

</font-family>
