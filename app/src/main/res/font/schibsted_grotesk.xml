<?xml version="1.0" encoding="utf-8"?>
<!-- Schibsted Grotesk at its reading weights — the family for body copy. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/schibsted_grotesk_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/schibsted_grotesk_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/schibsted_grotesk_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/schibsted_grotesk_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
