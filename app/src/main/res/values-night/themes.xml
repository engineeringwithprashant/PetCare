<!-- The app's dark theme. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.PetCare" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>

        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>

        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Switched off for the same reason as in the light theme. -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>

        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_dark_inversePrimary</item>

        <!-- In dark mode the bright yellow is the legible foreground, so this lands back on the primary. -->
        <item name="colorAccentText">@color/accent_text_dark</item>

        <!-- The "chosen" fill flips to yellow here: a near-black fill would disappear into the near-black page. -->
        <item name="colorSelectedContainer">@color/selected_container_dark</item>
        <item name="colorOnSelectedContainer">@color/on_selected_container_dark</item>
        <item name="colorOnSelectedContainerNeutral">@color/on_selected_container_neutral_dark</item>
        <!-- A muted charcoal rather than a dimmed yellow for the resting button. See attrs.xml. -->
        <item name="colorDisabledContainer">@color/disabled_container_dark</item>
        <item name="colorOnDisabledContainer">@color/on_disabled_container_dark</item>

        <!-- The dark half of the app's own pill roles — see attrs.xml. -->
        <item name="colorPillMint">@color/pill_dark_mint</item>
        <item name="colorOnPillMint">@color/pill_dark_on_mint</item>
        <item name="colorPillSky">@color/pill_dark_sky</item>
        <item name="colorOnPillSky">@color/pill_dark_on_sky</item>
        <item name="colorPillLilac">@color/pill_dark_lilac</item>
        <item name="colorOnPillLilac">@color/pill_dark_on_lilac</item>
        <item name="colorPillPeach">@color/pill_dark_peach</item>
        <item name="colorOnPillPeach">@color/pill_dark_on_peach</item>
        <!-- The same pill inverted for dark mode: a deep ground with pale text, like the stat pills above. -->
        <item name="colorPillVerified">@color/verified_pill_dark</item>
        <item name="colorOnPillVerified">@color/on_verified_pill_dark</item>

        <!-- The warning cards inverted for dark mode: a deep tinted ground with a lighter edge. -->
        <item name="colorAuthAlertWarning">@color/auth_alert_warning_fill_dark</item>
        <item name="colorAuthAlertWarningEdge">@color/auth_alert_warning_edge_dark</item>
        <item name="colorAuthAlertDanger">@color/auth_alert_danger_fill_dark</item>
        <item name="colorAuthAlertDangerEdge">@color/auth_alert_danger_edge_dark</item>
        <item name="colorOnAuthAlertDanger">@color/auth_alert_danger_title_dark</item>

        <!-- The floating navigation bar, inverted. The slab becomes a near-black at 90% over the near-black page. -->
        <item name="colorNavBarSurface">@color/nav_bar_surface_dark</item>
        <item name="colorNavTabActive">@color/nav_tab_active_dark</item>
        <item name="colorOnNavTabActive">@color/on_nav_tab_active_dark</item>
        <item name="colorNavTabMuted">@color/nav_tab_muted_dark</item>
        <item name="colorNavBadgeActive">@color/nav_badge_active_dark</item>
        <item name="colorOnNavBadgeActive">@color/on_nav_badge_active_dark</item>

        <!-- The map cards' loading ground, inverted: a deep slate rather than a pale sage. -->
        <item name="colorMapGround">@color/map_ground_dark</item>

        <!-- The vaccination status pills, inverted: a deep ground with pale ink. -->
        <item name="colorVaccinationClear">@color/vaccination_clear_dark</item>
        <item name="colorOnVaccinationClear">@color/on_vaccination_clear_dark</item>
        <item name="colorVaccinationOverdue">@color/vaccination_overdue_dark</item>
        <item name="colorOnVaccinationOverdue">@color/on_vaccination_overdue_dark</item>
        <item name="colorVaccinationDue">@color/vaccination_due</item>
        <item name="colorOnVaccinationDue">@color/on_vaccination_due</item>

        <!-- The shape scale and the default component styles are identical in both themes. -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.PetCare.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.PetCare.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.PetCare.Large</item>

        <!-- The type scale is identical too — dark mode never changes a typeface. See type.xml. -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.PetCare.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.PetCare.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.PetCare.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PetCare.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PetCare.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PetCare.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PetCare.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PetCare.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PetCare.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PetCare.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PetCare.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PetCare.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PetCare.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PetCare.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.PetCare.LabelSmall</item>
        <item name="android:textAppearance">@style/TextAppearance.PetCare.Default</item>

        <item name="materialCardViewStyle">@style/PetCare.Card</item>

        <!-- False in this theme: the page behind the system bars is now near-black. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
