<?xml version="1.0" encoding="utf-8"?>
<!--
    Fill of a filter chip on the Tasks tab (category and pet rows).

    A color *state list*: Android picks the first item whose states match the chip's current state,
    so the order matters — the checked case must come before the catch-all default. Checked chips take
    the strong "selected" fill; the rest sit on the card surface so they read as unselected options.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorSelectedContainer" android:state_checked="true" />
    <item android:color="?attr/colorSurface" />
</selector>
