<?xml version="1.0" encoding="utf-8"?>
<!--
    Outline of the "PINNED" toggle on the Places tab's featured card.

    Pinned, the outline strengthens to full text colour, so the toggle's state is visible in the
    button's shape as well as in its label — colour and wording alone would both be lost on a user who
    cannot see one or read the other. Unpinned it is the faint outline every other outlined control in
    the app uses. The checked item comes first because a selector takes the first match.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnSurface" android:state_checked="true" />
    <item android:color="?attr/colorOutlineVariant" />
</selector>
