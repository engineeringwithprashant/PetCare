<?xml version="1.0" encoding="utf-8"?>
<!-- Outline of a Tasks-tab filter chip. An unselected chip needs a faint edge to be seen against the
     cream page; a selected one is already a solid fill, so its outline matches the fill and
     disappears rather than drawing a second edge around it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorSelectedContainer" android:state_checked="true" />
    <item android:color="?attr/colorOutlineVariant" />
</selector>
