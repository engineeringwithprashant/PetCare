<?xml version="1.0" encoding="utf-8"?>
<!--
    The text on a reset option card's badge — the partner of auth_option_badge_background.xml. On the
    accent it must be the accent's own "on" colour (near-black in both themes, since the accent never
    changes); on the neutral square it is the theme's normal text colour.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:color="@color/on_accent_yellow" android:state_checked="true" />

    <item android:color="?attr/colorOnSurface" />

</selector>
