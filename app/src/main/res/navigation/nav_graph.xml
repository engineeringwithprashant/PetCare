<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's navigation graph: a single place describing every screen and every route between
    them. The NavHostFragment in activity_main.xml hosts this graph and swaps fragments in and
    out, which is why the app needs only one Activity.

    Declaring routes here rather than calling FragmentTransactions by hand means the back stack,
    animations and argument passing are all handled consistently, and the whole flow can be seen
    at a glance in Android Studio's design view.

    **The shape of the graph.** It is in two halves.

    *Authentication* — authFragment (log in and register, one screen with a toggle), the two-factor
    check, and the three password-reset steps. The graph starts at authFragment, and every route from
    here into the app clears the whole graph behind it so that "back" from the app cannot return to a
    form the user has already completed.

    *The signed-in app* — five **top-level** destinations (homeFragment, petsFragment,
    checklistFragment, placesFragment, expensesFragment), each matching an item in
    res/menu/bottom_nav_menu.xml by id, plus the detail and form screens reached from them. Top-level
    here has a precise meaning: these five are peers of one another rather than ancestors, so moving between them is a switch
    and not a journey — which is why none of them shows a back arrow and why none has an `action`
    pointing at another. NavigationUI moves between them from the bottom bar alone.

    **Which destinations carry a userId, and which do not.** None of them. The signed-in account
    used to be a navigation argument on the home screen, but a bottom bar navigates by destination
    id with no arguments attached, so the tabs could never have been handed one. The account is
    held instead by SessionViewModel, scoped to the Activity and therefore shared by every screen —
    see that class for why it survives both rotation and the process being killed.

    **checklistFragment and expensesFragment serve two jobs each.** Reached from the bottom bar they
    arrive with no arguments, default `petId` to NO_PET_ID, and show a row of pet chips to choose
    between. Reached from a pet's detail screen they arrive with a real `petId` and show that pet
    alone. One screen with a conditional rather than two near-identical ones — which is what keeps
    delegation, shake-to-reset and swipe-to-delete existing in exactly one place.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <!--
        ======================== Global actions ========================

        An action declared as a direct child of <navigation> rather than of a <fragment> is a **global
        action**: it can be taken from any destination in the graph. That is exactly what the profile
        screen needs — the app's monogram in the shared header opens it, and seven different screens
        draw that header. Seven ordinary actions would say the same thing seven times and give seven
        chances for one to drift out of step.

        Nothing is popped. The profile screen is a step sideways out of whichever tab the user is on,
        like the assistant and the notifications screen, so back returns them to where they were.
    -->
    <action
        android:id="@+id/action_global_to_profile"
        app:destination="@id/profileFragment" />

    <!-- ============================== Authentication ============================== -->

    <!-- Log in / register. Entry point of the app. The two forms are one destination with a toggle,
         so switching between them is not navigation at all and adds nothing to the back stack. -->
    <fragment
        android:id="@+id/authFragment"
        android:name="com.prash.petcare.ui.auth.AuthFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_auth">

        <!-- Successful log in or sign-up.

             popUpTo the graph itself with popUpToInclusive removes every auth screen from the
             back stack. Without it, pressing back from the home screen would return the user to
             the form they have just completed, which looks like being signed out. -->
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <!-- The password was right but the account needs its second factor. An ordinary forward step:
             back (or "use a different account") returns here with the form as it was. -->
        <action
            android:id="@+id/action_auth_to_two_factor"
            app:destination="@id/twoFactorFragment" />

        <!-- "FORGOT PASSWORD?" starts the three reset steps. -->
        <action
            android:id="@+id/action_auth_to_reset_choose"
            app:destination="@id/resetChooseFragment" />
    </fragment>

    <!-- Two-factor check: step 2 of logging in. The account is not signed in until this screen says
         so, which is why its id travels as an argument rather than through SessionViewModel. -->
    <fragment
        android:id="@+id/twoFactorFragment"
        android:name="com.prash.petcare.ui.auth.twofactor.TwoFactorFragment"
        android:label="@string/two_factor_title"
        tools:layout="@layout/fragment_two_factor">

        <argument
            android:name="userId"
            app:argType="long" />

        <!-- Code accepted: into the app, clearing the auth screens as on log in. -->
        <action
            android:id="@+id/action_two_factor_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Reset step 1: choose where the code goes and type the account's email or phone number. Takes
         no arguments — the field starts empty. "BACK TO LOG IN" on each reset step pops back to
         authFragment rather than navigating to it, so no second log in screen is stacked. -->
    <fragment
        android:id="@+id/resetChooseFragment"
        android:name="com.prash.petcare.ui.auth.reset.ResetChooseFragment"
        android:label="@string/reset_choose_title"
        tools:layout="@layout/fragment_reset_choose">

        <action
            android:id="@+id/action_reset_choose_to_reset_code"
            app:destination="@id/resetCodeFragment" />
    </fragment>

    <!-- Reset step 2: enter the code. -->
    <fragment
        android:id="@+id/resetCodeFragment"
        android:name="com.prash.petcare.ui.auth.reset.ResetCodeFragment"
        android:label="@string/reset_code_title"
        tools:layout="@layout/fragment_reset_code">

        <!-- The ResetChannel name: EMAIL or SMS. -->
        <argument
            android:name="channel"
            app:argType="string" />

        <!-- The address (as typed) or masked number to name on screen. Nullable only as a safety net:
             step 1 always supplies it, and step 2 falls back to "your email" / "your phone". -->
        <argument
            android:name="destination"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <!-- Code accepted: on to step 3. This screen is popped on the way, because a code can only be
             used once — back from step 3 should offer to send a new code (step 1), not to retype a
             spent one. -->
        <action
            android:id="@+id/action_reset_code_to_new_password"
            app:destination="@id/resetNewPasswordFragment"
            app:popUpTo="@id/resetCodeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Reset step 3: choose the new password.
         TODO(reset-backend): add a required `resetToken` argument once step 2 receives one. -->
    <fragment
        android:id="@+id/resetNewPasswordFragment"
        android:name="com.prash.petcare.ui.auth.reset.ResetNewPasswordFragment"
        android:label="@string/reset_password_title"
        tools:layout="@layout/fragment_reset_new_password" />

    <!-- ========================= Top-level: the bottom bar =========================
         These five are the bottom navigation bar's destinations. They are listed here in the same
         order as res/menu/bottom_nav_menu.xml, and each id matches an item there — see the note at
         the top of that file for why the ids have to agree. -->

    <!-- Tab 1. The dashboard: greeting, clock and sync status, three stat cards, the next task,
         today's care and streak, the pets, an insight, the week ahead and quick actions. -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.prash.petcare.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">

        <!-- Tapping a pet card opens its detail screen. -->
        <action
            android:id="@+id/action_home_to_pet_detail"
            app:destination="@id/petDetailFragment" />

        <!-- The "Add pet" quick action and the empty state open an empty pet form. -->
        <action
            android:id="@+id/action_home_to_add_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <!-- A "coming up this week" row opens the routine its task belongs to — the screen where that
             task can be seen alongside its siblings, edited or rescheduled. -->
        <action
            android:id="@+id/action_home_to_routine_detail"
            app:destination="@id/routineDetailFragment" />

        <!-- The "Ask the assistant" button and the header's AI pill both open the assistant. -->
        <action
            android:id="@+id/action_home_to_assistant"
            app:destination="@id/assistantFragment" />
    </fragment>

    <!--
        The assistant. Reached from the dashboard rather than from the bottom bar, so it has no tab
        of its own — which is deliberate: it is a thing you go and ask, not a section of the app you
        live in. Because no bottom-navigation item shares its id, NavigationUI leaves whichever tab
        was selected (Home) highlighted while it is open, which is the right reading: the user has
        stepped sideways out of Home, not into a sixth tab.

        It draws the shared header rather than the app bar, like the tabs and the pet detail screen —
        see MainActivity.updateChromeFor.
    -->
    <fragment
        android:id="@+id/assistantFragment"
        android:name="com.prash.petcare.ui.assistant.AssistantFragment"
        android:label="@string/nav_assistant"
        tools:layout="@layout/fragment_assistant" />

    <!-- Tab 2. Every pet the user has, and the way in to adding another. -->
    <fragment
        android:id="@+id/petsFragment"
        android:name="com.prash.petcare.ui.pet.PetsFragment"
        android:label="@string/nav_pets"
        tools:layout="@layout/fragment_pets">

        <!-- The "+ Add a pet" row at the end of the list (or in the empty state) goes straight to an
             empty form, passing petId = -1. -->
        <action
            android:id="@+id/action_pets_to_add_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <!-- Tapping a pet opens its detail screen rather than the edit form: viewing an animal and
             changing its record are different intentions, and the detail screen is also the way in
             to that pet's routines. -->
        <action
            android:id="@+id/action_pets_to_pet_detail"
            app:destination="@id/petDetailFragment" />
    </fragment>

    <!-- Tab 3. Today's care checklist. Also reachable from a pet's detail screen — see the note at
         the top of this file on why one destination serves both. -->
    <fragment
        android:id="@+id/checklistFragment"
        android:name="com.prash.petcare.ui.checklist.ChecklistFragment"
        android:label="@string/nav_tasks"
        tools:layout="@layout/fragment_checklist">

        <!-- Which pet to show. The default of -1 means "none chosen", which is how the screen knows
             it arrived from the bottom bar and should offer the pet chips. Long literals in a nav
             graph need the L suffix, or the value is parsed as an Int and rejected. -->
        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- "+ Add task" opens the existing task form for a routine the user picks, passing
             taskId = -1. Routines themselves are still created only from a pet's detail page. -->
        <action
            android:id="@+id/action_checklist_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />

        <!-- Who to delegate today's care to, sent by tapping a saved contact on the profile screen.

             Both are nullable and default to null, so every other route into this screen is
             unaffected and simply arrives with no recipient chosen. When they *are* supplied, the
             screen skips the channel dialog and the system contact picker and goes straight to the
             confirmation preview — the contact has already been chosen, and asking again would be
             asking a question the user has just answered. The message is still never sent without
             that confirmation. -->
        <argument
            android:name="delegateToName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="delegateToPhone"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Tab 4. The user's saved vets, groomers, parks and shops, laid out by distance from home, with
         directions handed off to a maps app. Takes no arguments: places belong to the account, which
         comes from SessionViewModel like every other tab's. -->
    <fragment
        android:id="@+id/placesFragment"
        android:name="com.prash.petcare.ui.place.PlacesFragment"
        android:label="@string/nav_places"
        tools:layout="@layout/fragment_places">

        <!-- "+ Add a place" passes placeId = -1; a long press on a saved place passes its real id. -->
        <action
            android:id="@+id/action_places_to_add_edit_place"
            app:destination="@id/addEditPlaceFragment" />

        <!-- "Book a visit" opens the ordinary task form, prefilled with the place — see the prefill
             arguments on addEditTaskFragment below. -->
        <action
            android:id="@+id/action_places_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />
    </fragment>

    <!-- Tab 5. One pet's spending: the total, the breakdown by category, and every recorded
         expense. Reached the same two ways as the checklist above. -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.prash.petcare.ui.expense.ExpensesFragment"
        android:label="@string/nav_money"
        tools:layout="@layout/fragment_expenses">

        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- One action serves both recording and editing: the floating action button passes
             expenseId = -1, and tapping an expense in the list passes its real id. -->
        <action
            android:id="@+id/action_expenses_to_add_edit_expense"
            app:destination="@id/addEditExpenseFragment" />
    </fragment>

    <!-- ============================== Account screens ============================== -->

    <!--
        The signed-in account: who they are, how the app behaves for them, and the way out.

        **Reached from the app's monogram** in the shared header, through the global action at the top
        of this file, from every screen that draws that header. The toolbar's overflow menu still
        leads here as well, for the screens that show a toolbar instead.

        Like the assistant and the notifications screen it is not a tab and has no bottom-bar item of
        its own, so NavigationUI leaves whichever tab the user came from highlighted while it is open:
        opening and closing it cannot move them between tabs. It draws the shared header rather than
        the app bar — see MainActivity.updateChromeFor.
    -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.prash.petcare.ui.profile.ProfileFragment"
        android:label="@string/menu_profile"
        tools:layout="@layout/fragment_profile">

        <!-- The "EDIT" pill on the "Name & details" row: the form for the account's own name, phone
             number and role. -->
        <action
            android:id="@+id/action_profile_to_account_details"
            app:destination="@id/accountDetailsFragment" />

        <!-- The "UPDATE" pill on the "Change password" row. -->
        <action
            android:id="@+id/action_profile_to_change_password"
            app:destination="@id/changePasswordFragment" />

        <!-- Tapping a saved delegation contact opens the Tasks tab with that person already chosen,
             so the checklist goes straight to its confirmation preview — see the two prefill
             arguments on checklistFragment. No petId is passed, so the checklist arrives at its
             default of -1 and offers the pet chips exactly as it does from the bottom bar. -->
        <action
            android:id="@+id/action_profile_to_checklist"
            app:destination="@id/checklistFragment" />

        <!-- The header's AI pill, which this screen shows as the dashboard does. -->
        <action
            android:id="@+id/action_profile_to_assistant"
            app:destination="@id/assistantFragment" />
    </fragment>

    <!-- Edit the signed-in account's own name, contact number and role. The email is deliberately not
         editable here — it is the login identifier and the key the Firestore sync files this account's
         data under, so changing it would strand everything already uploaded. See UserRepository. -->
    <fragment
        android:id="@+id/accountDetailsFragment"
        android:name="com.prash.petcare.ui.profile.AccountDetailsFragment"
        android:label="@string/account_details_title"
        tools:layout="@layout/fragment_account_details" />

    <!-- Set a new password, after confirming the current one. Takes no arguments: the account is the
         signed-in one, read from SessionViewModel like every other screen's. -->
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.prash.petcare.ui.profile.ChangePasswordFragment"
        android:label="@string/change_password_title"
        tools:layout="@layout/fragment_change_password" />

    <!--
        Everything the app has noticed about the user's pets: care coming up, care that was missed,
        recent activity, milestones and tips.

        Reached from the pet-count badge in the header the tabs, the pet detail screen and the
        assistant all share — from seven screens, by destination id, with no arguments. Like the
        assistant it is not a tab and has no bottom-bar item of its own, so NavigationUI leaves
        whichever tab the user came from highlighted while it is open: opening and closing it cannot
        move them between tabs.

        It draws the shared header rather than the app bar, like the tabs, the pet detail screen and
        the assistant — see MainActivity.updateChromeFor.

        Nothing here is stored. Every alert is derived from tasks, routines, expenses and pet records
        on the fly — see ui/notifications/NotificationsViewModel.kt — which is why this destination
        takes no arguments at all: there is no alert id to pass, because there are no alert rows.
    -->
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.prash.petcare.ui.notifications.NotificationsFragment"
        android:label="@string/nav_notifications"
        tools:layout="@layout/fragment_notifications">

        <!-- Tapping an alert about the animal itself — a milestone, recent activity, a tip — opens
             that pet's detail screen. -->
        <action
            android:id="@+id/action_notifications_to_pet_detail"
            app:destination="@id/petDetailFragment" />

        <!-- Tapping an alert about care — a reminder or a missed task — opens the Tasks tab.

             No petId is passed, so the checklist arrives at its default of -1 and shows the pet chips,
             exactly as it does from the bottom bar; NavigationUI highlights the Tasks tab because the
             destination ids match. See the note at the top of this file on that screen's two jobs. -->
        <action
            android:id="@+id/action_notifications_to_checklist"
            app:destination="@id/checklistFragment" />

        <!-- The header's AI pill, which this screen shows as the dashboard does. -->
        <action
            android:id="@+id/action_notifications_to_assistant"
            app:destination="@id/assistantFragment" />
    </fragment>

    <!-- ========================== Detail and form screens ==========================
         Everything below is pushed *on top of* a tab rather than being one, so each shows a back
         arrow and returns to wherever it was opened from. -->

    <!-- A single pet: its photo card, details and care routines. It draws its own header and back
         button over the photo, so MainActivity hides the shared app bar here — see
         MainActivity.updateChromeFor. -->
    <fragment
        android:id="@+id/petDetailFragment"
        android:name="com.prash.petcare.ui.pet.PetDetailFragment"
        android:label="@string/nav_label_pet"
        tools:layout="@layout/fragment_pet_detail">

        <argument
            android:name="petId"
            app:argType="long" />

        <action
            android:id="@+id/action_pet_detail_to_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <action
            android:id="@+id/action_pet_detail_to_add_routine"
            app:destination="@id/addRoutineFragment" />

        <action
            android:id="@+id/action_pet_detail_to_routine_detail"
            app:destination="@id/routineDetailFragment" />

        <!-- Opens the checklist scoped to this pet, by passing a real petId — which is what
             suppresses the pet chips the tab version shows. -->
        <action
            android:id="@+id/action_pet_detail_to_checklist"
            app:destination="@id/checklistFragment" />

        <action
            android:id="@+id/action_pet_detail_to_expenses"
            app:destination="@id/expensesFragment" />
    </fragment>

    <!-- Record a new expense against a pet, or change an existing one. -->
    <fragment
        android:id="@+id/addEditExpenseFragment"
        android:name="com.prash.petcare.ui.expense.AddEditExpenseFragment"
        android:label="@string/add_expense_title"
        tools:layout="@layout/fragment_add_edit_expense">

        <!-- Required, with no default: an expense with no pet would violate the foreign key on the
             expenses table. -->
        <argument
            android:name="petId"
            app:argType="long" />

        <!-- Which expense to edit. The default of -1 means "none", which is how the screen knows it
             is recording a new expense rather than changing one. -->
        <argument
            android:name="expenseId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Create a care routine for a pet, or edit one. The pet detail screen reaches it both ways
         through the single action_pet_detail_to_add_routine: its "+" button passes only the pet, and
         the "Edit" item on a routine card's menu passes the routine's id as well. -->
    <fragment
        android:id="@+id/addRoutineFragment"
        android:name="com.prash.petcare.ui.routine.AddRoutineFragment"
        android:label="@string/add_routine_title"
        tools:layout="@layout/fragment_add_routine">

        <argument
            android:name="petId"
            app:argType="long" />

        <!-- Which routine to edit. The default of -1 means "none", which is how the screen knows it
             is creating a routine rather than changing one — the same convention as the pet, task and
             expense forms. -->
        <argument
            android:name="routineId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- A single routine and the care tasks inside it. -->
    <fragment
        android:id="@+id/routineDetailFragment"
        android:name="com.prash.petcare.ui.routine.RoutineDetailFragment"
        android:label="@string/nav_label_routine"
        tools:layout="@layout/fragment_routine_detail">

        <argument
            android:name="routineId"
            app:argType="long" />

        <!-- One action serves both adding and editing: the floating action button passes
             taskId = -1, and tapping a task in the list passes its real id. -->
        <action
            android:id="@+id/action_routine_detail_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />
    </fragment>

    <!-- Create or edit a care task within a routine. -->
    <fragment
        android:id="@+id/addEditTaskFragment"
        android:name="com.prash.petcare.ui.task.AddEditTaskFragment"
        android:label="@string/add_task_title"
        tools:layout="@layout/fragment_add_edit_task">

        <!-- The pet is read from the routine rather than passed separately, so the two can never
             disagree about which animal a task belongs to. -->
        <argument
            android:name="routineId"
            app:argType="long" />

        <!-- Which task to edit. The default of -1 means "none", which is how the screen knows it
             is creating a new task rather than changing one. -->
        <argument
            android:name="taskId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- Suggested starting values for a *new* task, sent by "Book a visit" on the Places tab.
             All three are nullable and default to null, so every other route into this form is
             unaffected and simply gets an empty form. The category travels as the enum's name, the
             same text the database stores. -->
        <argument
            android:name="prefillTitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="prefillNotes"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="prefillCategory"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Save a new place with its GPS geotag, or change or delete a saved one. -->
    <fragment
        android:id="@+id/addEditPlaceFragment"
        android:name="com.prash.petcare.ui.place.AddEditPlaceFragment"
        android:label="@string/add_place_title"
        tools:layout="@layout/fragment_add_edit_place">

        <!-- Which place to edit. The default of -1 means "none" — creating a new place. The owner is
             not an argument: it is the signed-in account, read from SessionViewModel. -->
        <argument
            android:name="placeId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Create or edit a pet. -->
    <fragment
        android:id="@+id/addEditPetFragment"
        android:name="com.prash.petcare.ui.pet.AddEditPetFragment"
        android:label="@string/add_pet_title"
        tools:layout="@layout/fragment_add_edit_pet">

        <!-- Which pet to edit. The default of -1 means "none", which is how the screen knows it is
             creating a new pet rather than changing one. Long literals in a nav graph need the L
             suffix, or the value is parsed as an Int and rejected. -->
        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- Who will own a newly created pet. Required, with no default: a pet with no owner
             would violate the foreign key on the pets table. -->
        <argument
            android:name="ownerId"
            app:argType="long" />
    </fragment>

</navigation>
