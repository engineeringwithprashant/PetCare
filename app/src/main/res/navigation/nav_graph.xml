<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's navigation graph: a single place describing every screen and every route between
    them. The NavHostFragment in activity_main.xml hosts this graph and swaps fragments in and
    out, which is why the app needs only one Activity.

    Declaring routes here rather than calling FragmentTransactions by hand means the back stack,
    animations and argument passing are all handled consistently, and the whole flow can be seen
    at a glance in Android Studio's design view.

    app:startDestination is the screen shown when the app opens — the login screen.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Sign-in screen. Entry point of the app. -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.prash.petcare.ui.auth.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">

        <!-- "New here? Create an account" — an ordinary forward navigation, so pressing back
             returns to the login screen. -->
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <!-- Successful sign-in.

             popUpTo the graph itself with popUpToInclusive removes every auth screen from the
             back stack. Without it, pressing back from the home screen would return the user to
             the login form they have just completed, which looks like being signed out. -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Account creation screen. Always reached from the login screen, so its "already have an
         account" link simply navigates back up rather than needing an action of its own. -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.prash.petcare.ui.auth.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register">

        <!-- Successful sign-up signs the new user straight in, clearing the auth stack for the
             same reason as the login action above. -->
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Placeholder landing screen shown once the user is authenticated. Pet management will be
         built here next. -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.prash.petcare.ui.home.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home">

        <!-- Which account is signed in. Declaring it here makes the requirement explicit: the
             home screen cannot be reached without someone supplying a user id. -->
        <argument
            android:name="userId"
            app:argType="long" />

        <!-- The floating action button goes straight to an empty form, passing petId = -1. -->
        <action
            android:id="@+id/action_home_to_add_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <!-- Tapping a pet opens its detail screen rather than the edit form: viewing an animal and
             changing its record are different intentions, and the detail screen is also the way in
             to that pet's routines and checklist. -->
        <action
            android:id="@+id/action_home_to_pet_detail"
            app:destination="@id/petDetailFragment" />
    </fragment>

    <!-- A single pet: its details, plus the care routines set up for it. -->
    <fragment
        android:id="@+id/petDetailFragment"
        android:name="com.prash.petcare.ui.pet.PetDetailFragment"
        android:label="@string/nav_label_pet"
        tools:layout="@layout/fragment_pet_detail">

        <argument
            android:name="petId"
            app:argType="long" />

        <action
            android:id="@+id/action_pet_detail_to_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <action
            android:id="@+id/action_pet_detail_to_add_routine"
            app:destination="@id/addRoutineFragment" />

        <action
            android:id="@+id/action_pet_detail_to_routine_detail"
            app:destination="@id/routineDetailFragment" />

        <action
            android:id="@+id/action_pet_detail_to_checklist"
            app:destination="@id/checklistFragment" />

        <action
            android:id="@+id/action_pet_detail_to_expenses"
            app:destination="@id/expensesFragment" />
    </fragment>

    <!-- One pet's spending: the total, the breakdown by category, and every recorded expense. -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.prash.petcare.ui.expense.ExpensesFragment"
        android:label="@string/nav_label_expenses"
        tools:layout="@layout/fragment_expenses">

        <argument
            android:name="petId"
            app:argType="long" />

        <!-- One action serves both recording and editing: the floating action button passes
             expenseId = -1, and tapping an expense in the list passes its real id. -->
        <action
            android:id="@+id/action_expenses_to_add_edit_expense"
            app:destination="@id/addEditExpenseFragment" />
    </fragment>

    <!-- Record a new expense against a pet, or change an existing one. -->
    <fragment
        android:id="@+id/addEditExpenseFragment"
        android:name="com.prash.petcare.ui.expense.AddEditExpenseFragment"
        android:label="@string/add_expense_title"
        tools:layout="@layout/fragment_add_edit_expense">

        <!-- Required, with no default: an expense with no pet would violate the foreign key on the
             expenses table. -->
        <argument
            android:name="petId"
            app:argType="long" />

        <!-- Which expense to edit. The default of -1 means "none", which is how the screen knows it
             is recording a new expense rather than changing one. Long literals in a nav graph need
             the L suffix, or the value is parsed as an Int and rejected. -->
        <argument
            android:name="expenseId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Create a care routine for a pet. -->
    <fragment
        android:id="@+id/addRoutineFragment"
        android:name="com.prash.petcare.ui.routine.AddRoutineFragment"
        android:label="@string/add_routine_title"
        tools:layout="@layout/fragment_add_routine">

        <argument
            android:name="petId"
            app:argType="long" />
    </fragment>

    <!-- A single routine and the care tasks inside it. -->
    <fragment
        android:id="@+id/routineDetailFragment"
        android:name="com.prash.petcare.ui.routine.RoutineDetailFragment"
        android:label="@string/nav_label_routine"
        tools:layout="@layout/fragment_routine_detail">

        <argument
            android:name="routineId"
            app:argType="long" />

        <!-- One action serves both adding and editing: the floating action button passes
             taskId = -1, and tapping a task in the list passes its real id. -->
        <action
            android:id="@+id/action_routine_detail_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />
    </fragment>

    <!-- Create or edit a care task within a routine. -->
    <fragment
        android:id="@+id/addEditTaskFragment"
        android:name="com.prash.petcare.ui.task.AddEditTaskFragment"
        android:label="@string/add_task_title"
        tools:layout="@layout/fragment_add_edit_task">

        <!-- The pet is read from the routine rather than passed separately, so the two can never
             disagree about which animal a task belongs to. -->
        <argument
            android:name="routineId"
            app:argType="long" />

        <!-- Which task to edit. The default of -1 means "none", which is how the screen knows it
             is creating a new task rather than changing one. -->
        <argument
            android:name="taskId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Today's care checklist for one pet. -->
    <fragment
        android:id="@+id/checklistFragment"
        android:name="com.prash.petcare.ui.checklist.ChecklistFragment"
        android:label="@string/pet_detail_checklist"
        tools:layout="@layout/fragment_checklist">

        <argument
            android:name="petId"
            app:argType="long" />
    </fragment>

    <!-- Create or edit a pet. -->
    <fragment
        android:id="@+id/addEditPetFragment"
        android:name="com.prash.petcare.ui.pet.AddEditPetFragment"
        android:label="@string/add_pet_title"
        tools:layout="@layout/fragment_add_edit_pet">

        <!-- Which pet to edit. The default of -1 means "none", which is how the screen knows it is
             creating a new pet rather than changing one. Long literals in a nav graph need the L
             suffix, or the value is parsed as an Int and rejected. -->
        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- Who will own a newly created pet. Required, with no default: a pet with no owner
             would violate the foreign key on the pets table. -->
        <argument
            android:name="ownerId"
            app:argType="long" />
    </fragment>

</navigation>
