<?xml version="1.0" encoding="utf-8"?>
<!-- The app's navigation graph: a single place describing every screen and every route between them. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <!-- ======================== Global actions ======================== -->
    <action
        android:id="@+id/action_global_to_profile"
        app:destination="@id/profileFragment" />

    <!-- ============================== Authentication ============================== -->

    <!-- Log in / register. Entry point of the app. The two forms are one destination with a toggle. -->
    <fragment
        android:id="@+id/authFragment"
        android:name="com.prash.petcare.ui.auth.AuthFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_auth">

        <!-- Successful log in or sign-up. -->
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <!-- The password was right but the account needs its second factor. -->
        <action
            android:id="@+id/action_auth_to_two_factor"
            app:destination="@id/twoFactorFragment" />

        <!-- "FORGOT PASSWORD?" opens the email password reset. -->
        <action
            android:id="@+id/action_auth_to_reset_request"
            app:destination="@id/resetRequestFragment" />
    </fragment>

    <!-- Two-factor check: step 2 of logging in. The account is not signed in until this screen says. -->
    <fragment
        android:id="@+id/twoFactorFragment"
        android:name="com.prash.petcare.ui.auth.twofactor.TwoFactorFragment"
        android:label="@string/two_factor_title"
        tools:layout="@layout/fragment_two_factor">

        <argument
            android:name="userId"
            app:argType="long" />

        <!-- Code accepted: into the app, clearing the auth screens as on log in. -->
        <action
            android:id="@+id/action_two_factor_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <!-- "LOST ACCESS?" — enter a recovery code instead. An ordinary forward step. -->
        <action
            android:id="@+id/action_two_factor_to_recovery_code"
            app:destination="@id/recoveryCodeFragment" />
    </fragment>

    <!-- Recovery code entry: the way in when the authenticator app is gone. -->
    <fragment
        android:id="@+id/recoveryCodeFragment"
        android:name="com.prash.petcare.ui.auth.twofactor.RecoveryCodeFragment"
        android:label="@string/recovery_code_title"
        tools:layout="@layout/fragment_recovery_code">

        <argument
            android:name="userId"
            app:argType="long" />

        <!-- Code accepted: into the app, clearing every auth screen. -->
        <action
            android:id="@+id/action_recovery_code_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Password reset: type the account's email and ask Firebase for a reset link. -->
    <fragment
        android:id="@+id/resetRequestFragment"
        android:name="com.prash.petcare.ui.auth.reset.ResetRequestFragment"
        android:label="@string/reset_request_title"
        tools:layout="@layout/fragment_reset_request">

        <!-- Firebase accepted the request. The request screen stays on the back stack. -->
        <action
            android:id="@+id/action_reset_request_to_reset_sent"
            app:destination="@id/resetSentFragment" />
    </fragment>

    <!-- Reset confirmation: "a link has been sent", with a rate-limited resend. -->
    <fragment
        android:id="@+id/resetSentFragment"
        android:name="com.prash.petcare.ui.auth.reset.ResetSentFragment"
        android:label="@string/reset_sent_title"
        tools:layout="@layout/fragment_reset_sent">

        <!-- The address the link went to, as typed. Required: the screen names it and resends to it. -->
        <argument
            android:name="email"
            app:argType="string" />
    </fragment>

    <!-- ========================= Top-level: the bottom bar ========================= -->

    <!-- Tab 1. The dashboard: greeting, clock and sync status, three stat cards, the next task. -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.prash.petcare.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">

        <!-- Tapping a pet card opens its detail screen. -->
        <action
            android:id="@+id/action_home_to_pet_detail"
            app:destination="@id/petDetailFragment" />

        <!-- The "Add pet" quick action and the empty state open an empty pet form. -->
        <action
            android:id="@+id/action_home_to_add_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <!-- A "coming up this week" row opens the routine its task belongs. -->
        <action
            android:id="@+id/action_home_to_routine_detail"
            app:destination="@id/routineDetailFragment" />

        <!-- The "Ask the assistant" button and the header's AI pill both open the assistant. -->
        <action
            android:id="@+id/action_home_to_assistant"
            app:destination="@id/assistantFragment" />
    </fragment>

    <!-- The assistant. Reached from the dashboard rather than from the bottom bar, so it has no tab of its own. -->
    <fragment
        android:id="@+id/assistantFragment"
        android:name="com.prash.petcare.ui.assistant.AssistantFragment"
        android:label="@string/nav_assistant"
        tools:layout="@layout/fragment_assistant" />

    <!-- Tab 2. Every pet the user has, and the way in to adding another. -->
    <fragment
        android:id="@+id/petsFragment"
        android:name="com.prash.petcare.ui.pet.PetsFragment"
        android:label="@string/nav_pets"
        tools:layout="@layout/fragment_pets">

        <!-- The "+ Add a pet" row at the end of the list (or in the empty state) goes straight to an empty form. -->
        <action
            android:id="@+id/action_pets_to_add_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <!-- Tapping a pet opens its detail screen rather than the edit form. -->
        <action
            android:id="@+id/action_pets_to_pet_detail"
            app:destination="@id/petDetailFragment" />
    </fragment>

    <!-- Tab 3. Today's care checklist. Also reachable from a pet's detail screen. -->
    <fragment
        android:id="@+id/checklistFragment"
        android:name="com.prash.petcare.ui.checklist.ChecklistFragment"
        android:label="@string/nav_tasks"
        tools:layout="@layout/fragment_checklist">

        <!-- Which pet to show. The default of -1 means "none chosen". -->
        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- "+ Add task" opens the existing task form for a routine the user picks, passing taskId = -1. -->
        <action
            android:id="@+id/action_checklist_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />

        <!-- Who to delegate today's care to, sent by tapping a saved contact on the profile screen. -->
        <argument
            android:name="delegateToName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="delegateToPhone"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Tab 4. The user's saved vets, groomers, parks and shops, laid out by distance from home. -->
    <fragment
        android:id="@+id/placesFragment"
        android:name="com.prash.petcare.ui.place.PlacesFragment"
        android:label="@string/nav_places"
        tools:layout="@layout/fragment_places">

        <!-- A long press on a saved place opens the full form with its real id, to change or delete it. -->
        <action
            android:id="@+id/action_places_to_add_edit_place"
            app:destination="@id/addEditPlaceFragment" />

        <!-- "+ ADD PLACE" in the saved-places heading. Takes no arguments: the screen only ever creates. -->
        <action
            android:id="@+id/action_places_to_add_place"
            app:destination="@id/addPlaceFragment" />

        <!-- "Book a visit" opens the ordinary task form, prefilled with the place. -->
        <action
            android:id="@+id/action_places_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />
    </fragment>

    <!-- Tab 5. One pet's spending: the total, the breakdown by category, and every recorded expense. -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.prash.petcare.ui.expense.ExpensesFragment"
        android:label="@string/nav_money"
        tools:layout="@layout/fragment_expenses">

        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- One action serves both recording and editing: the floating action button passes expenseId = -1. -->
        <action
            android:id="@+id/action_expenses_to_add_edit_expense"
            app:destination="@id/addEditExpenseFragment" />
    </fragment>

    <!-- ============================== Account screens ============================== -->

    <!-- The signed-in account: who they are, how the app behaves for them, and the way out. -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.prash.petcare.ui.profile.ProfileFragment"
        android:label="@string/menu_profile"
        tools:layout="@layout/fragment_profile">

        <!-- The "EDIT" pill on the "Name & details" row: the form for the account's own name. -->
        <action
            android:id="@+id/action_profile_to_account_details"
            app:destination="@id/accountDetailsFragment" />

        <!-- The "UPDATE" pill on the "Change password" row. -->
        <action
            android:id="@+id/action_profile_to_change_password"
            app:destination="@id/changePasswordFragment" />

        <!-- Turning the two-factor switch on. Turning it off is a dialog on the profile screen itself and needs no route. -->
        <action
            android:id="@+id/action_profile_to_two_factor_setup"
            app:destination="@id/twoFactorSetupFragment" />

        <!-- Tapping a saved delegation contact opens the Tasks tab with that person already chosen. -->
        <action
            android:id="@+id/action_profile_to_checklist"
            app:destination="@id/checklistFragment" />

        <!-- The header's AI pill, which this screen shows as the dashboard does. -->
        <action
            android:id="@+id/action_profile_to_assistant"
            app:destination="@id/assistantFragment" />
    </fragment>

    <!-- Edit the signed-in account's own name, contact number and role. -->
    <fragment
        android:id="@+id/accountDetailsFragment"
        android:name="com.prash.petcare.ui.profile.AccountDetailsFragment"
        android:label="@string/account_details_title"
        tools:layout="@layout/fragment_account_details" />

    <!-- Set a new password, after confirming the current one. -->
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.prash.petcare.ui.profile.ChangePasswordFragment"
        android:label="@string/change_password_title"
        tools:layout="@layout/fragment_change_password" />

    <!-- Two-factor setup, step 1 and 2: scan the QR code, then type a code back to prove the scan worked. -->
    <fragment
        android:id="@+id/twoFactorSetupFragment"
        android:name="com.prash.petcare.ui.auth.twofactor.TwoFactorSetupFragment"
        android:label="@string/two_factor_setup_title"
        tools:layout="@layout/fragment_two_factor_setup">

        <!-- Step 3: the recovery codes, shown once. The setup screen stays on the back stack. -->
        <action
            android:id="@+id/action_two_factor_setup_to_recovery_codes"
            app:destination="@id/recoveryCodesFragment" />
    </fragment>

    <!-- The ten recovery codes, shown once at the end of setup. -->
    <fragment
        android:id="@+id/recoveryCodesFragment"
        android:name="com.prash.petcare.ui.auth.twofactor.RecoveryCodesFragment"
        android:label="@string/recovery_codes_title"
        tools:layout="@layout/fragment_recovery_codes">

        <argument
            android:name="secret"
            app:argType="string" />

        <argument
            android:name="codes"
            app:argType="string[]" />
    </fragment>

    <!-- Everything the app has noticed about the user's pets: care coming up, care that was missed. -->
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.prash.petcare.ui.notifications.NotificationsFragment"
        android:label="@string/nav_notifications"
        tools:layout="@layout/fragment_notifications">

        <!-- Tapping an alert about the animal itself — a milestone, recent activity, a tip. -->
        <action
            android:id="@+id/action_notifications_to_pet_detail"
            app:destination="@id/petDetailFragment" />

        <!-- Tapping an alert about care — a reminder or a missed task — opens the Tasks tab. -->
        <action
            android:id="@+id/action_notifications_to_checklist"
            app:destination="@id/checklistFragment" />

        <!-- The header's AI pill, which this screen shows as the dashboard does. -->
        <action
            android:id="@+id/action_notifications_to_assistant"
            app:destination="@id/assistantFragment" />
    </fragment>

    <!-- ========================== Detail and form screens ========================== -->

    <!-- A single pet: its photo card, details and care routines. -->
    <fragment
        android:id="@+id/petDetailFragment"
        android:name="com.prash.petcare.ui.pet.PetDetailFragment"
        android:label="@string/nav_label_pet"
        tools:layout="@layout/fragment_pet_detail">

        <argument
            android:name="petId"
            app:argType="long" />

        <action
            android:id="@+id/action_pet_detail_to_edit_pet"
            app:destination="@id/addEditPetFragment" />

        <action
            android:id="@+id/action_pet_detail_to_add_routine"
            app:destination="@id/addRoutineFragment" />

        <action
            android:id="@+id/action_pet_detail_to_routine_detail"
            app:destination="@id/routineDetailFragment" />

        <!-- Opens the checklist scoped to this pet, by passing a real petId. -->
        <action
            android:id="@+id/action_pet_detail_to_checklist"
            app:destination="@id/checklistFragment" />

        <action
            android:id="@+id/action_pet_detail_to_expenses"
            app:destination="@id/expensesFragment" />

        <!-- "+ RECORD" on the vaccination card. One-way: the record screen always creates. -->
        <action
            android:id="@+id/action_pet_detail_to_add_vaccination"
            app:destination="@id/addVaccinationFragment" />
    </fragment>

    <!-- Record a vaccination the pet has already had, and track when the next one falls due. -->
    <fragment
        android:id="@+id/addVaccinationFragment"
        android:name="com.prash.petcare.ui.pet.AddVaccinationFragment"
        android:label="@string/record_vaccination_heading"
        tools:layout="@layout/fragment_add_vaccination">

        <!-- Required, with no default. -->
        <argument
            android:name="petId"
            app:argType="long" />
    </fragment>

    <!-- Record a new expense against a pet, or change an existing one. -->
    <fragment
        android:id="@+id/addEditExpenseFragment"
        android:name="com.prash.petcare.ui.expense.AddEditExpenseFragment"
        android:label="@string/add_expense_title"
        tools:layout="@layout/fragment_add_edit_expense">

        <!-- Required, with no default. -->
        <argument
            android:name="petId"
            app:argType="long" />

        <!-- Which expense to edit. The default of -1 means "none". -->
        <argument
            android:name="expenseId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Create a care routine for a pet. -->
    <fragment
        android:id="@+id/addRoutineFragment"
        android:name="com.prash.petcare.ui.routine.AddRoutineFragment"
        android:label="@string/add_routine_title"
        tools:layout="@layout/fragment_add_routine">

        <argument
            android:name="petId"
            app:argType="long" />

        <!-- Which routine to edit. The default of -1 means "none". -->
        <argument
            android:name="routineId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- A single routine and the care tasks inside it. -->
    <fragment
        android:id="@+id/routineDetailFragment"
        android:name="com.prash.petcare.ui.routine.RoutineDetailFragment"
        android:label="@string/nav_label_routine"
        tools:layout="@layout/fragment_routine_detail">

        <argument
            android:name="routineId"
            app:argType="long" />

        <!-- One action serves both adding and editing: the floating action button passes taskId = -1. -->
        <action
            android:id="@+id/action_routine_detail_to_add_edit_task"
            app:destination="@id/addEditTaskFragment" />
    </fragment>

    <!-- Create or edit a care task within a routine. -->
    <fragment
        android:id="@+id/addEditTaskFragment"
        android:name="com.prash.petcare.ui.task.AddEditTaskFragment"
        android:label="@string/add_task_title"
        tools:layout="@layout/fragment_add_edit_task">

        <!-- The pet is read from the routine rather than passed separately. -->
        <argument
            android:name="routineId"
            app:argType="long" />

        <!-- Which task to edit. The default of -1 means "none". -->
        <argument
            android:name="taskId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- Suggested starting values for a new task, sent by "Book a visit" on the Places tab. -->
        <argument
            android:name="prefillTitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="prefillNotes"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="prefillCategory"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Save a place from anywhere: by searching for it, by dropping a pin on the map. -->
    <fragment
        android:id="@+id/addPlaceFragment"
        android:name="com.prash.petcare.ui.place.AddPlaceFragment"
        android:label="@string/add_place_heading"
        tools:layout="@layout/fragment_add_place" />

    <!-- Change or delete a saved place, with its GPS geotag. -->
    <fragment
        android:id="@+id/addEditPlaceFragment"
        android:name="com.prash.petcare.ui.place.AddEditPlaceFragment"
        android:label="@string/add_place_title"
        tools:layout="@layout/fragment_add_edit_place">

        <!-- Which place to edit. The default of -1 means "none" — creating a new place. -->
        <argument
            android:name="placeId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- Create or edit a pet. -->
    <fragment
        android:id="@+id/addEditPetFragment"
        android:name="com.prash.petcare.ui.pet.AddEditPetFragment"
        android:label="@string/add_pet_title"
        tools:layout="@layout/fragment_add_edit_pet">

        <!-- Which pet to edit. The default of -1 means "none". -->
        <argument
            android:name="petId"
            android:defaultValue="-1L"
            app:argType="long" />

        <!-- Who will own a newly created pet. Required, with no default. -->
        <argument
            android:name="ownerId"
            app:argType="long" />
    </fragment>

</navigation>
