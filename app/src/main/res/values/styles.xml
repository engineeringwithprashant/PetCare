<!--
    Reusable widget styles.

    A style is a named bundle of attributes applied to one widget. These exist so a piece of the
    app's look is described once rather than having the same three or four attributes copied onto
    every TextView that plays the same part — and so changing how, say, a section heading looks
    means editing one block here instead of hunting through a dozen layouts.

    Kept apart from themes.xml on purpose: that file defines the app-wide *theme* (the palette every
    widget inherits), whereas these style individual widgets. The two meet where themes.xml points a
    *default* attribute such as materialCardViewStyle at a style below — which is how every card in
    the app picks up the rounded, elevated treatment without a single layout naming it.

    Every one of them takes its colours and text sizes from theme attributes rather than fixed
    values, so they follow the Material 3 type scale and adapt to dark mode automatically.

    Styles named "PetCare.*" set parent="" explicitly. A dot in a style name is Android's shorthand
    for inheritance, so "PetCare.SectionHeader" would otherwise be read as extending a style called
    "PetCare", which does not exist and fails the build. An empty parent says the dots are just
    namespacing. Styles that *do* extend a Material style name it as the parent instead, and so are
    free to use dots normally.
-->
<resources>

    <!-- ================================== Shapes ==================================
         The rounded-corner language, as shape appearances Material components can be pointed at.
         Declaring them here rather than setting cardCornerRadius per layout means the radius is
         defined once and a component's ripple, stroke and shadow all follow the same outline —
         setting a radius directly leaves the ripple square at the corners. -->

    <style name="ShapeAppearance.PetCare.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_sm</item>
    </style>

    <style name="ShapeAppearance.PetCare.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_md</item>
    </style>

    <style name="ShapeAppearance.PetCare.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_lg</item>
    </style>

    <!--
        The softest corner in the app, for the dashboard's three subject cards: today's care, and the
        two sizes of pet card.

        It exists as a shape appearance rather than as a bare `cardCornerRadius` on each of those
        layouts, and that is not belt and braces. Every MaterialCardView in the app picks up
        PetCare.Card from the theme by default, and that style names a shapeAppearance of its own —
        so a card setting only cardCornerRadius is asking two attributes for a different answer and
        getting whichever the component happens to resolve last. An **overlay** is applied on top of
        whatever shape the style supplied, which settles it.
    -->
    <style name="ShapeAppearance.PetCare.XLarge" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/pet_card_corner_radius</item>
    </style>

    <!--
        A circle, used to clip pet photos on the dashboard cards and the picker chips.

        The corner size is given as a *percentage* rather than in dp, which is what makes this one
        style work for a 64dp card thumbnail and a 24dp chip icon alike: 50% of the shorter edge is
        exactly the radius that turns any square into a circle. A fixed dp value would have to be
        kept in step with every size it is applied at.
    -->
    <style name="ShapeAppearance.PetCare.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- =================================== Cards ===================================
         The app's defining surface. PetCare.Card is wired into the theme as the default
         materialCardViewStyle, so *every* MaterialCardView in the app is rounded, white and softly
         shadowed without naming a style — which is what keeps a card added next year looking like
         the ones added today.

         Elevated rather than filled or outlined. On a cream page a white card with a soft shadow
         separates itself through depth, which survives dark mode: an outline would have to be
         redrawn to stay visible against a dark background, and a filled card would need a different
         tint. The shadow works either way. -->

    <style name="PetCare.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PetCare.Medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <!-- No stroke: the shadow already separates the card from the page, and drawing a border on
             top of it reads as the same edge described twice. -->
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- A full-width feature card — the dashboard's task list, the appointments panel. Takes the
         larger radius and a touch more lift, so it reads as a section of the page rather than as
         one row among several. -->
    <style name="PetCare.Card.Feature" parent="PetCare.Card">
        <item name="cardCornerRadius">@dimen/corner_radius_lg</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PetCare.Large</item>
        <item name="cardElevation">@dimen/card_elevation_raised</item>
    </style>

    <!-- A card the user can press. The only difference is the feedback: it lifts while held, which
         is what tells the user it is a control and not just a panel. Ripple and shadow both follow
         the rounded outline because the shape comes from the inherited shapeAppearance. -->
    <style name="PetCare.Card.Clickable" parent="PetCare.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- ================================= Typography =================================
         A small set of named roles covers the whole app. Using a role rather than picking a text
         appearance per screen is what keeps headings the same size everywhere. -->

    <!-- The dashboard greeting — the largest text in the app, and the only place it appears. -->
    <style name="PetCare.Greeting" parent="">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineMedium</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- A heading introducing a group within a screen, e.g. "Care routines". -->
    <style name="PetCare.SectionHeader" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!--
        The quieter kind of section heading: small, upper-case and widely letter-spaced — "YOUR
        PETS", with a count on the far right of the same line.

        Used where the heading's job is to *label* what follows rather than to introduce it. At this
        size the words carry almost no weight of their own, which is the point: the pet cards below
        are the subject, and a full-sized heading above them would compete. The letter-spacing is
        what keeps it legible once it is this small and capitalised — set solid, upper-case text at
        11sp reads as a grey smear.

        The same treatment as PetCare.DetailLabel further down, and deliberately so: both are saying
        "here is the name of the thing you are about to read".
    -->
    <style name="PetCare.SectionLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The dashboard's largest statement — "5 things left for today" — and the pet's name across a
         card photo. Bold and a step up from a section header, because on the redesigned dashboard
         these two lines are what the screen is *for*. The colour is left to the layout: one of them
         sits on a card and the other on a photograph. -->
    <style name="PetCare.Headline" parent="">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A heading *inside* a card. One step quieter than a section header, because the card's own
         edge is already doing part of the work of saying "a new group starts here". -->
    <style name="PetCare.CardHeader" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Supporting text under a heading: quieter than the body it explains. -->
    <style name="PetCare.Subtitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- The primary line of a list row — a pet's name, a task's title. -->
    <style name="PetCare.ListTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The supporting line beneath a list row's title. -->
    <style name="PetCare.ListSubtitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ============================== Pastel stat pills ==============================
         A small fact in a soft tinted capsule — "3 years old", "24.5 kg", "Dog".

         Each variant differs only in which pastel pair it uses. The background is a *tint* applied
         to one shared drawable rather than five separate drawables, so the shape is described once
         and adding a sixth colour later is one style here, not a new file.

         The pills are plain TextViews rather than Material Chips on purpose: a Chip is an
         interactive component that carries a touch target, a ripple and a minimum height built for
         being tapped. These are read, never pressed, and a row of them needs to stay compact. -->

    <style name="PetCare.Pill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">?attr/colorPillMint</item>
        <item name="android:textColor">?attr/colorOnPillMint</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:paddingStart">@dimen/pill_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/pill_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/pill_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/pill_padding_vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PetCare.Pill.Mint" parent="PetCare.Pill">
        <item name="android:backgroundTint">?attr/colorPillMint</item>
        <item name="android:textColor">?attr/colorOnPillMint</item>
    </style>

    <style name="PetCare.Pill.Sky" parent="PetCare.Pill">
        <item name="android:backgroundTint">?attr/colorPillSky</item>
        <item name="android:textColor">?attr/colorOnPillSky</item>
    </style>

    <style name="PetCare.Pill.Lilac" parent="PetCare.Pill">
        <item name="android:backgroundTint">?attr/colorPillLilac</item>
        <item name="android:textColor">?attr/colorOnPillLilac</item>
    </style>

    <style name="PetCare.Pill.Peach" parent="PetCare.Pill">
        <item name="android:backgroundTint">?attr/colorPillPeach</item>
        <item name="android:textColor">?attr/colorOnPillPeach</item>
    </style>

    <!-- ======================== Pills on a dashboard pet card ========================
         The two pills written across a pet card's photo. They break from the pastel family above
         for a reason that comes up repeatedly in this screen: a pastel wash is designed to sit on a
         white card, and these sit on a photograph. Neither its ground nor its text colour can be
         allowed to follow the theme, or the pills would become unreadable in one mode or the other —
         see the pet-card note in colors.xml.

         They also say two different kinds of thing, and are coloured to match: the accent pill
         carries the pet's *day*, which is the reason to look at the card at all, and the dark pill
         carries facts that are merely true. -->

    <!-- The accent pill: "Nothing due today", "3 left today". The one piece of yellow on the card,
         so the eye finds the pet's status before anything else written on it. -->
    <style name="PetCare.Pill.Accent" parent="PetCare.Pill">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/accent_yellow</item>
        <item name="android:textColor">@color/on_accent_yellow</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- The dark pill: "2 yrs · 26 kg". Translucent, so the photograph shows through it — the chip
         supplies its own shape and colour, so no tint is applied over it. -->
    <style name="PetCare.Pill.OnPhoto" parent="PetCare.Pill">
        <item name="android:background">@drawable/bg_pet_card_chip</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/on_pet_card</item>
    </style>

    <!-- The species chip in a pet card's top corner: "CAT", "DOG". Upper-case and letter-spaced so
         it reads as a category marker rather than as a word somebody wrote on the photo, and small
         enough to stay out of the way of the picture. -->
    <style name="PetCare.SpeciesChip" parent="">
        <item name="android:background">@drawable/bg_pet_card_chip</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">@color/on_pet_card</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The same species marker in the accent, for the Pets tab's cards: "CAT" on a yellow capsule.

         Yellow there rather than the translucent dark chip above, because on the Pets tab nothing is
         written across the photo — the name and stats live on the light panel below it — so the chip
         is the only mark on the picture and can afford to be the one bright thing. It inherits the
         size, case and letter-spacing from PetCare.SpeciesChip and only swaps the colours.

         The capsule is bg_pill tinted to the accent, the same trick the pastel pills use; the text is
         the colour guaranteed legible on the accent. Both are fixed values, not theme roles, since the
         chip sits on a photograph in either theme. -->
    <style name="PetCare.SpeciesChip.Accent" parent="PetCare.SpeciesChip">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/accent_yellow</item>
        <item name="android:textColor">@color/on_accent_yellow</item>
    </style>

    <!-- ============================ Pets tab: stat blocks ============================
         The row of three facts under a pet's name on the Pets tab — "0 mo / AGE", "25 kg / WEIGHT",
         "3 / DUE TODAY". A bold value over a small letter-spaced label, the label deliberately given
         the same treatment as PetCare.SectionLabel so it reads as a field name rather than as text.

         Styles rather than attributes repeated three times in item_pet.xml, so the three blocks
         cannot drift apart and a fourth fact later is one more short block. -->

    <!-- One block: a column holding the value and its label. Width is left to the layout, which
         divides the row into equal thirds with layout_weight. -->
    <style name="PetCare.PetStat" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/pets_stat_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/pets_stat_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/pets_stat_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/pets_stat_padding_vertical</item>
    </style>

    <!-- The figure itself: bold, and one step below the pet's name so the name stays the heading. -->
    <style name="PetCare.PetStat.Value" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The small upper-case name under the figure: "AGE", "WEIGHT", "DUE TODAY". -->
    <style name="PetCare.PetStat.Label" parent="PetCare.SectionLabel">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The hairline between two blocks. Full height of the row (match_parent), which a horizontal
         LinearLayout resolves after measuring its tallest child — so the line always spans the row
         exactly, however tall a value's text turns out to be at the user's font scale. -->
    <style name="PetCare.PetStat.Divider" parent="">
        <item name="android:layout_width">@dimen/pets_stat_divider_width</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!--
        The full-width "+ ADD A PET" row at the foot of the Pets tab (and in its empty state).

        A Material 3 **outlined button** rather than a plain clickable TextView: the component brings
        the ripple, the focus state, the 48dp touch target and the "button" role TalkBack announces,
        none of which a TextView has. Outlined, not filled, because it sits at the end of a list of
        large cards — it should read as "there is room for one more" rather than as the screen's
        loudest action.

        Styled quietly to match: the muted text colour and a faint outline, letter-spaced capitals
        like the section labels, and the pet cards' own corner radius so it reads as the outline of a
        card still to come. The "+" is Material's icon slot rather than a character in the string,
        so a screen reader announces "Add a pet, button" and not "plus".
    -->
    <style name="PetCare.AddRowButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/pets_add_row_height</item>
        <!-- Material buttons reserve invisible space above and below for the touch target. The row
             is already taller than that minimum, so the insets would only add a gap nothing uses. -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/pet_card_corner_radius</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="icon">@drawable/ic_add</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">16dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- ================================= Tasks tab =================================
         The redesigned Tasks tab. Its one piece of visual grammar is "chosen = strong fill": the
         selected day, the selected filter chips and the Delegate button all use
         ?attr/colorSelectedContainer (near-black in light mode, yellow in dark — see attrs.xml),
         and everything unchosen is an outlined shape on the surface colour. -->

    <!--
        A filter chip in the category or pet row.

        A genuine Material filter chip, so it brings the checkable state, the ripple, the touch
        target and TalkBack's "selected" announcement. The colours come from three state lists in
        res/color that switch on state_checked, so choosing a chip needs no code beyond checking it.

        The tick Material normally shows on a checked filter chip is switched off: the solid fill
        already says which chip is chosen, and a tick would make the chip grow as it is selected and
        shunt the rest of the row sideways under the user's finger.
    -->
    <style name="PetCare.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/filter_chip_background</item>
        <item name="chipStrokeColor">@color/filter_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/pill_corner_radius</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- The pet row's chips: the same chip with more horizontal padding. The design gives pets wider
         pills than categories — there are fewer of them, and a name is the thing being chosen, so it
         gets more room to be read and tapped. -->
    <style name="PetCare.FilterChip.Pet" parent="PetCare.FilterChip">
        <item name="chipMinHeight">40dp</item>
        <item name="textStartPadding">@dimen/spacing_md</item>
        <item name="textEndPadding">@dimen/spacing_md</item>
    </style>

    <!-- One cell of the week strip: a centred column of weekday, date and dot on bg_week_day.xml.
         Width is shared out by layout_weight in the layout, so it is not set here. -->
    <style name="PetCare.WeekDay" parent="">
        <item name="android:layout_height">@dimen/week_day_height</item>
        <item name="android:background">@drawable/bg_week_day</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
        The small outlined pill button — "RESET DAY" in the progress card.

        An outlined MaterialButton made compact: shorter than the default, fully rounded, with the
        small letter-spaced capitals the tab uses for secondary labels. insetTop/insetBottom are
        zeroed because the default insets exist to pad a 40dp button out to a 48dp touch target, and
        on a 36dp pill they would only add invisible space above and below it.
    -->
    <style name="PetCare.SmallPillButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/small_pill_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
        <item name="cornerRadius">@dimen/pill_corner_radius</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!--
        The round check button on the right of a task card.

        A *checkable* Material icon button rather than a CheckBox with a custom drawable: the design
        is a circle that fills yellow, which is a button shape, and MaterialButton supports
        android:checkable directly — it toggles state_checked on tap, draws its fill, ring and icon
        from state lists keyed on that state (res/color/task_check_*.xml), and is announced by
        TalkBack as a toggle with its checked state.

        The circle comes from the 50%-corner shape appearance, so it stays round at any size. Padding
        is set so the 20dp tick sits centred in the 40dp circle.
    -->
    <style name="PetCare.TaskCheckButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:checkable">true</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">10dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PetCare.Circle</item>
        <item name="icon">@drawable/ic_check</item>
        <item name="iconSize">@dimen/task_check_icon_size</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/task_check_foreground</item>
        <item name="backgroundTint">@color/task_check_background</item>
        <item name="strokeColor">@color/task_check_foreground</item>
        <item name="strokeWidth">@dimen/task_check_stroke_width</item>
    </style>

    <!-- The pale tag under a task's subtitle naming its supplies — "Flea tablet". The pastel pill's
         shape with a neutral wash instead of a hue, since supplies are one kind of fact and do not
         need telling apart from a neighbour. -->
    <style name="PetCare.Pill.Supplies" parent="PetCare.Pill">
        <item name="android:backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- "+ ADD TASK" at the foot of the Tasks tab: the outlined add-row button, on a surface fill so
         it reads as a solid pill on the cream page beside the dark Delegate button, as in the
         design. Its label is full-strength because here it is one of the tab's two main actions. -->
    <style name="PetCare.TaskActionButton.Outlined" parent="PetCare.AddRowButton">
        <item name="android:minHeight">@dimen/task_action_button_height</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- "DELEGATE": the filled partner of the button above, in the tab's strong "selected" fill.
         Colours are state lists so the button greys out properly when there is nothing to hand
         over — see res/color/selected_action_background.xml. -->
    <style name="PetCare.TaskActionButton.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/task_action_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/pet_card_corner_radius</item>
        <item name="backgroundTint">@color/selected_action_background</item>
        <item name="android:textColor">@color/selected_action_text</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- ============================= Category icon badge =============================
         The tinted circle a care-category icon sits in on a dashboard task row. The circle is what
         turns a 20dp glyph into something with enough visual weight to anchor the row's left edge,
         and it gives the icon a guaranteed background to be legible against. -->
    <style name="PetCare.CategoryBadge" parent="">
        <item name="android:layout_width">@dimen/category_badge_size</item>
        <item name="android:layout_height">@dimen/category_badge_size</item>
        <item name="android:background">@drawable/bg_category_badge</item>
        <item name="android:padding">@dimen/spacing_sm</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- ============================== Pet detail rows ==============================
         The repeated label-and-value pairs on the pet detail screen. -->

    <!-- Wrapper around one pair, so the two can be shown or hidden as a unit. -->
    <style name="PetCare.DetailBlock" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">@dimen/card_spacing</item>
    </style>

    <!-- The quieter heading above a value, e.g. "Date of birth". Letter-spaced and upper-case, so a
         column of them reads as a set of field names rather than as more sentences. -->
    <style name="PetCare.DetailLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- The recorded value itself. -->
    <style name="PetCare.DetailValue" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ================================ Empty states ================================
         Shown when a list has nothing in it. An icon, a short heading and a sentence saying what
         to do next — far more use than a bare line of grey text, which leaves the user unsure
         whether the screen is empty or still loading. -->

    <!-- The column holding the icon, heading and message. -->
    <style name="PetCare.EmptyState" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>

    <!-- The illustration. Tinted to a muted role so it frames the message rather than shouting
         over it. -->
    <style name="PetCare.EmptyStateIcon" parent="">
        <item name="android:layout_width">@dimen/empty_state_icon_size</item>
        <item name="android:layout_height">@dimen/empty_state_icon_size</item>
        <item name="android:alpha">0.6</item>
    </style>

    <style name="PetCare.EmptyStateTitle" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_md</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PetCare.EmptyStateMessage" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ============================== Quick actions ==============================
         The three tiles along the bottom of the dashboard — "Add task", "Log expense", "Add pet".
         A circled "+" above a short label, in an outlined tile.

         A column rather than a row inside each tile, and a deliberately generous height: three
         actions side by side on a phone leave each about a third of the screen wide, which is not
         enough for an icon and a label on one line without the label truncating. -->

    <style name="PetCare.QuickAction" parent="">
        <item name="android:background">@drawable/bg_quick_action</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/quick_action_height</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
    </style>

    <!-- The circled "+". Padding inside the circle is what keeps the glyph from filling it edge to
         edge, which would read as a solid blob at this size. -->
    <style name="PetCare.QuickAction.Icon" parent="">
        <item name="android:layout_width">@dimen/quick_action_icon_size</item>
        <item name="android:layout_height">@dimen/quick_action_icon_size</item>
        <item name="android:background">@drawable/bg_quick_action_icon</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>

    <style name="PetCare.QuickAction.Label" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ============================ Today's care ring ============================
         The circular progress ring on the dashboard's care card, showing how much of today has been
         ticked off.

         A determinate CircularProgressIndicator rather than a custom View: Material already draws a
         rounded-cap ring with a track behind it, and it animates between values, which is exactly
         what this needs and none of which is worth writing by hand.

         The thickness is well above Material's default. At the default the ring reads as a loading
         spinner that has got stuck; thick enough to be a gauge, it reads as a measurement. -->
    <style name="PetCare.CareRing" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorSize">@dimen/care_ring_size</item>
        <item name="trackThickness">@dimen/care_ring_thickness</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
        <!-- Rounded ends, so a part-finished day reads as a band rather than as a cut segment.
             Capped at half the thickness, which is the most the component accepts — at exactly half
             the two ends are semicircles and the band is a capsule. -->
        <item name="trackCornerRadius">@dimen/care_ring_corner_radius</item>
    </style>

    <!-- =========================== Bottom navigation bar ===========================
         Wired into the theme as the default bottomNavigationStyle, so activity_main.xml declares
         the view and inherits all of this.

         The bar is a dark rounded capsule in *both* themes — see the bottom-navigation note in
         colors.xml for why the app's chrome is one treatment rather than two, and bg_bottom_nav.xml
         for the shape itself.

         The selected tab is marked by the accent pill Material 3 draws behind the active icon, with
         its label in the accent below. That is the one place in the app's chrome the accent appears,
         so "where am I?" is answered by the same colour that answers "what do I press?".

         The icon and label take *different* state lists, because the two do not share a selected
         colour — the icon sits on the yellow pill, the label on the bar beside it. -->
    <style name="PetCare.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/PetCare.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_label_tint</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PetCare.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PetCare.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
        <!-- The capsule is drawn by the background drawable, so the view must not also cast a
             shadow — a shadow follows the view's rectangular bounds, not the drawable's rounded
             outline, and would show as a faint square behind the rounded ends. -->
        <item name="elevation">0dp</item>
    </style>

    <!-- The pill drawn behind the selected tab's icon: the accent itself rather than the muted
         container the app uses elsewhere, since on a dark bar the muted variant barely registers. -->
    <style name="PetCare.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_yellow</item>
    </style>

    <!--
        The tab labels: small, bold, upper-case and letter-spaced.

        Upper-case is applied through `textAllCaps` rather than by capitalising the strings
        themselves, so the same resource can stay sentence-case where it is also used as a screen
        title — see the note at the top of the bottom-navigation strings in strings.xml.

        No textColor here. A text *appearance* that named a colour would override the state list the
        bar applies through itemTextColor, and every tab would end up looking identically selected.
    -->
    <style name="TextAppearance.PetCare.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ================================== Chips ==================================
         The pet picker at the top of the Tasks and Expenses tabs. A genuine Material Chip here,
         unlike the stat pills above, precisely because these *are* pressed: the component brings
         the touch target, the ripple and the selected state with it. -->
    <style name="PetCare.PetChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/pill_corner_radius</item>
        <!-- The tick Material shows on a selected filter chip is switched off. With only one chip
             ever selected, the tick is redundant — the filled yellow background already says which
             pet is showing — and removing it stops every chip changing width as the selection
             moves, which makes the row jump sideways under the user's finger. -->
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
