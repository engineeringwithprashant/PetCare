    <dimen name="streak_day_height">30dp</dimen>
    <dimen name="streak_day_gap">5dp</dimen>
    <dimen name="streak_day_corner_radius">9dp</dimen>
    <dimen name="streak_day_today_stroke">1.5dp</dimen>

    <!-- A pet card in the sideways "Your pets" row. -->
    <dimen name="home_pet_card_width">200dp</dimen>
    <dimen name="home_pet_card_gap">10dp</dimen>
    <!-- The gradient behind the name, as a fraction of a now-shorter card. -->
    <dimen name="home_pet_card_scrim_height">76dp</dimen>

    <!-- The insight card's "AI" badge. -->
    <dimen name="insight_badge_size">22dp</dimen>
