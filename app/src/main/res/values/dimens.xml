    <!-- The countdown ring: 96dp across with a 72dp hole, which is a 12dp band. -->
    <dimen name="next_up_ring_size">96dp</dimen>
    <dimen name="next_up_ring_thickness">12dp</dimen>
    <!-- Half the thickness, which is the most the component accepts: at exactly half. -->
    <dimen name="next_up_ring_corner_radius">6dp</dimen>
