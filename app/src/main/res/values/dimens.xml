    <!-- The next-up card's ring. Drawn inside this box. -->
    <!-- ======================== The dark next-up card ======================== -->
    <dimen name="next_up_card_min_height">140dp</dimen>
    <dimen name="next_up_card_padding">20dp</dimen>
    <dimen name="next_up_card_corner_radius">28dp</dimen>
    <!-- Between the ring and the column of words. Wider than the card's other gaps. -->
