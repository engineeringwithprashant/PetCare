<!--
    The app's spacing, shape and elevation scale.

    Every gap, corner and shadow in the app is one of these values rather than a number typed into a
    layout. Two reasons: a shared scale keeps rhythm consistent between screens that were written
    weeks apart, and values declared in dp are scaled per device, where a raw pixel figure would be
    a different physical size on every screen.

    The spacing scale is a familiar 4dp grid — each step roughly doubling — which is what Material's
    own layouts are built on. Picking from a short list also removes the temptation to nudge a gap
    to 18dp because it looked slightly better on one device.
-->
<resources>

    <!-- ================================ Spacing scale ================================ -->
    <!-- Hairline gaps: between a label and the value directly beneath it. -->
    <dimen name="spacing_xs">4dp</dimen>
    <!-- Tight gaps: between closely related lines of text, or stacked buttons. -->
    <dimen name="spacing_sm">8dp</dimen>
    <!-- The default gap: between form fields, and between cards in a list. -->
    <dimen name="spacing_md">16dp</dimen>
    <!-- Section gaps: around a screen's edges, and between distinct blocks of content. -->
    <dimen name="spacing_lg">24dp</dimen>
    <!-- Major breaks: above a screen's primary action, or around an empty state. -->
    <dimen name="spacing_xl">32dp</dimen>

    <!-- ============================== Screen structure ==============================
         The redesign settles on a uniform 16dp gutter everywhere, replacing the 24dp the app used
         before. The change is deliberate: cards now carry their own 16dp of internal padding, so a
         24dp gutter on top of that pushed content 40dp from the screen edge and left the cards
         looking narrow on a phone. 16dp outside and 16dp inside reads as one consistent rhythm. -->
    <dimen name="screen_padding">16dp</dimen>
    <!-- The gutter as a negative margin, for a sideways-scrolling row that has to reach the screen's
         edges from inside a padded column — see fragment_home.xml. Always the exact negative of
         screen_padding, so the row's first card still lines up with everything above it. -->
    <dimen name="screen_padding_negative">-16dp</dimen>

    <!-- Breathing room above the first item on a screen, under the app bar. -->
    <dimen name="content_top_padding">12dp</dimen>

    <!-- Bottom padding on a scrolling list that has a floating action button over it, so the last
         row can scroll clear of the button rather than finishing underneath it. Sized for the
         button plus its margin — and now also for the bottom navigation bar sitting below that. -->
    <dimen name="list_padding_bottom_fab">104dp</dimen>

    <!-- Bottom padding for a scrolling list on a screen with no floating action button. Only the
         navigation bar has to be cleared. -->
    <dimen name="list_padding_bottom">24dp</dimen>

    <!-- ================================ Shape scale ================================
         The redesign's rounded-corner language, in three steps. Everything the user perceives as a
         "card" lands in the 16–20dp band; anything smaller is a detail *inside* a card and takes
         the small radius, so the two never look like they are competing to be the same thing. -->

    <!-- Small: pills, chips, tiny inner tiles. -->
    <dimen name="corner_radius_sm">12dp</dimen>
    <!-- Medium: list-row cards — one pet, one expense, one task. -->
    <dimen name="corner_radius_md">16dp</dimen>
    <!-- Large: full-width feature cards and the photo header on the pet detail screen. -->
    <dimen name="corner_radius_lg">20dp</dimen>

    <!-- ============================== Elevation scale ==============================
         Deliberately shallow. A soft, barely-there shadow is what separates a white card from a
         cream page; a heavy one on a light background reads as dirt rather than as depth. -->

    <!-- Resting elevation for an ordinary card. -->
    <dimen name="card_elevation">2dp</dimen>
    <!-- A card that should read as the most important thing on the screen. -->
    <dimen name="card_elevation_raised">4dp</dimen>

    <!-- ================================= Components ================================= -->
    <!-- Gap between cards in a vertical list. -->
    <dimen name="card_spacing">12dp</dimen>
    <!-- Padding inside a card, between its edge and its content. Matches the screen gutter. -->
    <dimen name="card_padding">16dp</dimen>

    <!-- ============================== Pastel stat pills ==============================
         The soft tinted chips carrying one fact each — age, weight, species. -->
    <!-- Fully rounded ends. Any value at least half the pill's height produces a capsule, so this
         is set well above it rather than being kept in step with the pill's exact height. -->
    <dimen name="pill_corner_radius">100dp</dimen>
    <dimen name="pill_padding_horizontal">12dp</dimen>
    <dimen name="pill_padding_vertical">6dp</dimen>
    <dimen name="pill_spacing">8dp</dimen>

    <!-- ================================ Pet imagery ================================ -->
    <!-- Height of the photo panel on the add/edit pet form, where the photo is an input rather than
         the subject of the screen. -->
    <dimen name="pet_photo_form_height">180dp</dimen>

    <!-- Size of a category icon beside a heading or a list row. -->
    <dimen name="category_icon_size">20dp</dimen>
    <!-- The tinted circle a category icon sits inside on a dashboard task row. -->
    <dimen name="category_badge_size">36dp</dimen>
    <!-- Size of the illustration at the top of an empty state. Large enough to read as an
         illustration rather than as a stray icon. -->
    <dimen name="empty_state_icon_size">72dp</dimen>

    <!-- Gap between the edge of a list row and the icon revealed behind it while swiping. -->
    <dimen name="checklist_swipe_icon_margin">24dp</dimen>

    <!-- ============================== Shared header and cards ==============================
         Sizes first introduced by the dashboard and now shared with the other redesigned screens: the
         header row, the care ring and the soft card corner. The rest of the dashboard's own sizes are in
         the "Home dashboard (redesign)" section at the end of this file. -->

    <!-- The rounded square holding the app's "p" monogram in the dashboard header. -->
    <dimen name="monogram_size">32dp</dimen>
    <dimen name="monogram_corner_radius">10dp</dimen>

    <!-- The circular badge on the right of the header reporting how many pets are in care, and the
         theme-toggle pill beside it. Both are sized to the same height so the header's right-hand
         cluster sits on one line. -->
    <dimen name="header_control_height">32dp</dimen>
    <dimen name="header_badge_size">32dp</dimen>

    <!-- The progress ring on the "today's care" card.
         The ring is drawn *inside* this box, so the thickness eats into it: a 96dp ring 8dp thick
         leaves an 80dp hole, which is what the completed count has to fit into. -->
    <!--
        The gap between the Today's-care ring and the heading block beside it.

        Its own dimension rather than the general spacing_md (16dp) it used, because this is not
        generic spacing: it separates a circle from a column of text, and a circle's bounding box
        touches its neighbour at only one point, so the same nominal gap reads as tighter here than
        it would between two straight edges. Measured off design/home-mockup-top.png, where the gap
        is 13 of the mockup's pixels, and the specification puts it at 16dp.
    -->
    <dimen name="home_today_ring_spacing">16dp</dimen>
    <!-- The card's own padding, and the gap between its two blocks (the ring row and the streak).
         Tighter than the app's usual card_padding because this card holds four things and is asked
         to stay compact. -->
    <dimen name="home_today_card_padding">18dp</dimen>
    <dimen name="home_today_block_gap">14dp</dimen>
    <!--
        The today's-care ring: 74dp across with a 56dp hole, which is a 9dp band.

        **It is deliberately the secondary element in its card.** The headline beside it is what the
        user reads; the ring is a glance. At the 92dp it was, the circle outweighed the sentence next
        to it and the card had to grow tall to hold them both. Capped at 74dp it sits comfortably
        beside two lines of 18sp text, which is what makes the whole card more compact.

        As on the next-up ring, the spec's "disc inside the ring" is expressed as the band's
        thickness: (74 - 56) / 2 is 9dp, and the card's own surface shows through the middle exactly
        as a centred disc of the same colour would.
    -->
    <dimen name="care_ring_size">74dp</dimen>
    <dimen name="care_ring_thickness">9dp</dimen>
    <!-- Exactly half the thickness, which is the largest radius the progress indicator accepts and
         the value that rounds each end of the band into a semicircle. -->
    <!-- Half the band's thickness, the most the component accepts: both ends become semicircles and
         a part-finished day reads as a capsule rather than a cut segment. -->
    <dimen name="care_ring_corner_radius">4.5dp</dimen>

    <!-- The corner radius shared by the pet cards on every tab and the dashboard's large cards. Larger
         than the app's usual card radius: these are a page's subject, and the softer corner is what
         separates them from an ordinary list row elsewhere in the app. -->
    <dimen name="pet_card_corner_radius">24dp</dimen>

    <!-- ================================= Pets tab =================================
         The redesigned Pets tab: one tall card per pet, stacked, then an outlined "Add a pet" row.
         The cards reuse pet_card_corner_radius above, so a pet looks like the same object on both
         tabs. -->

    <!--
        The shape every pet photo is stored, framed and drawn in, as a ConstraintLayout dimension
        ratio.

        **Why one shape for the whole app, in one place.** When a pet's photo is chosen the user
        frames it themselves (see ui/common/PhotoCropView.kt) and the framed result is what gets
        saved. That promise — what you framed is what the cards show — only holds while every card
        draws the same shape the cropper offered. A card with a ratio of its own would have to crop
        the crop, and the user's choice would be overruled after all. So the Pets card, the
        dashboard's row card, the detail hero and the cropper all derive their frame from this value
        and there is no second place to forget.

        4:3 landscape is chosen because it was closest to what the two full-width surfaces already
        were: the Pets card's photo was 200dp and the detail hero 300dp, both within a few dp of
        their 4:3 heights, so adopting it cost those screens almost no visible change.

        Kept as a string rather than a dimen because ConstraintLayout's dimensionRatio is a ratio,
        not a length. It is mirrored by PhotoCropView.PET_PHOTO_ASPECT, which needs it as a number.

        The "H," prefix is part of the value rather than written at each use site, because XML cannot
        join a literal to a resource reference. It tells ConstraintLayout which side to compute: the
        **height**, from the width. Every one of these frames is as wide as the space it is given and
        derives its height from that, so one value serves all three.
    -->
    <string name="pet_photo_aspect_ratio" translatable="false">H,4:3</string>
    <!-- Gap between one pet card and the next, and before the add row. A step wider than the app's
         usual card_spacing: these cards carry a shadow and a photograph, and packed at 12dp the
         shadows of neighbouring cards run together. -->
    <dimen name="pets_card_spacing">16dp</dimen>
    <!-- The age / weight / due-today blocks inside a card. -->
    <dimen name="pets_stat_padding_horizontal">12dp</dimen>
    <dimen name="pets_stat_padding_vertical">10dp</dimen>
    <!-- The hairline between two stat blocks, and the outline around the row of them. -->
    <dimen name="pets_stat_divider_width">1dp</dimen>
    <!-- The full-width "+ Add a pet" row at the foot of the list. At least 48dp is Android's minimum
         touch target; the extra keeps it in proportion with the tall cards above. -->
    <dimen name="pets_add_row_height">56dp</dimen>

    <!-- ============================== Pet detail screen ==============================
         The redesigned single-pet screen: the photo card, the action row, the "About" card and the
         care routine cards. Corners reuse pet_card_corner_radius, so this pet's photo card is the same
         object it was on the Pets and Home tabs, only larger. -->

    <!-- The pet's full name across the scrim: a step up from PetCare.Headline's 24sp, because here it
         is the title of the whole page. In sp so it grows with the user's font size. -->
    <dimen name="pet_detail_name_text_size">28sp</dimen>
    <!-- The round back button over the photo. The view is 48dp — Android's minimum touch target —
         and 4dp insets on every side draw the visible disc at 40dp inside it, so the button looks
         light on the photo without being any harder to hit. -->
    <dimen name="pet_detail_back_button_touch_size">48dp</dimen>
    <dimen name="pet_detail_back_button_inset">4dp</dimen>
    <!-- The round gender badge beside the species chip, sized to the chip's own height so the two sit
         as a matched pair, and the Mars/Venus glyph inside it. -->
    <dimen name="pet_detail_gender_badge_size">24dp</dimen>
    <dimen name="pet_detail_gender_icon_padding">4dp</dimen>

    <!-- The CHECKLIST / EXPENSES / EDIT PET row. -->
    <dimen name="pet_detail_action_button_height">46dp</dimen>
    <dimen name="pet_detail_action_gap">8dp</dimen>

    <!-- The "About" card. The label column has a fixed width so every value starts at the same x
         position down the card, which is what makes it read as a table rather than as five
         sentences. Wide enough for "FAVOURITE TOYS" on one line at the default font size; a larger
         font wraps the label rather than squeezing the value. -->
    <dimen name="pet_detail_about_label_width">120dp</dimen>
    <dimen name="pet_detail_about_row_padding_vertical">14dp</dimen>

    <!-- The small yellow "+" beside "Care routines". The circle is 36dp; the button's view is 48dp
         with 6dp insets on each side, so the touch target still meets Android's 48dp minimum. -->
    <dimen name="pet_detail_add_routine_touch_size">48dp</dimen>
    <dimen name="pet_detail_add_routine_inset">6dp</dimen>

    <!-- The "⋮" overflow button on a routine card: a 40dp icon button. -->
    <dimen name="routine_card_overflow_size">40dp</dimen>

    <!-- ================================= Tasks tab =================================
         The redesigned Tasks tab: week strip, progress card, filter chips, task cards and the two
         actions at the foot. -->

    <!-- One day cell in the week strip. Seven share the width, so only the height and the gap
         between cells are fixed; the corner is a little under half the width a cell ends up at on
         a phone, which rounds it towards a pill without becoming a circle. -->
    <dimen name="week_day_height">60dp</dimen>
    <dimen name="week_day_gap">6dp</dimen>
    <dimen name="week_day_corner_radius">16dp</dimen>
    <!-- The "care scheduled" dot under a date. -->
    <dimen name="week_day_dot_size">4dp</dimen>

    <!-- The segmented bar in the progress card: one rounded segment per task. -->
    <dimen name="segmented_progress_height">8dp</dimen>
    <dimen name="segmented_progress_gap">4dp</dimen>

    <!-- The small outlined "Reset day" pill in the progress card. Shorter than a standard 40dp
         button because it is a secondary action sitting beside a headline, not below a form — its
         touch area is still padded out to 48dp by Material's own inset handling. -->
    <dimen name="small_pill_button_height">36dp</dimen>

    <!-- A task card: the time badge on the left, the round check button on the right. -->
    <dimen name="task_time_badge_size">52dp</dimen>
    <dimen name="task_check_button_size">40dp</dimen>
    <dimen name="task_check_icon_size">20dp</dimen>
    <dimen name="task_check_stroke_width">1.5dp</dimen>
    <!-- Gap between task cards; tighter than between pet cards because these are rows of a list
         grouped under headers, and wide gaps would break the groups apart visually. -->
    <dimen name="task_card_spacing">10dp</dimen>

    <!-- The two buttons at the foot of the tab: "+ Add task" and "Delegate". -->
    <dimen name="task_action_button_height">52dp</dimen>

    <!-- The circled "+" on each of the dashboard's quick-action cards. The cards' own height is
         home_quick_action_height, further down with the rest of the redesigned dashboard. -->
    <dimen name="quick_action_icon_size">26dp</dimen>

    <!-- The floating bottom navigation bar. The bar keeps its own space in the Activity's layout
         rather than overlapping the content — see activity_main.xml — and these are the margins that
         inset the dark capsule within that space. -->
    <dimen name="bottom_nav_margin_horizontal">12dp</dimen>
    <dimen name="bottom_nav_margin_vertical">8dp</dimen>
    <dimen name="bottom_nav_corner_radius">28dp</dimen>
    <dimen name="bottom_nav_height">64dp</dimen>

    <!-- ================================= Money tab =================================
         The dark total card, its stacked category bar, the legend and the expense cards. -->

    <!-- The month's total — the largest figure in the app, because it is the one this tab exists to
         answer. In sp, so it still grows with the user's font-size setting. -->
    <dimen name="expenses_total_text_size">44sp</dimen>
    <!-- The stacked bar. Thick enough that a 3% segment is still a readable coloured capsule. -->
    <dimen name="expenses_category_bar_height">10dp</dimen>
    <!-- The coloured dot on a legend row: a small rounded square, echoing the bar's segments. -->
    <dimen name="expenses_legend_dot_size">10dp</dimen>
    <dimen name="expenses_legend_dot_corner_radius">3dp</dimen>
    <!-- The category badge on an expense card, and the gap between cards. -->
    <dimen name="expenses_badge_size">44dp</dimen>
    <dimen name="expenses_badge_corner_radius">12dp</dimen>
    <dimen name="expenses_card_spacing">12dp</dimen>

    <!-- ================================= Places tab =================================
         The distance strip, the featured place card and the saved-place rows. -->

    <!-- The distance axis inside the dark strip. Tall enough for two staggered lanes of category chips
         above the line and a row of tick labels below it — see DistanceAxisView.onMeasure. -->
    <dimen name="places_axis_height">104dp</dimen>
    <!-- The rounded-square category badge on a saved-place row ("Vet", "Grm"). A rounded square
         rather than a circle, so it echoes the header's monogram rather than a pet's round photo. -->
    <dimen name="places_badge_size">40dp</dimen>
    <dimen name="places_badge_corner_radius">10dp</dimen>
    <!-- The outlined pair of info blocks (hours, phone) in the featured card. -->
    <dimen name="places_info_corner_radius">14dp</dimen>
    <!-- "BOOK A VISIT" and "PINNED" at the foot of the featured card. -->
    <dimen name="places_action_button_height">52dp</dimen>
    <!-- Gap between saved-place rows. -->
    <dimen name="places_row_spacing">10dp</dimen>

    <!-- ============================ Home dashboard (redesign) ============================
         The redesigned Home tab, top to bottom. Its large cards reuse pet_card_corner_radius, so the
         dashboard's cards are the same softly rounded objects as the pet cards on every other tab. -->

    <!-- The header's "AI" pill: the theme toggle's height, with a little horizontal room. -->
    <dimen name="header_ai_pill_padding_horizontal">10dp</dimen>
    <!-- The red dot on the pet badge's corner, including its page-coloured ring. -->
    <dimen name="header_unread_dot_size">9dp</dimen>

    <!-- The coloured dot before "All synced". -->
    <dimen name="sync_dot_size">6dp</dimen>

    <!-- The three stat cards. A fixed width rather than a third each, so the row can scroll sideways on
         a narrow phone with the third card peeking in from the edge, as the design draws it, and a long
         amount such as "Rs 12,480" is never squeezed. -->
    <!--
        ================== The Home screen's own spacing scale ==================

        These are deliberately *not* the app-wide screen_padding and card_spacing. The dashboard is
        specified as a single composition — gutters, section gaps and card radii all chosen together
        — and the other four tabs are not. Giving Home its own names is what lets it be tuned to that
        specification without dragging Tasks, Places, Money and Pets along with it.

        The negative gutter is the exact inverse of the padding: the stat row and the pet row bleed
        out to the screen edges by cancelling the parent's padding, then re-apply it as their own so
        the first card still lines up with the greeting above.
    -->
    <dimen name="home_screen_padding">18dp</dimen>
    <dimen name="home_screen_padding_negative">-18dp</dimen>
    <!-- The scroll area's own top and bottom insets. The bottom is deep because the floating bottom
         navigation is drawn over the scrolling content — without it the last card would come to rest
         underneath the bar and look cut off. -->
    <dimen name="home_scroll_padding_top">8dp</dimen>
    <dimen name="home_scroll_padding_bottom">130dp</dimen>
    <!-- The gap between two top-level sections: greeting, stat row, next-up card, today's care,
         pets. One value used everywhere, which is what gives the column its even rhythm. -->
    <dimen name="home_section_gap">18dp</dimen>

    <!--
        ============================ The stat cards ============================

        A stat card is a *summary*, not a headline: three short lines that should read at a glance
        and take as little vertical space as possible, so the dark next-up card below stays the
        dominant object on the screen.

        **Width is a minimum, not a fixed size.** The card is wrap_content with this as its minWidth,
        which is what lets an unusually long figure widen its own card instead of being shrunk or
        truncated to fit a fixed one. In practice every value fits inside 116dp, so the three cards
        are uniform; the minimum is what guarantees they *stay* uniform.

        The three gaps and the padding are what land the card near 100dp tall: 13 + 11 + 8 + 19 + 8 +
        21 + 13. Adding whitespace anywhere here is what made earlier versions too tall.
    -->
    <dimen name="home_stat_card_min_width">116dp</dimen>
    <dimen name="home_stat_card_padding">13dp</dimen>
    <dimen name="home_stat_card_corner_radius">18dp</dimen>
    <!-- One gap, used both under the label and under the figure: the card is an evenly spaced stack
         of three lines rather than a figure with satellites. -->
    <dimen name="home_stat_line_spacing">8dp</dimen>
    <!-- The card's uppercase micro-label. 8.5sp is the smallest the app sets anywhere and is only
         legible because IBM Plex Mono is wide-set and this text is always upper-case. -->
    <dimen name="home_stat_label_text_size">8.5sp</dimen>
    <dimen name="home_stat_card_gap">8dp</dimen>
    <!--
        The bold figure in a stat card. In sp, so it grows with the user's font size; the text view
        also shrinks it towards the minimum to fit rather than cutting a long amount off.

        19sp against an 8.5sp label is a ratio of well over two, which is what makes the figure read
        as the card's subject without the card having to be tall. It is deliberately *below* the
        next-up card's 20sp title: these are summaries and that is the headline.

        **There is no longer a minimum.** Auto-sizing was removed from this view — see
        item_home_stat.xml — because the card can now widen instead, which is a better answer than
        shrinking the one thing the card exists to show. The dimension is kept as a single named size.
    -->
    <dimen name="home_stat_value_text_size">19sp</dimen>
    <!-- The small status pill at the foot of a stat card. -->
    <dimen name="home_stat_pill_padding_horizontal">8dp</dimen>
    <!-- 5dp rather than 3dp. The pill keeps its capsule shape at any height, so the padding is what
         decides it: 5dp above and below an 8.5sp line lands the pill at about 21dp, which is the
         third of the card's three lines the spacing was calculated around. -->
    <dimen name="home_stat_pill_padding_vertical">5dp</dimen>

    <!-- The next-up card's ring. Drawn *inside* this box, so a 96dp ring 7dp thick leaves an 82dp hole
         for the minute count; the corner radius is half the thickness, the most the indicator accepts. -->
    <!--
        ======================== The dark next-up card ========================

        The screen's dominant object: the one card that answers "what do I do now". Everything here
        is sized to keep it visibly heavier than the summary cards above and the care card below —
        see next_up_card_min_height on the layout for why the floor matters more than the padding.
    -->
    <dimen name="next_up_card_min_height">140dp</dimen>
    <dimen name="next_up_card_padding">20dp</dimen>
    <dimen name="next_up_card_corner_radius">28dp</dimen>
    <!-- Between the ring and the column of words. Wider than the card's other gaps because it
         separates two whole blocks rather than two lines. -->
    <dimen name="next_up_content_gap">18dp</dimen>

    <!--
        The countdown ring: 96dp across with a 72dp hole, which is a 12dp band.

        The spec describes this as a conic-gradient ring with a smaller disc centred on it. A
        CircularProgressIndicator already *is* that shape — an arc of accent over a faint track — so
        the disc is expressed as what it actually is here: the thickness of the band. (96 - 72) / 2
        is 12dp, and the card's own background shows through the middle exactly as a centred disc of
        the same colour would.
    -->
    <dimen name="next_up_ring_size">96dp</dimen>
    <dimen name="next_up_ring_thickness">12dp</dimen>
    <!-- Half the thickness, which is the most the component accepts: at exactly half, both ends of
         the band are semicircles and a part-finished countdown reads as a capsule rather than a
         segment cut with a knife. -->
    <dimen name="next_up_ring_corner_radius">6dp</dimen>
    <!-- The minute count in the middle of the ring, and the task title beside it. -->
    <!-- The number inside the ring. 21sp inside a 72dp hole leaves the figure room to breathe above
         its unit label; at the 28sp it was, a three-digit count touched the band. -->
    <dimen name="next_up_minutes_text_size">21sp</dimen>
    <!-- The task title — the card's subject, and the largest type on the dashboard after the
         greeting. It stays a step above the 19sp stat figures and the 18sp care headline, which is
         what ranks the three cards against each other. -->
    <dimen name="next_up_title_text_size">20sp</dimen>
    <!-- "MARK DONE": a compact pill, shorter than a form button because it sits inside a card. -->
    <!-- "MARK DONE". 11dp of padding above and below a 10sp line comes to about 35dp, which keeps
         the pill compact enough to sit under the subtitle inside a 140dp card. It stays above the
         44dp the button's own touch target reserves, so the tap area is unaffected by the smaller
         visual height. -->
    <dimen name="next_up_button_height">35dp</dimen>
    <dimen name="next_up_button_padding_horizontal">15dp</dimen>

    <!-- The care streak's seven boxes. Seven share the width, so only the height, gap and corner are
         fixed. Today's outline is a touch heavier than a missed day's hairline so it can be found. -->
    <!--
        A care-streak day box, and the space between two of them.

        Measured off design/home-mockup-top.png: the boxes there are 33x24 of the mockup's pixels,
        which at this screen's scale is a box noticeably taller than the 28dp it was, separated by a
        hairline rather than a visible gutter. Widening the box while *narrowing* the gap is what
        makes the week read as one continuous strip of days — at 6dp apart they read as seven
        unrelated chips. The width is not set here: the row divides itself into seven equal weighted
        columns, so the boxes grow to fill whatever the gap leaves.
    -->
    <dimen name="streak_day_height">30dp</dimen>
    <dimen name="streak_day_gap">5dp</dimen>
    <dimen name="streak_day_corner_radius">9dp</dimen>
    <dimen name="streak_day_today_stroke">1.5dp</dimen>

    <!--
        A pet card in the sideways "Your pets" row.

        **Why it is landscape now, where it used to be portrait (156×180).** The card shows the
        photo the user framed, and it can only show it faithfully by drawing the same shape they
        framed — pet_photo_aspect_ratio, 4:3. A portrait card would have had to trim the sides off
        their crop, which is the very second-guessing the framing step exists to stop.

        200dp is chosen so the card is no shorter than it was: at 4:3 that gives a 150dp height,
        against the old 180dp, and the row keeps its proportions. It is still narrow enough that the
        next pet shows at the screen edge on any phone, which is what tells the user the row scrolls.

        Only the width is declared. The height follows from the ratio, so the two can never drift
        apart — see item_home_pet.xml.
    -->
    <dimen name="home_pet_card_width">200dp</dimen>
    <dimen name="home_pet_card_gap">10dp</dimen>
    <!-- The gradient behind the name, as a fraction of a now-shorter card: 110dp of scrim on a
