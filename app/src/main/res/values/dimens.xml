    <dimen name="header_alert_count_size">16dp</dimen>
    <dimen name="header_alert_count_corner_radius">10dp</dimen>
    <dimen name="header_alert_count_padding_horizontal">3dp</dimen>
    <dimen name="header_alert_count_text_size">9sp</dimen>

    <!-- The coloured dot before "All synced". -->
    <dimen name="sync_dot_size">6dp</dimen>

    <!-- The three stat cards. A fixed width rather than a third. -->
