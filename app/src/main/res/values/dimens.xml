    <dimen name="week_day_height">60dp</dimen>
    <dimen name="week_day_gap">6dp</dimen>
    <dimen name="week_day_corner_radius">16dp</dimen>
    <!-- The "care scheduled" dot under a date. -->
    <dimen name="week_day_dot_size">4dp</dimen>

    <!-- The segmented bar in the progress card: one rounded segment per task. -->
    <dimen name="segmented_progress_height">8dp</dimen>
    <dimen name="segmented_progress_gap">4dp</dimen>

    <!-- The small outlined "Reset day" pill in the progress card. -->
    <dimen name="small_pill_button_height">36dp</dimen>

    <!-- A task card: the time badge on the left, the round check button on the right. -->
    <dimen name="task_time_badge_size">52dp</dimen>
    <dimen name="task_check_button_size">40dp</dimen>
    <dimen name="task_check_icon_size">20dp</dimen>
    <dimen name="task_check_stroke_width">1.5dp</dimen>
    <!-- The category emoji in front of a task's title. A shade larger than the title beside. -->
    <dimen name="task_category_emoji_size">18sp</dimen>
    <!-- Gap between task cards; tighter than between pet cards. -->
    <dimen name="task_card_spacing">10dp</dimen>

    <!-- The two buttons at the foot of the tab: "+ Add task" and "Delegate". -->
    <dimen name="task_action_button_height">52dp</dimen>

    <!-- The circled "+" on each of the dashboard's quick-action cards. -->
    <dimen name="quick_action_icon_size">26dp</dimen>

    <!-- ===================== The floating bottom navigation bar ===================== -->
    <dimen name="nav_bar_margin_horizontal">14dp</dimen>
    <dimen name="nav_bar_margin_bottom">16dp</dimen>
    <dimen name="nav_bar_padding">7dp</dimen>
    <dimen name="nav_bar_corner_radius">24dp</dimen>

    <!-- One tab. The height doubles as the touch target. -->
    <dimen name="nav_tab_height">46dp</dimen>
    <!-- A touch under half the tab's height: the pill's ends are strongly rounded but not a full lozenge. -->
    <dimen name="nav_tab_corner_radius">18dp</dimen>
    <!-- The gap between two tabs. Small enough that the row still reads as one control. -->
    <dimen name="nav_tab_gap">4dp</dimen>
    <!-- Breathing room inside the active pill only. An inactive tab has none: it holds an icon and nothing else. -->
    <dimen name="nav_tab_active_padding_horizontal">14dp</dimen>

    <dimen name="nav_tab_icon_size">21dp</dimen>
    <!-- Between the icon and the label that appears beside it on the active pill. -->
    <dimen name="nav_tab_icon_label_gap">8dp</dimen>

    <!-- Android's own minimum for anything a finger presses. -->
    <dimen name="nav_tab_min_touch_target">44dp</dimen>

    <!-- The Tasks tab's open-count badge. Square at rest. -->
    <dimen name="nav_badge_size">16dp</dimen>
    <dimen name="nav_badge_padding_horizontal">4dp</dimen>
    <dimen name="nav_badge_corner_radius">999dp</dimen>
    <!-- Where the badge sits within the tab: high and to the right, clear of the icon's top corner. -->
    <dimen name="nav_badge_margin_top">9dp</dimen>
    <dimen name="nav_badge_margin_end">14dp</dimen>
    <dimen name="nav_badge_margin_end_active">10dp</dimen>

    <!-- ================================= Money tab ================================= -->

    <!-- The month's total — the largest figure in the app, because it is the one this tab exists to answer. -->
    <dimen name="expenses_total_text_size">44sp</dimen>
    <!-- The stacked bar. Thick enough that a 3% segment is still a readable coloured capsule. -->
    <dimen name="expenses_category_bar_height">10dp</dimen>
    <!-- The coloured dot on a legend row: a small rounded square, echoing the bar's segments. -->
    <dimen name="expenses_legend_dot_size">10dp</dimen>
    <dimen name="expenses_legend_dot_corner_radius">3dp</dimen>
    <!-- The category badge on an expense card, and the gap between cards. -->
    <dimen name="expenses_badge_size">44dp</dimen>
    <!-- How big the category emoji is drawn inside that badge and inside the saved-place one. -->
    <dimen name="category_badge_emoji_size">20sp</dimen>
    <dimen name="expenses_badge_corner_radius">12dp</dimen>
    <dimen name="expenses_card_spacing">12dp</dimen>

    <!-- ================================= Places tab ================================= -->

