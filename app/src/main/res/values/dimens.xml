<!--
    The app's spacing, shape and elevation scale.

    Every gap, corner and shadow in the app is one of these values rather than a number typed into a
    layout. Two reasons: a shared scale keeps rhythm consistent between screens that were written
    weeks apart, and values declared in dp are scaled per device, where a raw pixel figure would be
    a different physical size on every screen.

    The spacing scale is a familiar 4dp grid — each step roughly doubling — which is what Material's
    own layouts are built on. Picking from a short list also removes the temptation to nudge a gap
    to 18dp because it looked slightly better on one device.
-->
<resources>

    <!-- ================================ Spacing scale ================================ -->
    <!-- Hairline gaps: between a label and the value directly beneath it. -->
    <dimen name="spacing_xs">4dp</dimen>
    <!-- Tight gaps: between closely related lines of text, or stacked buttons. -->
    <dimen name="spacing_sm">8dp</dimen>
    <!-- The default gap: between form fields, and between cards in a list. -->
    <dimen name="spacing_md">16dp</dimen>
    <!-- Section gaps: around a screen's edges, and between distinct blocks of content. -->
    <dimen name="spacing_lg">24dp</dimen>
    <!-- Major breaks: above a screen's primary action, or around an empty state. -->
    <dimen name="spacing_xl">32dp</dimen>

    <!-- ============================== Screen structure ==============================
         The redesign settles on a uniform 16dp gutter everywhere, replacing the 24dp the app used
         before. The change is deliberate: cards now carry their own 16dp of internal padding, so a
         24dp gutter on top of that pushed content 40dp from the screen edge and left the cards
         looking narrow on a phone. 16dp outside and 16dp inside reads as one consistent rhythm. -->
    <dimen name="screen_padding">16dp</dimen>

    <!-- Breathing room above the first item on a screen, under the app bar. -->
    <dimen name="content_top_padding">12dp</dimen>

    <!-- Bottom padding on a scrolling list that has a floating action button over it, so the last
         row can scroll clear of the button rather than finishing underneath it. Sized for the
         button plus its margin — and now also for the bottom navigation bar sitting below that. -->
    <dimen name="list_padding_bottom_fab">104dp</dimen>

    <!-- Bottom padding for a scrolling list on a screen with no floating action button. Only the
         navigation bar has to be cleared. -->
    <dimen name="list_padding_bottom">24dp</dimen>

    <!-- ================================ Shape scale ================================
         The redesign's rounded-corner language, in three steps. Everything the user perceives as a
         "card" lands in the 16–20dp band; anything smaller is a detail *inside* a card and takes
         the small radius, so the two never look like they are competing to be the same thing. -->

    <!-- Small: pills, chips, tiny inner tiles. -->
    <dimen name="corner_radius_sm">12dp</dimen>
    <!-- Medium: list-row cards — one pet, one expense, one task. -->
    <dimen name="corner_radius_md">16dp</dimen>
    <!-- Large: full-width feature cards and the photo header on the pet detail screen. -->
    <dimen name="corner_radius_lg">20dp</dimen>

    <!-- ============================== Elevation scale ==============================
         Deliberately shallow. A soft, barely-there shadow is what separates a white card from a
         cream page; a heavy one on a light background reads as dirt rather than as depth. -->

    <!-- Resting elevation for an ordinary card. -->
    <dimen name="card_elevation">2dp</dimen>
    <!-- A card that should read as the most important thing on the screen. -->
    <dimen name="card_elevation_raised">4dp</dimen>

    <!-- ================================= Components ================================= -->
    <!-- Gap between cards in a vertical list. -->
    <dimen name="card_spacing">12dp</dimen>
    <!-- Padding inside a card, between its edge and its content. Matches the screen gutter. -->
    <dimen name="card_padding">16dp</dimen>

    <!-- ============================== Pastel stat pills ==============================
         The soft tinted chips carrying one fact each — age, weight, species. -->
    <!-- Fully rounded ends. Any value at least half the pill's height produces a capsule, so this
         is set well above it rather than being kept in step with the pill's exact height. -->
    <dimen name="pill_corner_radius">100dp</dimen>
    <dimen name="pill_padding_horizontal">12dp</dimen>
    <dimen name="pill_padding_vertical">6dp</dimen>
    <dimen name="pill_spacing">8dp</dimen>

    <!-- ================================ Pet imagery ================================ -->
    <!-- Height of the photo header on the pet detail screen. Tall enough to be the first thing the
         eye lands on, short enough that the name and stats below it stay above the fold. -->
    <dimen name="pet_photo_height">220dp</dimen>
    <!-- Height of the photo panel on the add/edit pet form, where the photo is an input rather than
         the subject of the screen. -->
    <dimen name="pet_photo_form_height">180dp</dimen>
    <!-- The round thumbnail on a dashboard or Pets-tab card. Its corners are not listed here: the
         circle comes from a shape appearance using a 50% corner size, which works at any size — see
         ShapeAppearance.PetCare.Circle in styles.xml. -->
    <dimen name="pet_thumb_size">64dp</dimen>

    <!-- Size of a category icon beside a heading or a list row. -->
    <dimen name="category_icon_size">20dp</dimen>
    <!-- The tinted circle a category icon sits inside on a dashboard task row. -->
    <dimen name="category_badge_size">36dp</dimen>
    <!-- Size of the illustration at the top of an empty state. Large enough to read as an
         illustration rather than as a stray icon. -->
    <dimen name="empty_state_icon_size">72dp</dimen>

    <!-- Gap between the edge of a list row and the icon revealed behind it while swiping. -->
    <dimen name="checklist_swipe_icon_margin">24dp</dimen>

    <!-- ============================ Spending breakdown ============================
         The bar showing one category's share of a pet's total spending. -->
    <!-- Thicker than the default progress track: this is being read as a bar chart rather than
         glanced at as a loading indicator, so the lengths need to be comparable down a column. -->
    <dimen name="share_bar_thickness">8dp</dimen>
    <!-- Rounded ends, matching Material 3's treatment of progress tracks. -->
    <dimen name="share_bar_corner_radius">4dp</dimen>
    <!-- Reserved width for the percentage beside each bar. Fixing it keeps every bar the same
         length, so "7%" and "100%" do not produce bars that cannot be compared. -->
    <dimen name="share_percent_min_width">40dp</dimen>

</resources>
