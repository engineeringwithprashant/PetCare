    <dimen name="places_map_height">280dp</dimen>
    <!-- How far the pill and the two buttons sit in from the map card's edges. -->
    <dimen name="places_map_overlay_inset">12dp</dimen>
    <!-- How far the map's credit line is lifted on this tab. -->
    <dimen name="places_map_attribution_inset">54dp</dimen>
    <!-- The overlay pill naming the selected place, and the two map buttons under it. -->
    <dimen name="places_map_pill_padding_horizontal">11dp</dimen>
