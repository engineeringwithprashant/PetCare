    <!-- The small status pill at the foot of a stat card. -->
    <dimen name="home_stat_pill_padding_horizontal">8dp</dimen>
    <!-- 5dp rather than 3dp. The pill keeps its capsule shape at any height, so the padding is what decides. -->
