<!-- The app's spacing, shape and elevation scale. -->
<resources>

    <!-- ================================ Spacing scale ================================ -->
    <!-- Hairline gaps: between a label and the value directly beneath it. -->
    <dimen name="spacing_xs">4dp</dimen>
    <!-- Tight gaps: between closely related lines of text, or stacked buttons. -->
    <dimen name="spacing_sm">8dp</dimen>
    <!-- The default gap: between form fields, and between cards in a list. -->
    <dimen name="spacing_md">16dp</dimen>
    <!-- Section gaps: around a screen's edges, and between distinct blocks of content. -->
    <dimen name="spacing_lg">24dp</dimen>
    <!-- Major breaks: above a screen's primary action, or around an empty state. -->
    <dimen name="spacing_xl">32dp</dimen>

    <!-- ============================== Screen structure ============================== -->
    <dimen name="screen_padding">16dp</dimen>
    <!-- The gutter as a negative margin. -->
    <dimen name="screen_padding_negative">-16dp</dimen>

    <!-- Breathing room above the first item on a screen, under the app bar. -->
    <dimen name="content_top_padding">12dp</dimen>

    <!-- The three values below all measure from the same thing: the floating bottom navigation bar's footprint. -->

    <!-- A floating action button's bottom margin. Lifted the bar's full footprint plus a small gap. -->
    <dimen name="fab_margin_bottom">84dp</dimen>

    <!-- Bottom padding on a scrolling list that has a floating action button. -->
    <dimen name="list_padding_bottom_fab">156dp</dimen>

    <!-- Bottom padding for a scrolling list on a screen with no floating action button. -->
    <dimen name="list_padding_bottom">92dp</dimen>

    <!-- ================================ Shape scale ================================ -->

    <!-- Small: pills, chips, tiny inner tiles. -->
    <dimen name="corner_radius_sm">12dp</dimen>
    <!-- Medium: list-row cards — one pet, one expense, one task. -->
    <dimen name="corner_radius_md">16dp</dimen>
    <!-- Large: full-width feature cards and the photo header on the pet detail screen. -->
    <dimen name="corner_radius_lg">20dp</dimen>

    <!-- ============================== Elevation scale ============================== -->

    <!-- Resting elevation for an ordinary card. -->
    <dimen name="card_elevation">2dp</dimen>
    <!-- A card that should read as the most important thing on the screen. -->
    <dimen name="card_elevation_raised">4dp</dimen>

    <!-- ================================= Components ================================= -->
    <!-- Gap between cards in a vertical list. -->
    <dimen name="card_spacing">12dp</dimen>
    <!-- Padding inside a card, between its edge and its content. Matches the screen gutter. -->
    <dimen name="card_padding">16dp</dimen>

    <!-- ============================== Pastel stat pills ============================== -->
    <!-- Fully rounded ends. Any value at least half the pill's height produces a capsule. -->
    <dimen name="pill_corner_radius">100dp</dimen>
    <dimen name="pill_padding_horizontal">12dp</dimen>
    <dimen name="pill_padding_vertical">6dp</dimen>
    <dimen name="pill_spacing">8dp</dimen>

    <!-- ================================ Pet imagery ================================ -->
    <!-- Height of the photo panel on the add/edit pet form, where the photo is an input. -->
    <dimen name="pet_photo_form_height">180dp</dimen>

    <!-- Size of a category icon beside a heading or a list row. -->
    <dimen name="category_icon_size">20dp</dimen>
    <!-- The tinted circle a category icon sits inside on a dashboard task row. -->
    <dimen name="category_badge_size">36dp</dimen>
    <!-- Size of the illustration at the top of an empty state. -->
    <dimen name="empty_state_icon_size">72dp</dimen>

    <!-- Gap between the edge of a list row and the icon revealed behind it while swiping. -->
    <dimen name="checklist_swipe_icon_margin">24dp</dimen>

    <!-- ============================== Shared header and cards ============================== -->

    <!-- The rounded square holding the app's "p" monogram in the dashboard header. -->
    <dimen name="monogram_size">32dp</dimen>
    <dimen name="monogram_corner_radius">10dp</dimen>

    <!-- The circular badge on the right of the header reporting how many pets are in care. -->
    <dimen name="header_control_height">32dp</dimen>
    <dimen name="header_badge_size">32dp</dimen>

    <!-- The progress ring on the "today's care" card. The ring is drawn inside this box. -->
    <!-- The gap between the Today's-care ring and the heading block beside it. -->
    <dimen name="home_today_ring_spacing">16dp</dimen>
    <!-- The card's own padding, and the gap between its two blocks (the ring row and the streak). -->
    <dimen name="home_today_card_padding">18dp</dimen>
    <dimen name="home_today_block_gap">14dp</dimen>
    <!-- The today's-care ring: 74dp across with a 56dp hole, which is a 9dp band. -->
    <dimen name="care_ring_size">74dp</dimen>
    <dimen name="care_ring_thickness">9dp</dimen>
    <!-- Exactly half the thickness. -->
    <!-- Half the band's thickness, the most the component accepts. -->
    <dimen name="care_ring_corner_radius">4.5dp</dimen>

    <!-- The corner radius shared by the pet cards on every tab and the dashboard's large cards. -->
    <dimen name="pet_card_corner_radius">24dp</dimen>

    <!-- ================================= Pets tab ================================= -->

