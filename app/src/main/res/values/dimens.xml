    <dimen name="pet_detail_back_button_touch_size">48dp</dimen>
    <dimen name="pet_detail_back_button_inset">4dp</dimen>
    <!-- The round gender badge beside the species chip, sized to the chip's own height. -->
    <dimen name="pet_detail_gender_badge_size">24dp</dimen>
    <dimen name="pet_detail_gender_icon_padding">4dp</dimen>

    <!-- The CHECKLIST / EXPENSES / EDIT PET row. -->
    <dimen name="pet_detail_action_button_height">46dp</dimen>
    <dimen name="pet_detail_action_gap">8dp</dimen>

    <!-- The "About" card. The label column has a fixed width. -->
    <dimen name="pet_detail_about_label_width">120dp</dimen>
    <dimen name="pet_detail_about_row_padding_vertical">14dp</dimen>

    <!-- The small yellow "+" beside "Care routines". The circle is 36dp. -->
    <dimen name="pet_detail_add_routine_touch_size">48dp</dimen>
    <dimen name="pet_detail_add_routine_inset">6dp</dimen>

    <!-- The "⋮" overflow button on a routine card: a 40dp icon button. -->
    <dimen name="routine_card_overflow_size">40dp</dimen>

    <!-- ================================= Tasks tab ================================= -->

