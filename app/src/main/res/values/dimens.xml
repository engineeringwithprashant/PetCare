    <dimen name="places_map_pill_text_size">9.5sp</dimen>
    <dimen name="places_map_action_padding_horizontal">14dp</dimen>
    <dimen name="places_map_action_padding_vertical">13dp</dimen>
    <dimen name="places_map_action_text_size">10.5sp</dimen>
    <!-- Deeper than the app's usual card lift. These capsules sit on map tiles rather than on a flat surface. -->
    <dimen name="places_map_action_elevation">6dp</dimen>
    <!-- The rounded-square category badge on a saved-place row ("Vet", "Grm"). -->
    <dimen name="places_badge_size">40dp</dimen>
    <dimen name="places_badge_corner_radius">10dp</dimen>
    <!-- The outlined pair of info blocks (hours, phone) in the featured card. -->
    <dimen name="places_info_corner_radius">14dp</dimen>
    <!-- "BOOK A VISIT" and "PINNED" at the foot of the featured card. -->
    <dimen name="places_action_button_height">52dp</dimen>
    <!-- Gap between saved-place rows. -->
    <dimen name="places_row_spacing">10dp</dimen>

