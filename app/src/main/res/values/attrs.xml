<?xml version="1.0" encoding="utf-8"?>
<!-- Custom theme attributes for the pastel stat pills. -->
<resources>

    <!-- The accent as a foreground colour, for text and icons that should read as accented. -->
    <attr name="colorAccentText" format="color" />

    <!-- The "this one is chosen" fill, used on the Tasks tab for the selected day in the week strip. -->
    <attr name="colorSelectedContainer" format="color" />
    <attr name="colorOnSelectedContainer" format="color" />
    <attr name="colorOnSelectedContainerNeutral" format="color" />

    <!-- The unavailable version of that same strong fill, used by the sign-in screens' main button. -->
    <attr name="colorDisabledContainer" format="color" />
    <attr name="colorOnDisabledContainer" format="color" />

    <!-- Mint — the app uses this one for a pet's age. -->
    <attr name="colorPillMint" format="color" />
    <attr name="colorOnPillMint" format="color" />

    <!-- Sky — weight. -->
    <attr name="colorPillSky" format="color" />
    <attr name="colorOnPillSky" format="color" />

    <!-- Lilac — species. -->
    <attr name="colorPillLilac" format="color" />
    <attr name="colorOnPillLilac" format="color" />

    <!-- Peach — outstanding care. -->
    <attr name="colorPillPeach" format="color" />
    <attr name="colorOnPillPeach" format="color" />

    <!-- Pale green — the profile screen's "VERIFIED" pill. -->
    <attr name="colorPillVerified" format="color" />
    <attr name="colorOnPillVerified" format="color" />

    <!-- The log in screen's wrong-password warning cards: the yellow one for attempts 1–3. -->
    <attr name="colorAuthAlertWarning" format="color" />
    <attr name="colorAuthAlertWarningEdge" format="color" />
    <attr name="colorAuthAlertDanger" format="color" />
    <attr name="colorAuthAlertDangerEdge" format="color" />
    <attr name="colorOnAuthAlertDanger" format="color" />

    <!-- ===================== The floating bottom navigation bar ===================== -->

    <!-- The translucent slab the bar is drawn on. -->
    <attr name="colorNavBarSurface" format="color" />

    <!-- The active tab's pill, and the icon and label written on it. -->
    <attr name="colorNavTabActive" format="color" />
    <attr name="colorOnNavTabActive" format="color" />

    <!-- The four inactive tabs' icons — a solid value, never the active ink at reduced opacity. -->
    <attr name="colorNavTabMuted" format="color" />

    <!-- The open-task badge as it appears on the active pill. -->
    <attr name="colorNavBadgeActive" format="color" />
    <attr name="colorOnNavBadgeActive" format="color" />

    <!-- ============================= The map cards ============================= -->
    <attr name="colorMapGround" format="color" />

    <!-- PlaceMapView's one configurable dimension. -->
    <declare-styleable name="PlaceMapView">
        <attr name="attributionBottomInset" format="dimension" />
    </declare-styleable>

    <!-- ====================== The vaccination status pills ====================== -->
    <attr name="colorVaccinationClear" format="color" />
    <attr name="colorOnVaccinationClear" format="color" />
    <attr name="colorVaccinationOverdue" format="color" />
    <attr name="colorOnVaccinationOverdue" format="color" />
    <attr name="colorVaccinationDue" format="color" />
    <attr name="colorOnVaccinationDue" format="color" />

</resources>
