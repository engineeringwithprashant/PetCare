<!--
    All user-facing text lives here rather than being hard-coded in layouts or Kotlin.
    Keeping it centralised means a wording change happens in one place, and the app can be
    translated later by adding a values-<language> folder without touching any other file.
-->
<resources>
    <string name="app_name">PetCare</string>

    <!-- ============================ Registration screen ============================ -->
    <string name="register_title">Create your account</string>
    <string name="register_subtitle">Set up a profile to start tracking your pets\' care.</string>
    <string name="register_full_name_label">Full name</string>
    <string name="register_email_label">Email address</string>
    <string name="register_password_label">Password</string>
    <string name="register_confirm_password_label">Confirm password</string>
    <!-- %1$d is replaced at runtime with AuthViewModel.MIN_PASSWORD_LENGTH, so the rule stated
         to the user can never drift out of step with the rule the code enforces. -->
    <string name="register_password_helper">At least %1$d characters</string>
    <string name="register_submit">Create account</string>
    <string name="register_have_account">Already have an account? Sign in</string>

    <!-- =============================== Login screen =============================== -->
    <string name="login_title">Welcome back</string>
    <string name="login_subtitle">Sign in to continue caring for your pets.</string>
    <string name="login_email_label">Email address</string>
    <string name="login_password_label">Password</string>
    <string name="login_submit">Sign in</string>
    <string name="login_no_account">New here? Create an account</string>

    <!-- ================================ Home screen ================================ -->
    <string name="home_title">Your pets</string>
    <!-- %1$s is replaced with the signed-in user's name, read back out of the database. -->
    <string name="home_welcome">Welcome, %1$s</string>

    <!-- Shown in place of the list when the user has not added any pets yet. -->
    <string name="home_empty_title">No pets yet</string>
    <string name="home_empty_message">Add your first pet to start tracking their care.</string>

    <!-- Today's care summary. -->
    <string name="home_tasks_none">No care tasks due today</string>
    <!--
        A plurals resource, not a plain string: the wording has to change with the count, and
        which forms exist differs by language. Android picks the right entry from the quantity
        passed to getQuantityString, so the code never has to test for "is it 1?" itself.
        %1$d is the completed count and %2$d the total.
    -->
    <plurals name="home_tasks_summary">
        <item quantity="one">%1$d of %2$d task done today</item>
        <item quantity="other">%1$d of %2$d tasks done today</item>
    </plurals>

    <!-- ============================== Pet list item ============================== -->
    <!-- Joins species and breed into one subtitle, e.g. "Dog · Labrador". -->
    <string name="pet_species_and_breed">%1$s · %2$s</string>

    <!-- Display names for the PetSpecies enum. The enum constants themselves (DOG, CAT) are
         database values and must never be shown to the user. -->
    <string name="species_dog">Dog</string>
    <string name="species_cat">Cat</string>
    <string name="species_bird">Bird</string>
    <string name="species_rabbit">Rabbit</string>
    <string name="species_fish">Fish</string>
    <string name="species_reptile">Reptile</string>
    <string name="species_other">Other</string>

    <!-- ============================ Add / edit pet screen ============================ -->
    <!-- The same screen serves both modes, so it has two possible titles. -->
    <string name="add_pet_title">Add a pet</string>
    <string name="edit_pet_title">Edit pet</string>

    <string name="pet_name_label">Name</string>
    <string name="pet_species_label">Species</string>
    <string name="pet_breed_label">Breed</string>
    <string name="pet_dob_label">Date of birth</string>
    <string name="pet_weight_label">Weight (kg)</string>
    <string name="pet_dietary_label">Dietary notes</string>
    <string name="pet_allergies_label">Allergies</string>
    <string name="pet_toys_label">Favourite toys</string>

    <string name="pet_photo_choose">Choose photo</string>
    <string name="pet_photo_change">Change photo</string>
    <string name="pet_dob_picker_title">Select date of birth</string>
    <string name="pet_save">Save</string>
    <string name="pet_delete">Delete pet</string>

    <!-- Confirmation before a destructive action. The message spells out the knock-on effect,
         because deleting a pet also removes its care history through the database's cascade
         rules and that is not obvious from the button alone. %1$s is the pet's name. -->
    <string name="delete_pet_dialog_title">Delete pet?</string>
    <string name="delete_pet_dialog_message">%1$s will be permanently deleted, along with all of their care tasks, routines and expenses. This cannot be undone.</string>
    <string name="delete_pet_dialog_confirm">Delete</string>
    <string name="delete_pet_dialog_cancel">Cancel</string>

    <!-- ============================= Validation errors =============================
         Referenced by AuthViewModel as string resource ids, then resolved to text by the
         fragments. -->
    <string name="error_name_required">Please enter your name</string>
    <string name="error_email_required">Please enter your email address</string>
    <string name="error_email_invalid">Enter a valid email address</string>
    <string name="error_email_taken">An account already uses this email address</string>
    <string name="error_password_required">Please enter your password</string>
    <string name="error_password_too_short">Password must be at least 8 characters</string>
    <string name="error_confirm_password_required">Please confirm your password</string>
    <string name="error_password_mismatch">Passwords do not match</string>
    <!-- Deliberately vague: it does not reveal whether the email exists. A message such as
         "no account with that email" would let someone test addresses one at a time to discover
         who has an account. -->
    <string name="error_invalid_credentials">Incorrect email or password</string>

    <!-- Add / edit pet errors. -->
    <string name="error_pet_name_required">Please enter a name</string>
    <string name="error_pet_weight_invalid">Enter a weight greater than 0</string>
    <string name="error_pet_not_found">That pet could not be found</string>
    <string name="error_photo_save_failed">That photo could not be saved</string>

    <!-- Routine and task errors. -->
    <string name="error_routine_name_required">Please enter a routine name</string>
    <string name="error_routine_not_found">That routine could not be found</string>
    <string name="error_task_title_required">Please enter a task title</string>
    <string name="error_task_time_required">Please choose a time of day</string>

    <!-- ============================== Care categories ==============================
         Display names for the TaskCategory enum. The constants themselves (VET_VISIT) are
         database values and must never be shown to the user. -->
    <string name="category_feeding">Feeding</string>
    <string name="category_walk">Walk</string>
    <string name="category_grooming">Grooming</string>
    <string name="category_medication">Medication</string>
    <string name="category_vet_visit">Vet visit</string>
    <string name="category_training">Training</string>
    <string name="category_play">Play</string>
    <string name="category_other">Other</string>

    <!-- ============================= Routine schedules =============================
         Display names for the RepeatUnit enum, worded as the user would say them. -->
    <string name="schedule_daily">Every day</string>
    <string name="schedule_weekly">Every week</string>
    <string name="schedule_monthly">Every month</string>
    <string name="schedule_yearly">Every year</string>

    <!-- ============================= Pet detail screen ============================= -->
    <string name="pet_detail_edit">Edit pet</string>
    <string name="pet_detail_checklist">Today\'s checklist</string>
    <string name="pet_detail_routines_title">Care routines</string>
    <string name="pet_detail_no_routines_title">No care routines yet</string>
    <string name="pet_detail_no_routines_message">Create a routine to schedule this pet\'s regular care.</string>
    <string name="pet_detail_dob_label">Date of birth</string>
    <string name="pet_detail_weight_label">Weight</string>
    <string name="pet_detail_dietary_label">Dietary notes</string>
    <string name="pet_detail_allergies_label">Allergies</string>
    <string name="pet_detail_toys_label">Favourite toys</string>
    <!-- %1$s is the weight value; the unit is kept out of the number so it can be translated. -->
    <string name="pet_detail_weight_format">%1$s kg</string>
    <!-- Marks a routine the user has switched off. %1$s is its schedule, e.g. "Every day". -->
    <string name="routine_paused_format">%1$s · Paused</string>

    <!-- ============================ Create routine screen ============================ -->
    <string name="add_routine_title">New care routine</string>
    <string name="routine_name_label">Routine name</string>
    <string name="routine_schedule_label">How often does it repeat?</string>
    <string name="routine_toggle_daily">Daily</string>
    <string name="routine_toggle_weekly">Weekly</string>
    <string name="routine_save">Create routine</string>

    <!-- ============================ Routine detail screen ============================ -->
    <string name="routine_detail_tasks_title">Tasks in this routine</string>
    <string name="routine_detail_no_tasks_title">No tasks yet</string>
    <string name="routine_detail_no_tasks_message">Add the care tasks that make up this routine.</string>

    <!-- ============================== Add task screen ============================== -->
    <string name="add_task_title">New care task</string>
    <string name="task_title_label">Task title</string>
    <string name="task_category_label">Category</string>
    <string name="task_time_label">Time of day</string>
    <string name="task_supplies_label">Required supplies</string>
    <string name="task_notes_label">Notes</string>
    <string name="task_save">Add task</string>
    <string name="task_time_picker_title">Select time of day</string>
    <!-- Prefixes the supplies line in task lists. %1$s is what the user recorded. -->
    <string name="task_supplies_format">Needs: %1$s</string>

    <!-- =============================== Checklist screen =============================== -->
    <!-- %1$s is the pet's name. -->
    <string name="checklist_title_format">Today for %1$s</string>
    <string name="checklist_empty_title">Nothing due today</string>
    <string name="checklist_empty_message">This pet has no care scheduled for today.</string>
    <!-- Plural because the wording changes with the count, and which forms exist varies by
         language. %1$d is the completed count and %2$d the total. -->
    <plurals name="checklist_progress">
        <item quantity="one">%1$d of %2$d task done</item>
        <item quantity="other">%1$d of %2$d tasks done</item>
    </plurals>

    <!-- ============================== Care delegation ==============================
         Texting a pet's checklist to someone who is looking after them. -->
    <string name="checklist_delegate">Delegate</string>
    <string name="delegate_nothing_to_send">There is no care due today to delegate</string>
    <string name="delegate_no_sms_support">This device cannot send text messages</string>
    <!-- %1$s is the chosen contact's name. -->
    <string name="delegate_preview_title">Send to %1$s?</string>
    <string name="delegate_send">Send</string>
    <string name="delegate_cancel">Cancel</string>
    <string name="delegate_sent">Checklist sent to %1$s</string>
    <string name="delegate_failed">The message could not be sent</string>
    <string name="delegate_contact_unreadable">That contact could not be read</string>
    <!-- %1$s is the contact's name. -->
    <string name="delegate_contact_no_number">%1$s has no phone number saved</string>
    <!-- Warns what the message will cost to send. Plural because the wording changes with the
         count, and SMS is normally billed per part. %1$d is the number of parts. -->
    <plurals name="delegate_part_count">
        <item quantity="one">This will send as %1$d text message.</item>
        <item quantity="other">This will send as %1$d text messages.</item>
    </plurals>

    <!-- The SMS body itself. Built up piece by piece by DelegationMessage.kt. The message has to
         make sense on its own in someone else's inbox, with no access to this app. -->
    <!-- %1$s is the pet's name, %2$s today's date. -->
    <string name="delegate_message_header">Care checklist for %1$s (%2$s)</string>
    <!-- %1$s is the task title, %2$s its time of day. -->
    <string name="delegate_message_task">- %1$s at %2$s</string>
    <string name="delegate_message_task_no_time">- %1$s</string>
    <string name="delegate_message_supplies">  Needs: %1$s</string>
    <string name="delegate_message_notes">  Note: %1$s</string>
    <!-- Appended to a task already ticked off, so the carer does not repeat a feed or a dose. -->
    <string name="delegate_message_done_marker"> [already done]</string>

    <!-- ============================ Permission rationale ============================
         Shown before each runtime permission request. The wording states what is accessed, why it
         is needed, and what the app will not do with it — a request with no explanation is far
         more likely to be refused, and rightly so. -->
    <string name="permission_contacts_title">Choose a contact?</string>
    <string name="permission_contacts_message">PetCare needs access to your contacts so you can pick who to send this checklist to. Only the contact you choose is read, and your contacts are never uploaded or shared.</string>
    <string name="permission_sms_title">Send a text message?</string>
    <string name="permission_sms_message">PetCare needs permission to send text messages so it can deliver the checklist. You will always see the exact message and confirm it before anything is sent. Standard message rates apply.</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_not_now">Not now</string>
    <string name="permission_contacts_denied">Without contacts access, PetCare cannot look up who to send the checklist to.</string>
    <string name="permission_sms_denied">Without SMS permission, PetCare cannot send the checklist.</string>
    <!-- Offered when a permission has been permanently refused, since asking again will no longer
         show a prompt and the only way back is the system settings screen. -->
    <string name="permission_open_settings">Settings</string>

    <!-- =========================== Accessibility labels ===========================
         contentDescription values, read aloud by TalkBack for users who cannot see the icon. -->
    <string name="cd_add_pet">Add a pet</string>
    <string name="cd_pet_photo">Pet photo</string>
    <string name="cd_add_routine">Add a care routine</string>
    <string name="cd_add_task">Add a care task</string>
    <string name="cd_task_done">Mark task as done</string>
</resources>
