    <string name="pet_detail_weight_format">%1$s kg</string>
    <!-- Marks a routine the user has switched off. %1$s is its schedule, e.g. "Every day". -->
    <string name="routine_paused_format">%1$s · Paused</string>

    <!-- ============================ Create routine screen ============================ -->
    <string name="add_routine_title">New care routine</string>
    <string name="routine_name_label">Routine name</string>
    <string name="routine_schedule_label">How often does it repeat?</string>
