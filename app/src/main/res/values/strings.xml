    <!-- ============================ Routine detail screen ============================ -->
    <string name="routine_detail_tasks_title">Tasks in this routine</string>
    <!-- Label on the pause/resume switch. Worded as the state it controls rather than as an
         action, which is the convention for a switch: "Active" is on, off means paused. -->
    <string name="routine_active_label">Active</string>
    <string name="routine_delete">Delete routine</string>
    <!-- Confirmation before a destructive action. The message states the knock-on effect, because
         deleting a routine also removes the tasks inside it and that is not obvious from the
         button. %1$s is the routine's name. -->
    <string name="delete_routine_dialog_title">Delete routine?</string>
    <string name="delete_routine_dialog_message">%1$s will be permanently deleted, along with every care task in it. This cannot be undone. To stop it temporarily instead, switch it to inactive.</string>
    <string name="delete_routine_dialog_confirm">Delete</string>
    <string name="delete_routine_dialog_cancel">Cancel</string>
    <string name="routine_detail_no_tasks_title">No tasks yet</string>
    <string name="routine_detail_no_tasks_message">Add the care tasks that make up this routine.</string>

    <!-- ============================== Add task screen ============================== -->
    <!-- The same screen serves both modes, so it has two possible titles. -->
    <string name="add_task_title">New care task</string>
    <string name="edit_task_title">Edit care task</string>
    <string name="task_delete">Delete task</string>
    <!-- Confirmation before a destructive action. %1$s is the task's title. -->
    <string name="delete_task_dialog_title">Delete task?</string>
    <string name="delete_task_dialog_message">%1$s will be permanently removed from this routine. This cannot be undone.</string>
    <string name="delete_task_dialog_confirm">Delete</string>
    <string name="delete_task_dialog_cancel">Cancel</string>
    <string name="task_title_label">Task title</string>
    <string name="task_category_label">Category</string>
    <string name="task_time_label">Time of day</string>
    <string name="task_supplies_label">Required supplies</string>
    <string name="task_notes_label">Notes</string>
    <string name="task_save">Add task</string>
    <string name="task_time_picker_title">Select time of day</string>
    <!-- Prefixes the supplies line in task lists. %1$s is what the user recorded. -->
    <string name="task_supplies_format">Needs: %1$s</string>

    <!-- =============================== Checklist screen =============================== -->
    <!-- %1$s is the pet's name. -->
    <string name="checklist_title_format">Today for %1$s</string>
    <!-- ============================== Checklist gestures ==============================
         Swipe a row to complete or delete it; shake the phone to start the day over. -->
    <!-- %1$s is the deleted task's title. -->
    <string name="swipe_task_deleted">%1$s deleted</string>
    <string name="action_undo">Undo</string>
    <string name="reset_dialog_title">Start today over?</string>
    <!-- Spells out both what is cleared and what is not, since a shake is easy to trigger by
         accident and the wording is the only chance to reassure. %1$s is the pet's name. -->
    <string name="reset_dialog_message">This clears every task ticked off today for %1$s, so the checklist starts over. The tasks themselves are not deleted.</string>
    <string name="reset_dialog_confirm">Start over</string>
    <string name="reset_dialog_cancel">Cancel</string>
    <string name="reset_done">Today\'s checklist has been reset</string>

    <string name="checklist_empty_title">Nothing due today</string>
    <string name="checklist_empty_message">This pet has no care scheduled for today.</string>
    <!-- Plural because the wording changes with the count, and which forms exist varies by
         language. %1$d is the completed count and %2$d the total. -->
    <plurals name="checklist_progress">
        <item quantity="one">%1$d of %2$d task done</item>
        <item quantity="other">%1$d of %2$d tasks done</item>
    </plurals>

    <!-- ============================== Care delegation ==============================
         Handing a pet's checklist to someone who is looking after them, either as a text message
         sent by the app itself or as an email drafted in the user's own mail app. -->
    <string name="checklist_delegate">Delegate</string>
    <string name="delegate_nothing_to_send">There is no care due today to delegate</string>

    <!-- The channel chooser, shown first so the user picks how the checklist travels before the app
         asks for anything. The two options are worded as the things themselves rather than as
         "Send by…", since the dialog's title already asks the question. -->
    <string name="delegate_channel_title">How should this be sent?</string>
    <string name="delegate_channel_sms">Text message</string>
    <string name="delegate_channel_email">Email</string>
    <!-- Shown on the checklist when every task due today has been ticked off, explaining why the
         delegate action is unavailable rather than leaving it greyed out with no reason given. -->
    <string name="checklist_all_done">Everything is done for today — there is nothing left to delegate.</string>
    <!-- Headline of the confirmation preview, summarising what is about to be sent. Plural because
         the wording changes with the count. %1$d is the number of outstanding tasks, %2$s the
         pet's name. -->
    <plurals name="delegate_outstanding_summary">
        <item quantity="one">%1$d remaining task for %2$s</item>
        <item quantity="other">%1$d remaining tasks for %2$s</item>
    </plurals>
    <string name="delegate_no_sms_support">This device cannot send text messages</string>
    <!-- %1$s is the chosen contact's name. -->
    <string name="delegate_preview_title">Send to %1$s?</string>
    <string name="delegate_send">Send</string>
    <string name="delegate_cancel">Cancel</string>
    <string name="delegate_sent">Checklist sent to %1$s</string>
    <string name="delegate_failed">The message could not be sent</string>
    <string name="delegate_contact_unreadable">That contact could not be read</string>
    <!-- %1$s is the contact's name. -->
    <string name="delegate_contact_no_number">%1$s has no phone number saved</string>
    <!-- Warns what the message will cost to send. Plural because the wording changes with the
         count, and SMS is normally billed per part. %1$d is the number of parts. -->
    <plurals name="delegate_part_count">
        <item quantity="one">This will send as %1$d text message.</item>
        <item quantity="other">This will send as %1$d text messages.</item>
    </plurals>

    <!-- Email delegation. Nothing is sent by the app here — the checklist is handed to whichever
         mail app the user picks, and they address it and send it themselves. -->
    <string name="delegate_email_chooser_title">Send checklist with</string>
    <!-- The email's subject line. %1$s is the pet's name, which is what makes the message findable
         in an inbox holding checklists for more than one animal. Worded to match the opening line
         of the body. -->
    <string name="delegate_email_subject">Remaining care for %1$s</string>
    <string name="delegate_no_email_app">No email app is set up on this device</string>

    <!-- The message body itself, shared by both channels. Built up piece by piece by
         DelegationMessage.kt. The message has to make sense on its own in someone else's inbox,
         with no access to this app. -->
    <!-- %1$s is the pet's name, %2$s today's date. Worded as "remaining" because only outstanding
         tasks are sent — anything already done is left out. -->
    <string name="delegate_message_header">Remaining care for %1$s (%2$s)</string>
    <!-- %1$s is the task title, %2$s its time of day. -->
    <string name="delegate_message_task">- %1$s at %2$s</string>
    <string name="delegate_message_task_no_time">- %1$s</string>
    <string name="delegate_message_supplies">  Needs: %1$s</string>
    <string name="delegate_message_notes">  Note: %1$s</string>

    <!-- ============================ Permission rationale ============================
         Shown before each runtime permission request. The wording states what is accessed, why it
         is needed, and what the app will not do with it — a request with no explanation is far
         more likely to be refused, and rightly so. -->
    <string name="permission_contacts_title">Choose a contact?</string>
    <string name="permission_contacts_message">PetCare needs access to your contacts so you can pick who to send this checklist to. Only the contact you choose is read, and your contacts are never uploaded or shared.</string>
    <string name="permission_sms_title">Send a text message?</string>
    <string name="permission_sms_message">PetCare needs permission to send text messages so it can deliver the checklist. You will always see the exact message and confirm it before anything is sent. Standard message rates apply.</string>
    <string name="permission_continue">Continue</string>
    <string name="permission_not_now">Not now</string>
    <string name="permission_contacts_denied">Without contacts access, PetCare cannot look up who to send the checklist to.</string>
    <string name="permission_sms_denied">Without SMS permission, PetCare cannot send the checklist.</string>
    <!-- Offered when a permission has been permanently refused, since asking again will no longer
         show a prompt and the only way back is the system settings screen. -->
    <string name="permission_open_settings">Settings</string>

