<!--
    All user-facing text lives here rather than being hard-coded in layouts or Kotlin.
    Keeping it centralised means a wording change happens in one place, and the app can be
    translated later by adding a values-<language> folder without touching any other file.
-->
<resources>
    <string name="app_name">PetCare</string>

    <!-- ============================ Registration screen ============================ -->
    <string name="register_title">Create your account</string>
    <string name="register_subtitle">Set up a profile to start tracking your pets\' care.</string>
    <string name="register_full_name_label">Full name</string>
    <string name="register_email_label">Email address</string>
    <string name="register_password_label">Password</string>
    <string name="register_confirm_password_label">Confirm password</string>
    <!-- %1$d is replaced at runtime with AuthViewModel.MIN_PASSWORD_LENGTH, so the rule stated
         to the user can never drift out of step with the rule the code enforces. -->
    <string name="register_password_helper">At least %1$d characters</string>
    <string name="register_submit">Create account</string>
    <string name="register_have_account">Already have an account? Sign in</string>

    <!-- =============================== Login screen =============================== -->
    <string name="login_title">Welcome back</string>
    <string name="login_subtitle">Sign in to continue caring for your pets.</string>
    <string name="login_email_label">Email address</string>
    <string name="login_password_label">Password</string>
    <string name="login_submit">Sign in</string>
    <string name="login_no_account">New here? Create an account</string>

    <!-- ================================ Home screen ================================ -->
    <string name="home_title">Your pets</string>
    <!-- %1$s is replaced with the signed-in user's name, read back out of the database. -->
    <string name="home_welcome">Welcome, %1$s</string>

    <!-- Shown in place of the list when the user has not added any pets yet. -->
    <string name="home_empty_title">No pets yet</string>
    <string name="home_empty_message">Add your first pet to start tracking their care.</string>

    <!-- Today's care summary. -->
    <string name="home_tasks_none">No care tasks due today</string>
    <!--
        A plurals resource, not a plain string: the wording has to change with the count, and
        which forms exist differs by language. Android picks the right entry from the quantity
        passed to getQuantityString, so the code never has to test for "is it 1?" itself.
        %1$d is the completed count and %2$d the total.
    -->
    <plurals name="home_tasks_summary">
        <item quantity="one">%1$d of %2$d task done today</item>
        <item quantity="other">%1$d of %2$d tasks done today</item>
    </plurals>

    <!-- ============================== Pet list item ============================== -->
    <!-- Joins species and breed into one subtitle, e.g. "Dog · Labrador". -->
    <string name="pet_species_and_breed">%1$s · %2$s</string>

    <!-- Display names for the PetSpecies enum. The enum constants themselves (DOG, CAT) are
         database values and must never be shown to the user. -->
    <string name="species_dog">Dog</string>
    <string name="species_cat">Cat</string>
    <string name="species_bird">Bird</string>
    <string name="species_rabbit">Rabbit</string>
    <string name="species_fish">Fish</string>
    <string name="species_reptile">Reptile</string>
    <string name="species_other">Other</string>

    <!-- ============================ Add / edit pet screen ============================ -->
    <!-- The same screen serves both modes, so it has two possible titles. -->
    <string name="add_pet_title">Add a pet</string>
    <string name="edit_pet_title">Edit pet</string>

    <string name="pet_name_label">Name</string>
    <string name="pet_species_label">Species</string>
    <string name="pet_breed_label">Breed</string>
    <string name="pet_dob_label">Date of birth</string>
    <string name="pet_weight_label">Weight (kg)</string>
    <string name="pet_dietary_label">Dietary notes</string>
    <string name="pet_allergies_label">Allergies</string>
    <string name="pet_toys_label">Favourite toys</string>

    <string name="pet_photo_choose">Choose photo</string>
    <string name="pet_photo_change">Change photo</string>
    <string name="pet_dob_picker_title">Select date of birth</string>
    <string name="pet_save">Save</string>
    <string name="pet_delete">Delete pet</string>

    <!-- Confirmation before a destructive action. The message spells out the knock-on effect,
         because deleting a pet also removes its care history through the database's cascade
         rules and that is not obvious from the button alone. %1$s is the pet's name. -->
    <string name="delete_pet_dialog_title">Delete pet?</string>
    <string name="delete_pet_dialog_message">%1$s will be permanently deleted, along with all of their care tasks, routines and expenses. This cannot be undone.</string>
    <string name="delete_pet_dialog_confirm">Delete</string>
    <string name="delete_pet_dialog_cancel">Cancel</string>

    <!-- ============================= Validation errors =============================
         Referenced by AuthViewModel as string resource ids, then resolved to text by the
         fragments. -->
    <string name="error_name_required">Please enter your name</string>
    <string name="error_email_required">Please enter your email address</string>
    <string name="error_email_invalid">Enter a valid email address</string>
    <string name="error_email_taken">An account already uses this email address</string>
    <string name="error_password_required">Please enter your password</string>
    <string name="error_password_too_short">Password must be at least 8 characters</string>
    <string name="error_confirm_password_required">Please confirm your password</string>
    <string name="error_password_mismatch">Passwords do not match</string>
    <!-- Deliberately vague: it does not reveal whether the email exists. A message such as
         "no account with that email" would let someone test addresses one at a time to discover
         who has an account. -->
    <string name="error_invalid_credentials">Incorrect email or password</string>

    <!-- Add / edit pet errors. -->
    <string name="error_pet_name_required">Please enter a name</string>
    <string name="error_pet_weight_invalid">Enter a weight greater than 0</string>
    <string name="error_pet_not_found">That pet could not be found</string>
    <string name="error_photo_save_failed">That photo could not be saved</string>

    <!-- =========================== Accessibility labels ===========================
         contentDescription values, read aloud by TalkBack for users who cannot see the icon. -->
    <string name="cd_add_pet">Add a pet</string>
    <string name="cd_pet_photo">Pet photo</string>
</resources>
