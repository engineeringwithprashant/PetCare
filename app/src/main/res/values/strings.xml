    <string name="error_routine_name_required">Please enter a routine name</string>
    <string name="error_routine_not_found">That routine could not be found</string>
    <string name="error_task_title_required">Please enter a task title</string>
    <string name="error_task_time_required">Please choose a time of day</string>
    <string name="error_task_not_found">That task could not be found</string>

