    <string name="category_walk">Walk</string>
    <string name="category_grooming">Grooming</string>
    <string name="category_medication">Medication</string>
    <string name="category_vet_visit">Vet visit</string>
    <string name="category_training">Training</string>
    <string name="category_play">Play</string>
    <string name="category_other">Other</string>

    <!-- ============================= Routine schedules =============================
